# Optional. Leave blank for the local frontend preview.
# Production storefront: https://byponyo.com. Its public API origin is https://api.byponyo.com (no secrets here).
NEXT_PUBLIC_PONYO_API_BASE_URL=

# Optional private server-side API base (never prefixed with NEXT_PUBLIC_).
# Required for SSR when the public API base is a relative proxy path.
# PONYO_API_SERVER_BASE_URL=http://127.0.0.1:8000
# Development single-origin tunnel only (not a production proxy):
# NEXT_PUBLIC_PONYO_API_BASE_URL=/ponyo-api
# PONYO_DEV_API_PROXY=true
# PONYO_DEV_TUNNEL_ORIGIN=https://your-temporary-tunnel.example
