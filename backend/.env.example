# Local API defaults (copy to backend/.env.local; never commit secrets)
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3003
DATABASE_URL=postgresql+asyncpg://ponyo:ponyo@localhost:5433/ponyo
REDIS_URL=redis://localhost:6379/0

# Auth/session
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ISSUER=ponyo-api
SESSION_COOKIE_NAME=ponyo_session
CSRF_COOKIE_NAME=ponyo_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Stripe test mode; keep secret keys only in AWS Secrets Manager in deployed environments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/orders?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/checkout?checkout=cancelled

# AWS resources: grant task-role permissions; do not put long-lived AWS keys here
AWS_REGION=ap-northeast-1
S3_BUCKET=
SQS_ORDER_EVENTS_URL=
EVENTBRIDGE_BUS_NAME=
