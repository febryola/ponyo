# Copy to .env.local for development. Do not commit .env.local or put secrets in NEXT_PUBLIC_*.
ENVIRONMENT=local
API_HOST=0.0.0.0
API_PORT=8000
STOREFRONT_BASE_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3003
DATABASE_URL=postgresql+asyncpg://ponyo:ponyo@localhost:5433/ponyo
REDIS_URL=redis://localhost:6379/0

# Generate a distinct value locally; production values belong in AWS Secrets Manager.
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_ISSUER=ponyo-api
SESSION_COOKIE_NAME=ponyo_session
CSRF_COOKIE_NAME=ponyo_csrf
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Stripe test mode only; configure real credentials through a secure secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAPTURE_METHOD=automatic
STRIPE_SUCCESS_URL=http://localhost:3000/orders?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/checkout?checkout=cancelled
CHECKOUT_STANDARD_SHIPPING_JPY=0
CHECKOUT_EXPRESS_SHIPPING_JPY=1200
# Merchant-reviewed exclusive tax rates in basis points; {} means no tax collected.
CHECKOUT_TAX_RATES_BPS={}
CHECKOUT_TAX_SHIPPING=false

# AWS resources should use ECS task-role credentials, never long-lived keys here.
AWS_REGION=ap-northeast-1
TRANSLATION_PROVIDER=aws_translate
TRANSLATION_TIMEOUT_SECONDS=8
S3_BUCKET=
SQS_ORDER_EVENTS_URL=
EVENTBRIDGE_BUS_NAME=
SUPPLIER_FORWARDING_ENABLED=false
# Trusted HTTPS integration map by supplier code; store real tokens only in a secret manager.
SUPPLIER_INTEGRATIONS={}
SUPPLIER_MAX_ATTEMPTS=5
SUPPLIER_RETRY_BASE_SECONDS=60
SUPPLIER_CONFIRMATION_TIMEOUT_SECONDS=86400

# SMTP delivers account password-reset links and optional request notifications. Keep credentials private.
CONTACT_NOTIFICATION_EMAIL=febryola0402@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=8
