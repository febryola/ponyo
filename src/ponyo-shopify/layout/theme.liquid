<!doctype html>
{%- comment -%} dir comes from the platform (request.locale.direction); never derive it from a theme-local RTL language list. {%- endcomment -%}
<html lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
  <head>
    {%- comment -%} The import map must precede the first module script, so it stays first in the head. {%- endcomment -%}
    {% render 'import-map' %}
    {% render 'meta-tags' %}
    {{ 'styles.min.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'theme-styles' %}

    {% render 'lcp-preload' %}

    {%- comment -%}
      Standard Actions configuration must register before content_for_header so
      platform cart mutations use the theme handler instead of the full-page fallback.
    {%- endcomment -%}
    {% render 'standard-actions-config' %}

    {{ content_for_header }}
  </head>

  <body class="flex flex-col min-h-svh bg-surface text-on-surface font-body antialiased max-md:pb-[calc(64px+env(safe-area-inset-bottom))]">
    {% render 'skip-link' %}
    {%- comment -%} Utility bar like the reference: help link, announcement, delivery info. {%- endcomment -%}
    {% block 'container', tag: 'div', class: 'bg-[#f3ece7] px-4 py-1.5 text-[#2b211e]', attributes: 'role="region" aria-label="Announcement"' %}
      <div class="mx-auto flex w-full max-w-page items-center justify-center gap-4 md:justify-between">
        {% block 'link', url: '/pages/contact', class: 'hidden min-h-0! text-[12.5px]! italic text-[#4a3530]! no-underline! hover:underline! md:inline-flex' %}{{ 'home.header.help' | t }}{% endblock %}
        {% style %}@keyframes ponyo-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }{% endstyle %}
        {% block 'text', variant: 'sm', class: 'inline-flex items-center justify-center gap-2 text-center text-[13px]! font-semibold' %}<svg viewBox="0 0 64 64" class="size-[18px] shrink-0 motion-safe:animate-[ponyo-float_3s_ease-in-out_infinite]" aria-hidden="true"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="var(--color-accent)"/><circle cx="26" cy="23" r="2.6" fill="#3f302b"/><circle cx="38" cy="23" r="2.6" fill="#3f302b"/><path d="M22 29c1.4 1.6 3 1.6 4.4 0" stroke="#3f302b" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.85"/></svg><span>{{ 'home.announcement' | t }}</span><svg viewBox="0 0 64 64" class="hidden min-[380px]:inline size-[18px] shrink-0 motion-safe:animate-[ponyo-float_3s_.6s_ease-in-out_infinite]" aria-hidden="true"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="var(--color-accent)"/><circle cx="26" cy="23" r="2.6" fill="#3f302b"/><circle cx="38" cy="23" r="2.6" fill="#3f302b"/><path d="M22 29c1.4 1.6 3 1.6 4.4 0" stroke="#3f302b" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.85"/></svg>{% endblock %}
        {% block 'link', url: '/pages/faq', class: 'hidden min-h-0! text-[12.5px]! italic text-[#4a3530]! no-underline! hover:underline! md:inline-flex' %}{{ 'home.header.delivery' | t }}{% endblock %}
      </div>
    {% endblock %}
    {% block 'header', attributes: 'id="site-header"', class: 'relative z-40 bg-[#2e211d] shadow-[0_2px_14px_rgba(0,0,0,.18)]' %}
      <div
        class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 min-h-16 md:min-h-[72px] px-margin py-2.5 max-w-page mx-auto w-full md:flex-nowrap md:gap-x-6"
        data-header-nav-group
      >
        <div class="flex shrink-0 items-center gap-2">
          <div class="hidden max-md:block ms-[min(0px,calc(var(--safe-area-inset-inline)-0.5rem))]">
            {%- capture menu_button_attrs -%}aria-label="{{ 'header.menu' | t | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'mobile-nav-drawer',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'size-touch-target rounded text-white hover:bg-transparent hover:opacity-70',
              attributes: menu_button_attrs -%}
              <span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">
                {{- 'icon-menu.svg' | inline_asset_content -}}
              </span>
            {%- endblock %}
          </div>

          <a href="{{ routes.root_url }}" class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-border bg-white md:size-10" aria-hidden="true" tabindex="-1">
            <svg viewBox="0 0 64 64" class="size-7"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="var(--color-accent)"/><circle cx="26" cy="23" r="2.6" fill="#3f302b"/><circle cx="38" cy="23" r="2.6" fill="#3f302b"/><path d="M22 29c1.4 1.6 3 1.6 4.4 0" stroke="#3f302b" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.85"/></svg>
          </a>
          {% block 'logo', class: 'font-heading text-xl font-extrabold uppercase tracking-[0.12em] text-white md:text-2xl md:tracking-[0.14em]' %}{% endblock %}
        </div>

        {%- capture mobile_nav_close_button -%}
          {%- capture nav_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'mobile-nav-drawer', command: 'close', variant: 'button-ghost', class: 'ms-auto size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: nav_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        {%- endcapture -%}
        {%- capture mobile_nav_localization_submit -%}
          {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
        {%- endcapture -%}
        {%- capture search_button_attrs -%}aria-label="{{ 'general.search' | t | escape }}"{%- endcapture -%}
        {% block 'button',
          commandfor: 'predictive-search',
          command: 'show-modal',
          variant: 'button-ghost',
          class: 'order-last h-11 w-full justify-between gap-3 rounded-full border-0 bg-white ps-5 pe-1.5 text-[#6b5a53] hover:bg-white focus-visible:outline-tangerine md:order-none md:h-12 md:w-auto md:max-w-[680px] md:flex-1',
          attributes: search_button_attrs -%}
          <span class="min-w-0 flex-1 truncate text-start text-[14px] font-normal" aria-hidden="true">{{ 'mp.search_placeholder' | t }}</span>
          <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-tangerine text-[#2e211d] md:size-10" aria-hidden="true"><span class="inline-flex size-4">{{- 'icon-search.svg' | inline_asset_content -}}</span></span>
        {%- endblock %}

        <div class="ms-auto flex shrink-0 items-center gap-1 md:ms-0">
          {%- capture header_localization_submit -%}
            {% block 'button', type: 'submit', variant: 'button-secondary', class: 'h-11 rounded-button px-3 text-xs' %}{{ 'localization.update_language' | t }}{% endblock %}
          {%- endcapture -%}
          {%- liquid
            assign header_currencies = localization.available_countries | map: 'currency' | map: 'iso_code' | uniq
            assign header_has_picker = false
            if localization.available_languages.size > 1 or header_currencies.size > 1
              assign header_has_picker = true
            endif
          -%}
          {%- if header_has_picker -%}
            {% render 'localization-form', show_country: true, id: 'header-localization', class: 'hidden md:block me-2 [&>button]:text-white! [&>button]:mx-0! [&>button]:rounded-full! [&>button]:px-3! [&>button]:hover:bg-white/10', submit_button: header_localization_submit %}
          {%- else -%}
            {%- comment -%} One language and currency: show them, like a marketplace header; becomes a picker when more are published. {%- endcomment -%}
            <span class="me-2 hidden items-center gap-1.5 rounded-full px-3 py-2 text-[13px] font-semibold text-white md:inline-flex">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
              <span aria-hidden="true">{{ localization.language.iso_code | upcase }}</span>
              <span class="text-white/40" aria-hidden="true">|</span>
              <span aria-hidden="true">{{ localization.country.currency.symbol }} {{ localization.country.currency.iso_code }}</span>
              <span class="sr-only">{{ localization.language.endonym_name }}, {{ localization.country.currency.iso_code }}</span>
            </span>
          {%- endif -%}



          <a href="{{ routes.all_products_collection_url }}?view=wishlist" class="relative inline-flex size-11 shrink-0 items-center justify-center rounded-full text-white no-underline hover:bg-white/10" aria-label="{{ 'wishlist.title' | t }}">
            <svg viewBox="0 0 24 24" class="size-[21px]" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.5 1.1 5 2.9 1.5-1.8 3-2.9 5-2.9 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            <span class="absolute end-0.5 top-0.5 flex min-w-[18px] items-center justify-center rounded-full bg-[#e0566b] px-1 text-[10.5px] font-bold leading-[18px] text-white" data-wishlist-count hidden>0</span>
          </a>
          {% if shop.customer_accounts_enabled %}
            {% render 'account-menu' %}
          {% endif %}

          {%- comment -%}
            The cart-count partial is swapped by s-cart.js after every cart mutation
            to keep the header badge count in sync — do not remove or rename this partial.
          {%- endcomment -%}
          {% partial 'cart-count' %}
            {%- comment -%} The label carries the live count so the trigger stays correctly named for assistive tech after each partial swap. {%- endcomment -%}
            {%- capture cart_button_attrs -%}id="header-cart-trigger" aria-label="{{ 'cart.icon_label' | t: count: cart.item_count | escape }}"{%- endcapture -%}
            {% block 'button',
              commandfor: 'cart-drawer',
              command: 'show-modal',
              variant: 'button-ghost',
              class: 'ms-1 size-[42px] shrink-0 rounded-full border-0 bg-white/10 text-white! hover:bg-white/20',
              attributes: cart_button_attrs -%}
              <span class="relative inline-flex items-center justify-center shrink-0 size-5 [&_svg]:size-full [&_svg]:stroke-[1.6]" aria-hidden="true">
                {{- 'icon-cart.svg' | inline_asset_content -}}
                {% if cart.item_count > 0 -%}
                  <span class="absolute top-0 inset-e-0 translate-x-1/2 rtl:-translate-x-1/2 -translate-y-1/2 flex items-center justify-center size-5 text-xs font-medium bg-interactive text-interactive-text rounded-full">
                    {{- cart.item_count -}}
                  </span>
                {%- endif -%}
              </span>
            {%- endblock %}
            <span aria-live="polite" aria-atomic="true" class="sr-only">
              {{ 'cart.item_count' | t: count: cart.item_count }}
            </span>
          {% endpartial %}
        </div>
      </div>
      {%- comment -%} Category strip: the store's main menu plus a permanent Domina shortcut. {%- endcomment -%}
      <div id="category-strip-slot">
      <div id="category-strip" class="bg-[#4a3530] md:data-[pinned]:fixed md:data-[pinned]:inset-x-0 md:data-[pinned]:top-0 md:data-[pinned]:z-40 md:data-[pinned]:shadow-[0_4px_14px_rgba(0,0,0,.2)] motion-safe:md:data-[pinned]:transition-[top] motion-safe:md:data-[pinned]:duration-300">
        <div class="mx-auto flex max-w-page items-center gap-2 px-margin py-2 md:py-1.5">
          {% block 'main-menu', class: 'hidden md:flex min-w-0 flex-wrap items-center gap-1 text-white [&_a]:rounded-full [&_a]:px-3.5 [&_a]:py-1.5 [&_a]:font-body [&_a]:text-[14px] [&_a]:font-semibold [&_a]:text-white [&_a:hover]:bg-white/10 [&_a:hover]:opacity-100 [&_a[aria-current]]:bg-white/15 [&_.nav-dropdown]:text-[#2b211e] [&_.nav-dropdown_a]:text-[#2b211e] [&_.nav-dropdown_a:hover]:bg-[#f3ece7]', mobile_nav_close_button: mobile_nav_close_button, mobile_nav_localization_submit: mobile_nav_localization_submit %}{% endblock %}
          {%- assign nav_domina_url = pages['domina-xl'].url | default: routes.all_products_collection_url -%}
          {% block 'link', url: nav_domina_url, class: 'w-full justify-center gap-2 md:w-auto md:ms-auto min-h-0! rounded-full bg-[#f6c453] px-5 py-2 md:px-4 md:py-1.5 font-heading text-[13.5px]! leading-tight! font-bold text-[#2e211d]! no-underline! shadow-[0_3px_0_#c99a2e] md:shadow-none hover:bg-[#ffd36b]!' %}<span>{{ 'mp.domina_badge' | t }}</span><span class="whitespace-nowrap font-body text-[12px] font-semibold text-[#6b4f1d] max-[359px]:hidden md:hidden">· {{ 'mnav.domina_body' | t }}</span><span class="inline-flex size-3.5 md:hidden rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>{% endblock %}
        </div>
      </div>
      </div>
      {%- comment -%} Black moving announcement ribbon under the menu bar. Edit messages in the theme language file (home.announce_2, home.announce_3, home.announce_4). {%- endcomment -%}
      {% style %}
        @keyframes ponyo-announce { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      {% endstyle %}
      <div class="overflow-hidden border-t border-white/10 bg-[#2e211d] py-1.5 text-white md:py-2" role="region" aria-label="{{ 'home.announce_label' | t | escape }}">
        <div class="flex w-max motion-safe:animate-[ponyo-announce_30s_linear_infinite] hover:[animation-play-state:paused] motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center">
          {%- for pass in (1..2) -%}
            <ul role="list" class="flex shrink-0 items-center gap-6 pe-6 md:gap-10 md:pe-10{% if pass == 2 %} motion-reduce:hidden{% endif %}"{% if pass == 2 %} aria-hidden="true"{% endif %}>
              <li class="whitespace-nowrap font-heading text-[11.5px] font-bold uppercase tracking-[0.1em] md:text-[12.5px]"><a href="{{ pages['domina-xl'].url | default: routes.all_products_collection_url }}" class="text-inherit no-underline hover:text-[#f6c453]"{% if pass == 2 %} tabindex="-1"{% endif %}>{{ 'home.announce_2' | t }}</a></li>
              <li class="text-[#f6c453]" aria-hidden="true">✦</li>
              <li class="whitespace-nowrap font-heading text-[11.5px] font-bold uppercase tracking-[0.1em] md:text-[12.5px]"><a href="{{ routes.root_url }}#drops" class="text-inherit no-underline hover:text-[#f6c453]"{% if pass == 2 %} tabindex="-1"{% endif %}>{{ 'home.announce_3' | t }}</a></li>
              <li class="text-[#f6c453]" aria-hidden="true">✦</li>
              <li class="whitespace-nowrap font-heading text-[11.5px] font-bold uppercase tracking-[0.1em] md:text-[12.5px]"><a href="{{ collections['rare-finds'].url | default: routes.all_products_collection_url }}" class="text-inherit no-underline hover:text-[#f6c453]"{% if pass == 2 %} tabindex="-1"{% endif %}>{{ 'home.announce_4' | t }}</a></li>
              <li class="text-[#f6c453]" aria-hidden="true">✦</li>
            </ul>
          {%- endfor -%}
        </div>
      </div>
      {% render 'smart-header' %}

      {% block 'predictive-search' %}
        {%- comment -%} These two partials are fetched together by s-live-form; keep their producers in the layout body so child usages and search data remain caller-owned. {%- endcomment -%}
        {%- comment -%} The action is both the native GET target and the partial fetch URL. Action-scoped requests never modify a search page's URL. {%- endcomment -%}
        <s-live-form class="block" partial="predictive-results,predictive-meta" debounce="300" data-no-url-sync data-updated-message="{{ 'accessibility.results_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t }}">
          <form action="{{ routes.search_url }}" method="get">
            {% partial 'predictive-meta' %}
              <span data-results-count hidden>{{ search.results_count }}</span>
            {% endpartial %}
            <div class="relative flex items-center gap-1 py-3 border-b border-border shrink-0 ps-3">
              <span class="inline-flex items-center justify-center shrink-0 size-5 text-on-surface-secondary" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span>
              <label for="predictive-search-input" class="sr-only">{{ 'search.placeholder' | t }}</label>
              <input
                id="predictive-search-input"
                type="search"
                name="q"
                role="combobox"
                aria-autocomplete="list"
                aria-controls="predictive-search-listbox"
                aria-expanded="false"
                placeholder="{{ 'search.placeholder' | t | escape }}"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                autofocus
                class="peer flex-1 bg-transparent text-on-surface text-base outline-none border-none placeholder:text-on-surface-secondary [&::-webkit-search-cancel-button]:hidden ps-1.5"
              >
              {%- comment -%} Clearing redispatches input through s-live-form's debounce/fetch flow. {%- endcomment -%}
              <button
                type="button"
                data-clear-search
                aria-label="{{ 'general.clear' | t }}"
                class="inline-flex items-center shrink-0 min-h-6 text-sm text-on-surface-secondary hover:text-on-surface motion-safe:transition-[color,transform] motion-safe:active:scale-[0.97] cursor-pointer peer-placeholder-shown:hidden pe-2.5 me-2"
              >{{ 'general.clear' | t }}</button>
              {%- comment -%} Divider offset follows the close button size and margin. {%- endcomment -%}
              <span class="absolute inset-y-0 inset-e-[calc(2.25rem+16px)] w-px bg-border peer-placeholder-shown:hidden" aria-hidden="true"></span>
              <button
                type="button"
                commandfor="predictive-search"
                command="close"
                class="inline-flex items-center justify-center shrink-0 size-9 rounded text-on-surface-secondary hover:text-on-surface hover:bg-surface-secondary cursor-pointer motion-safe:transition-[color,background-color,transform] motion-safe:active:scale-[0.97] me-2"
                aria-label="{{ 'general.close' | t }}"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </button>
            </div>
          </form>
        </s-live-form>

        {% partial 'predictive-results' %}
          <div class="relative flex-1 min-h-0">
            <div id="predictive-search-listbox" role="listbox" aria-label="{{ 'search.results_heading' | t }}" class="h-full overflow-y-auto p-4 pb-20">
              {% if search.performed and search.terms != blank %}
                {% if search.results_count > 0 %}
                  {%- assign has_products = false -%}
                  {%- assign option_index = 0 -%}
                  {%- assign product_count = 0 -%}
                  {%- comment -%} The dialog is full-width on mobile, then 90vw capped at 720px; subtract p-4 and 4px grid gaps. {%- endcomment -%}
                  {%- assign predictive_product_sizes = '(min-width: 800px) 169px, (min-width: 768px) calc((90vw - 44px) / 4), calc((100vw - 36px) / 2)' -%}
                  {%- capture product_items -%}{%- endcapture -%}

                  {%- for result in search.results -%}
                    {%- if result.object_type == 'product' -%}
                      {%- assign product_count = product_count | plus: 1 -%}
                      {%- if product_count <= 8 -%}
                        {%- assign has_products = true -%}
                        {%- capture product_items -%}
                          {{- product_items -}}
                          <li id="ps-option-{{ option_index }}" role="option" aria-selected="false" data-ps-url="{{ result.url | escape }}">
                            <s-view-event class="block" view-event-trigger="intersect" view-event-payload="{{ result | standard_event_data: 'view', context: 'dialog' | escape }}">
                              {%- assign card_variant = result.selected_or_first_available_variant -%}
                              {% block 'card', block.name: 't:blocks.product_card', url: result.url, aria_label: result.title, border_radius: 'rounded-card' %}
                                <a href="{{ result.url | escape }}" class="relative block overflow-hidden rounded-[inherit]" aria-label="{{ result.title | escape }}">
                                  {% block 'image', fallback_image: result.featured_image, aspect_ratio: 'aspect-square', alt: result.title, sizes: predictive_product_sizes, seed: product_count, attributes: 'loading="lazy"' %}{% endblock %}
                                </a>
                                <div class="flex flex-col gap-0.5">
                                  {% block 'text', tag: 'h3', variant: 'sm', class: 'font-medium text-on-surface line-clamp-2' %}{{ result.title | escape }}{% endblock %}
                                  {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: result.price_min, price_max: result.price_max, class: 'text-sm font-medium self-start group-[.text-center]/card:self-center group-[.text-end]/card:self-end' %}{% endblock %}
                                </div>
                              {% endblock %}
                            </s-view-event>
                          </li>
                        {%- endcapture -%}
                        {%- assign option_index = option_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if has_products -%}
                    <div role="group" aria-labelledby="ps-heading-products">
                      <h3 id="ps-heading-products" class="text-sm font-medium text-on-surface mb-3">
                        {{ 'search.products_heading' | t }}
                      </h3>
                      <ul class="grid grid-cols-2 md:grid-cols-4 gap-x-1 gap-y-3">
                        {{ product_items }}
                      </ul>
                    </div>
                  {%- endif -%}

                  <div class="sr-only" data-ps-result-count="{{ search.results_count }}">
                    {{ 'search.results_count_announcement' | t: count: search.results_count }}
                  </div>
                {% else %}
                  {%- comment -%} Search terms are untrusted query input; escape before plain-text translation interpolation. {%- endcomment -%}
                  {%- assign clean_search_terms = search.terms | strip_html | escape -%}
                  <p class="text-on-surface-secondary text-sm py-8 text-center">
                    {{ 'search.no_results' | t: terms: clean_search_terms }}
                  </p>
                  <div class="sr-only" data-ps-result-count="0">
                    {{ 'search.no_results_announcement' | t: terms: clean_search_terms }}
                  </div>
                {% endif %}
              {% endif %}
            </div>

            {%- comment -%} Fade and link refresh with results, including the encoded native search destination. {%- endcomment -%}
            {%- if search.performed and search.terms != blank and search.results_count > 0 -%}
              {%- assign encoded_search_terms = search.terms | url_encode -%}
              {%- assign view_all_results_url = routes.search_url | append: '?q=' | append: encoded_search_terms -%}
              <div data-fade-overlay class="absolute bottom-0 inset-x-0 flex items-end justify-center px-4 pb-4 pt-20 bg-linear-to-t from-surface to-transparent pointer-events-none">
                <div class="pointer-events-auto">
                  {% block 'button', url: view_all_results_url, variant: 'button-primary', class: 'h-11 px-14 text-sm rounded-button' %}{{ 'search.view_all_results' | t }}{% endblock %}
                </div>
              </div>
            {%- endif -%}
          </div>
        {% endpartial %}
      {% endblock %}

      <script type="module" src="{{ 's-predictive-search.js' | asset_url }}"></script>
      <script type="module" src="{{ 's-live-form.js' | asset_url }}"></script>

      {%- comment -%} === CART DRAWER (commerce-critical) ===
        This <s-cart> instance manages the drawer's cart UI via partial rendering.
        Its id ("cart-drawer-items") and data-partials values are coupled to s-cart.js —
        renaming breaks live quantity updates and header counters. cart-drawer-footer
        is included so the footer refreshes with cart mutations (additional checkout buttons
        depend on cart state). {%- endcomment -%}
      {%- capture cart_drawer_content -%}
        <s-cart class="block" id="cart-drawer-items" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
          {% partial 'cart-drawer' %}
          {%- comment -%} standard_event_data encodes the less-than character as <,
            so a literal closing-script tag in cart line attributes (note,
            line-item properties) cannot terminate this <script> early. {%- endcomment -%}
          <script type="application/json" data-view-event-payload>{{ cart | standard_event_data: 'view', context: 'dialog' }}</script>
          {% if cart.item_count > 0 %}
            <div class="divide-y divide-border -mt-4">
              {% for item in cart.items %}
                {%- comment -%} Drawer images lazy — display:none until opened, 64px thumbs defer imperceptibly {%- endcomment -%}
                {%- capture line_media -%}
                  {% if item.image %}{% block 'image', fallback_image: item.image, sizes: '64px', widths: '64,128', alt: item.product.title, class: 'size-full object-contain', attributes: 'loading="lazy"' %}{% endblock %}{% endif %}
                {%- endcapture -%}
                {%- capture line_unit_price -%}
                  {% block 'price', price: item.original_price, class: 'text-xs font-medium [&_span]:text-on-surface-secondary' %}{% endblock %}
                {%- endcapture -%}
                {%- assign remove_label = 'cart.remove' | t: title: item.product.title -%}
                {%- capture line_remove_attributes -%}aria-label="{{ remove_label | escape }}" data-variant-id="{{ item.variant_id }}" data-line-key="{{ item.key | escape }}"{%- endcapture -%}
                {%- capture line_remove_button -%}
                  {% block 'button', commandfor: 'cart-drawer-items', command: '--remove', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: line_remove_attributes %}<span class="inline-flex items-center justify-center shrink-0 size-4" aria-hidden="true">{{- 'icon-trash.svg' | inline_asset_content -}}</span>{% endblock %}
                {%- endcapture -%}
                {% render 'cart-line-item', item: item, cart_id: 'cart-drawer-items', compact: true, media: line_media, unit_price: line_unit_price, remove_button: line_remove_button %}
              {% endfor %}
            </div>
          {% elsif request.design_mode %}
            {% render 'cart-preview', layout: 'drawer' %}
          {% else %}
            {% render 'cart-empty', compact: true %}
          {% endif %}
          {% endpartial %}
        </s-cart>
      {%- endcapture -%}

      {%- capture cart_drawer_footer -%}
        {% partial 'cart-drawer-footer' %}
        {% if cart.item_count > 0 %}
          {%- comment -%} The footer has its own s-cart so discount input events and disclosure state stay locally owned while this pinned region refreshes. {%- endcomment -%}
          <s-cart class="block" id="cart-drawer-summary" data-partials="cart-drawer,cart-count,cart-drawer-count,cart-drawer-footer">
            {% form 'cart', cart, class: 'flex flex-col gap-3' %}
              {% render 'cart-discount-list', cart: cart %}
              <div class="flex items-center justify-between">
                <span class="text-sm font-medium text-on-surface">{{ 'cart.total_label' | t }}</span>
                <span class="text-base font-medium text-on-surface [view-transition-name:cart-total]" data-cart-total><bdi>{{ cart.total_price | money }}</bdi></span>
              </div>
              {% block 'button', type: 'submit', name: 'checkout', variant: 'button-primary', class: 'h-12 px-4 font-heading text-[15px] font-bold rounded-button w-full shadow-[0_4px_0_#7f4a38]' %}{{- 'cart.checkout' | t -}}{% endblock %}

              {%- comment -%} Additional checkout buttons are server-rendered by Shopify when accelerated checkout methods are available. The platform class is required by Shopify's injected markup. {%- endcomment -%}
              {% if additional_checkout_buttons %}
                <div class="additional-checkout-buttons border-t border-border pt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {% endif %}

              {% render 'cart-discount-code', cart_id: 'cart-drawer-summary', input_id: 'cart-drawer-discount-input' %}
            {% endform %}
          </s-cart>
        {% endif %}
        {% endpartial %}
      {%- endcapture -%}

      {%- capture cart_drawer_header -%}
        <div class="flex items-center shrink-0 ps-4 py-2">
          <div class="flex items-center gap-2 flex-1">
            <h2 id="cart-drawer-title" class="font-heading text-xl font-bold text-[#4a3530]">{{ 'cart.title' | t }}</h2>
            {%- comment -%} {% partial 'cart-drawer-count' %} is swapped with the drawer cart partials so the title badge stays in sync after cart mutations. {%- endcomment -%}
            {% partial 'cart-drawer-count' %}
              {% if cart.item_count > 0 %}
                {%- comment -%} size-5.5 = 22px (5.5 * 4px base) {%- endcomment -%}
                <span class="flex items-center justify-center text-xs font-medium bg-surface-secondary text-on-surface rounded-full size-5.5">{{ cart.item_count }}</span>
              {% endif %}
            {% endpartial %}
          </div>
          {%- capture cart_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
          {% block 'button', commandfor: 'cart-drawer', command: 'close', variant: 'button-ghost', class: 'size-touch-target rounded hover:bg-transparent hover:opacity-70', autofocus: true, attributes: cart_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
        </div>
      {%- endcapture -%}
      {% render 'cart-drawer',
        header: cart_drawer_header,
        content: cart_drawer_content,
        footer: cart_drawer_footer,
        attributes: 'aria-labelledby="cart-drawer-title"'
      %}
    {% endblock %}

    <main class="flex-1" id="main-content" tabindex="-1" data-template="{{ request.page_type }}">
      {{ content_for_layout }}
    </main>

    {% render 'sr-announcer' %}

    {%- comment -%} Offscreen footer rendering can be skipped; the intrinsic block-size hint reserves space for the stacked mobile link list until its actual height is known. {%- endcomment -%}
    {%- liquid
      assign show_newsletter = false
      case template.name
        when 'index', 'collection', 'page', 'search', 'blog', 'list-collections'
          assign show_newsletter = true
      endcase
    -%}
    {%- if show_newsletter -%}
      {%- comment -%} Newsletter panel with mascot, shown on browsing pages like the reference. {%- endcomment -%}
      {% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-16', attributes: 'aria-labelledby="newsletter-title"' %}
        <div class="relative grid items-center gap-8 overflow-hidden rounded-3xl bg-linear-120 from-[#f3e1da] to-[#f6ece4] px-6 py-10 md:grid-cols-[auto_1fr_auto] md:px-10 md:py-12">
          <div class="flex flex-col items-center gap-2.5 text-center">
            <span class="block size-[90px] overflow-hidden rounded-full bg-white shadow-[0_4px_16px_rgba(110,74,62,.08)] [&_img]:size-full [&_img]:object-cover">
              {%- assign mascot_image = images['maker-penguin.jpg'] -%}
              {% block 'image', fallback_image: mascot_image, aspect_ratio: 'aspect-square', alt: '', sizes: '90px', widths: '180,270', attributes: 'loading="lazy"' %}{% endblock %}
            </span>
            {% block 'text', variant: 'sm', class: 'font-heading font-extrabold text-[#4a3530]' %}{{ 'home.newsletter.kicker' | t }}{% endblock %}
            {% block 'text', variant: 'sm', class: 'text-xs! text-on-surface-secondary' %}{{ 'home.newsletter.kicker_sub' | t }}{% endblock %}
          </div>
          <div class="text-center">
            {% block 'heading', tag: 'h2', variant: 'sm', class: 'mb-5 font-extrabold tracking-tight text-[#4a3530] text-[26px]!', attributes: 'id="newsletter-title"' %}{{ 'home.newsletter.title' | t }}{% endblock %}
            {%- form 'customer', id: 'home-newsletter', class: 'mx-auto flex max-w-md flex-col gap-2.5 sm:flex-row' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="text-sm font-bold text-accent" role="status">{{ 'home.newsletter.success' | t }}</p>
              {%- else -%}
                <label for="home-newsletter-email" class="sr-only">{{ 'home.newsletter.placeholder' | t }}</label>
                <input id="home-newsletter-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'home.newsletter.placeholder' | t | escape }}" class="h-12 min-w-0 flex-1 rounded-full border border-border bg-white px-5 text-sm text-on-surface shadow-[0_4px_16px_rgba(110,74,62,.08)] placeholder:text-on-surface-secondary focus-visible:outline-2 focus-visible:outline-accent">
                {% block 'button', type: 'submit', variant: 'button-primary', class: 'h-12 rounded-full px-6 font-heading text-sm font-extrabold' %}{{ 'home.newsletter.submit' | t }}{% endblock %}
              {%- endif -%}
            {%- endform -%}
          </div>
          <div class="hidden flex-col items-center gap-1 md:flex">
            <span class="font-heading text-2xl font-extrabold tracking-[0.18em] text-[#4a3530]">{{ shop.name | upcase | escape }}</span>
            {% block 'text', variant: 'sm', class: 'text-xs! text-on-surface-secondary' %}{{ 'home.newsletter.tagline' | t }}{% endblock %}
          </div>
        </div>
      {% endblock %}
    {%- endif -%}

    {%- comment -%} Forest footer matched to the reference: meadow, wave, brand, Shop / Explore / Support columns, legal bar. {%- endcomment -%}
    {% style %}
      @keyframes ponyo-meadow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
    {% endstyle %}
    {% block 'footer', background: settings.color_palette.color1, class: 'relative mt-24 w-full text-forest-muted' %}
      <div class="pointer-events-none absolute inset-x-0 -top-[78px] h-20" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="absolute inset-0 size-full"><path d="M0 40 C 240 0, 480 80, 720 40 C 960 0, 1200 80, 1440 40 L1440 80 L0 80 Z" fill="{{ settings.color_palette.color1 }}"/></svg>
      </div>
      {%- comment -%} Ponyo jellyfish from the logo, floating gently above the footer wave. Sizes and tints alternate for a quiet, premium rhythm. {%- endcomment -%}
      <div class="pointer-events-none absolute inset-x-0 -top-10 z-10 flex h-10 items-center justify-around" aria-hidden="true">
        {%- assign jelly_sizes = '28,18,24,16,28,18,24' | split: ',' -%}
        {%- for size in jelly_sizes -%}
          {%- assign jelly_fill = '#f4ddd3' -%}
          {%- assign jelly_opacity = '0.95' -%}
          {%- if size == '18' or size == '16' -%}{%- assign jelly_fill = '#d9b9a9' -%}{%- assign jelly_opacity = '0.7' -%}{%- endif -%}
          <span class="inline-flex motion-safe:animate-[ponyo-meadow_4s_ease-in-out_infinite]" style="animation-duration: 6s; animation-delay: -{{ forloop.index0 | times: 0.8 }}s; opacity: {{ jelly_opacity }}">
            <svg viewBox="0 0 64 64" width="{{ size }}" height="{{ size }}"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="{{ jelly_fill }}"/><circle cx="26" cy="23" r="2.4" fill="#2e211d"/><circle cx="38" cy="23" r="2.4" fill="#2e211d"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="{{ jelly_fill }}" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
          </span>
        {%- endfor -%}
      </div>

      <div class="mx-auto flex w-full max-w-page flex-col px-margin pt-12 text-sm">
        <div class="grid gap-10 border-b border-[rgba(255,232,222,.18)] pb-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
          <div class="flex flex-col gap-3.5">
            <span class="inline-flex items-center gap-2.5">
              <span class="inline-flex size-10 items-center justify-center rounded-full border border-[rgba(255,240,232,.72)] bg-ivory" aria-hidden="true"><svg viewBox="0 0 64 64" class="size-7"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="#5a3e38"/><circle cx="26" cy="23" r="2.6" fill="#fff9f3"/><circle cx="38" cy="23" r="2.6" fill="#fff9f3"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="#5a3e38" stroke-width="3" stroke-linecap="round" fill="none"/></svg></span>
              {% block 'logo', class: 'font-heading text-2xl font-extrabold uppercase tracking-[0.14em] text-ivory!' %}{% endblock %}
            </span>
            {% block 'text', variant: 'sm', class: 'max-w-[280px] text-[13px]! text-forest-muted' %}{{ 'home.footer.about' | t }}{% endblock %}
          </div>
          <div class="flex flex-col gap-2">
            {% block 'text', tag: 'h2', variant: 'sm', class: 'mb-1 font-heading text-[15px]! font-extrabold text-ivory' %}{{ 'home.footer.shop' | t }}{% endblock %}
            <ul role="list" class="flex flex-col gap-1">
              <li>{% block 'link', url: routes.all_products_collection_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.shop_all' | t }}{% endblock %}</li>
              {%- liquid
                assign footer_rare_url = collections['rare-finds'].url | default: routes.all_products_collection_url
                assign footer_premium_url = collections['premium'].url | default: routes.all_products_collection_url
                assign footer_xl_url = collections['domina-xl'].url | default: '/pages/domina-xl'
                assign footer_new_url = collections['new-arrivals'].url | default: routes.all_products_collection_url
                assign footer_characters_url = collections['characters'].url | default: routes.all_products_collection_url
              -%}
              <li>{% block 'link', url: footer_rare_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.rare' | t }}{% endblock %}</li>
              <li>{% block 'link', url: footer_premium_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.premium' | t }}{% endblock %}</li>
              <li>{% block 'link', url: footer_xl_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.domina' | t }}{% endblock %}</li>
              <li>{% block 'link', url: footer_new_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.new' | t }}{% endblock %}</li>
              <li>{% block 'link', url: footer_characters_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.characters' | t }}{% endblock %}</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2">
            {% block 'text', tag: 'h2', variant: 'sm', class: 'mb-1 font-heading text-[15px]! font-extrabold text-ivory' %}{{ 'home.footer.explore' | t }}{% endblock %}
            <ul role="list" class="flex flex-col gap-1">
              <li>{% block 'link', url: '/pages/about', class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.about_link' | t }}{% endblock %}</li>
              <li>{%- assign footer_journal_url = blogs.news.url | default: '/blogs/news' -%}{% block 'link', url: footer_journal_url, class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.journal' | t }}{% endblock %}</li>
              <li>{% block 'link', url: '/pages/contact', class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.request' | t }}{% endblock %}</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2">
            {% block 'text', tag: 'h2', variant: 'sm', class: 'mb-1 font-heading text-[15px]! font-extrabold text-ivory' %}{{ 'home.footer.support' | t }}{% endblock %}
            <ul role="list" class="flex flex-col gap-1">
              <li>{% block 'link', url: '/pages/faq', class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.faq' | t }}{% endblock %}</li>
              <li>{% block 'link', url: '/#drops', class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.drops' | t }}{% endblock %}</li>
              <li>{% block 'link', url: '/pages/contact', class: 'min-h-0! py-1 text-sm! text-[#f1ddd6]! no-underline! hover:text-ivory! hover:underline!' %}{{ 'home.footer.contact' | t }}{% endblock %}</li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col gap-3 py-6 text-xs text-[#dcc0b6] md:flex-row md:flex-wrap md:items-center md:justify-between">
          <p class="m-0">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'home.footer.rights' | t }}</p>
          {% if shop.policies.size > 0 %}
            <nav aria-label="{{ 'footer.policies' | t | escape }}">
              <ul role="list" class="flex flex-wrap gap-x-4 gap-y-2">
                {%- for policy in shop.policies -%}
                  {%- if policy != blank -%}
                    <li>
                      <a
                        href="{{ policy.url }}"
                        class="inline-flex items-center min-h-touch-target font-normal no-underline text-[#dcc0b6] hover:text-ivory focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-colors"
                      >
                        {{ policy.title | escape }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </nav>
          {% endif %}
          {%- if shop.enabled_payment_types.size > 0 -%}
            <ul role="list" class="m-0 flex list-none flex-wrap items-center gap-1.5 p-0" aria-label="{{ 'mp.payment_methods' | t | escape }}">
              {%- for type in shop.enabled_payment_types -%}
                <li class="flex h-6 items-center overflow-hidden rounded bg-white [&_svg]:h-6 [&_svg]:w-auto">{{ type | payment_type_svg_tag }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <p class="m-0 [&_a]:text-[#dcc0b6] [&_a]:no-underline [&_a:hover]:text-ivory">{{ powered_by_link }}</p>
        </div>
      </div>
    {% endblock %}

    {%- unless template.name == 'product' -%}{% render 'mobile-tab-bar' %}{%- endunless -%}
    {% render 'notification-host' %}
    {% render 'theme-scripts' %}
    {% render 'command-polyfill' %}
    <script type="module" src="{{ 'ponyo-wishlist.js' | asset_url }}"></script>
  </body>
</html>
