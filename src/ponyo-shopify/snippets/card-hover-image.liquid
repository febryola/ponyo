{% doc %}
  Second product photo that fades in when the shopper hovers a product card
  (the card needs the group/card class). Renders nothing when the product has
  only one image.

  @param {object} product - The product. @required
  @param {string} [sizes] - Image sizes attribute.

  @example
  {% render 'card-hover-image', product: product, sizes: '45vw' %}
{% enddoc %}
{%- liquid
  assign second_image = blank
  for media in product.media offset: 1
    if media.media_type == 'image'
      assign second_image = media.preview_image
      break
    endif
  endfor
-%}
{%- if second_image != blank -%}
  {{ second_image | image_url: width: 700 | image_tag: alt: '', loading: 'lazy', widths: '300,450,600,700', sizes: sizes, class: 'pointer-events-none absolute inset-0 z-[1] size-full object-cover opacity-0 motion-safe:transition-opacity motion-safe:duration-500 group-hover/card:opacity-100 max-md:hidden' }}
{%- endif -%}
