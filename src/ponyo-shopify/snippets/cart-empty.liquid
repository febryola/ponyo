{% doc %}
  Friendly empty-cart state with a shop button and quick links to plush categories.
  Category links use real collections and fall back to all products when a collection is missing.

  @param {boolean} [compact] - Tighter spacing for the cart drawer. Default: false.

  @category commerce
  @renders div

  @example
  {% render 'cart-empty', compact: true %}
{% enddoc %}

{%- liquid
  assign compact = compact | default: false
  assign all_url = routes.all_products_collection_url
  assign link_bears = collections['bears'].url | default: all_url
  assign link_bunnies = collections['bunnies'].url | default: all_url
  assign link_domina = collections['domina-xl'].url | default: all_url
  assign link_new = collections['new-arrivals'].url | default: all_url
-%}

<div class="flex flex-col items-center text-center {% if compact %}py-8{% else %}py-16{% endif %}">
  <span class="mb-4 inline-flex size-16 items-center justify-center rounded-full bg-[#f3ece7] text-[#a2502f] [&_svg]:size-7" aria-hidden="true">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
  <p class="m-0 font-heading text-xl font-bold text-[#4a3530]">{{ 'cart.empty' | t }}</p>
  <p class="m-0 mt-1.5 max-w-[320px] text-sm text-on-surface-secondary">{{ 'mp.cart_empty_body' | t }}</p>
  <a href="{{ all_url }}" class="mt-5 inline-flex h-11 items-center justify-center rounded-button bg-interactive px-7 font-heading text-sm font-bold text-interactive-text no-underline shadow-[0_4px_0_#7f4a38] hover:opacity-90">{{ 'cart.continue_shopping' | t }}</a>
  <p class="m-0 mt-6 text-xs font-bold uppercase tracking-wide text-on-surface-secondary">{{ 'mp.cart_popular' | t }}</p>
  <ul role="list" class="m-0 mt-2 flex list-none flex-wrap justify-center gap-2 p-0">
    <li><a href="{{ link_bears }}" class="inline-flex h-9 items-center rounded-full border border-[#e8dfd9] bg-white px-4 text-[13px] font-semibold text-[#4a3530] no-underline hover:border-[#a2502f]">{{ 'home.categories.bears' | t }}</a></li>
    <li><a href="{{ link_bunnies }}" class="inline-flex h-9 items-center rounded-full border border-[#e8dfd9] bg-white px-4 text-[13px] font-semibold text-[#4a3530] no-underline hover:border-[#a2502f]">{{ 'home.categories.bunnies' | t }}</a></li>
    <li><a href="{{ link_new }}" class="inline-flex h-9 items-center rounded-full border border-[#e8dfd9] bg-white px-4 text-[13px] font-semibold text-[#4a3530] no-underline hover:border-[#a2502f]">{{ 'home.new_arrivals.title' | t }}</a></li>
    <li><a href="{{ link_domina }}" class="inline-flex h-9 items-center rounded-full bg-[#f6c453] px-4 text-[13px] font-bold text-[#2e211d] no-underline hover:opacity-90">Domina XL</a></li>
  </ul>
</div>
