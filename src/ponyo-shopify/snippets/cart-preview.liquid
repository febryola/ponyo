{% doc %}
  Design-only cart preview. Renders sample plush lines and a summary so the
  merchant can review the cart design in the theme editor while the real cart
  is empty. Callers must only render it when request.design_mode is true, so
  shoppers never see sample items.

  @param {string} [layout] - 'drawer' for the compact cart drawer, 'page' for the cart page. Default: 'drawer'.

  @category commerce
  @renders div

  @example
  {% if request.design_mode %}{% render 'cart-preview', layout: 'drawer' %}{% endif %}
{% enddoc %}

{%- liquid
  assign layout = layout | default: 'drawer'
  assign sample_lines = 'maker-bear.jpg|Hoshi Cloud Bear|Classic plush|1880000|1^^maker-bunny.jpg|Haneul Bunny XL|Domina XL · 100 cm|7450000|1^^maker-pink-bunny.jpg|Cherry Blossom Bunny|Bunny plush|2290000|2' | split: '^^'
  assign sample_total = 0
  assign sample_count = 0
  for line in sample_lines
    assign f = line | split: '|'
    assign line_total = f[3] | times: f[4]
    assign sample_total = sample_total | plus: line_total
    assign sample_count = sample_count | plus: f[4]
  endfor
  if layout == 'page'
    assign thumb_class = 'size-[84px] sm:size-24'
  else
    assign thumb_class = 'size-[72px]'
  endif
-%}

<div class="flex flex-col gap-4" data-cart-preview>
  <p class="m-0 flex items-center gap-2 rounded-[14px] border border-dashed border-[#e2c8bb] bg-[#fff7f1] px-3 py-2 text-[12px] font-semibold text-[#8a5a46]">
    <span class="inline-flex size-4 shrink-0" aria-hidden="true">{{- 'icon-tag.svg' | inline_asset_content -}}</span>
    {{ 'mp.cart_preview_note' | t }}
  </p>

  <div class="{% if layout == 'page' %}flex flex-col gap-8 lg:grid lg:grid-cols-[1fr_380px] lg:items-start lg:gap-10{% else %}flex flex-col gap-4{% endif %}">
    <ul role="list" class="m-0 flex list-none flex-col gap-3 p-0">
      {%- for line in sample_lines -%}
        {%- assign f = line | split: '|' -%}
        {%- assign line_total = f[3] | times: f[4] -%}
        <li class="flex gap-3 rounded-[18px] border border-[#efe1d8] bg-white p-2.5">
          <span class="{{ thumb_class }} block shrink-0 overflow-hidden rounded-[14px] bg-[#fbf3ec]">
            {%- assign line_image = images[f[0]] -%}
            {%- if line_image != blank -%}
              {{ line_image | image_url: width: 192 | image_tag: alt: f[1], class: 'size-full object-cover object-[center_30%]', loading: 'lazy', widths: '96,192' }}
            {%- endif -%}
          </span>
          <div class="flex min-w-0 flex-1 flex-col">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="m-0 line-clamp-2 text-[14px] font-semibold leading-snug text-[#3f302b]">{{ f[1] }}</p>
                <p class="m-0 text-xs font-bold text-accent">{{ f[2] }}</p>
              </div>
              <p class="m-0 shrink-0 font-heading text-[15px] font-bold text-[#4a3530]"><bdi>{{ line_total | money }}</bdi></p>
            </div>
            <div class="mt-auto flex items-center justify-between gap-2 pt-2">
              <span class="inline-flex h-8 items-center rounded-full border border-[#e8dfd9] bg-[#faf7f4] text-sm text-[#4a3530]" aria-label="{{ 'product.quantity_input' | t: title: f[1] | escape }}">
                <span class="inline-flex size-8 items-center justify-center text-on-surface-secondary" aria-hidden="true"><span class="size-3">{{- 'icon-minus.svg' | inline_asset_content -}}</span></span>
                <span class="w-6 text-center font-semibold">{{ f[4] }}</span>
                <span class="inline-flex size-8 items-center justify-center text-on-surface-secondary" aria-hidden="true"><span class="size-3">{{- 'icon-plus.svg' | inline_asset_content -}}</span></span>
              </span>
              <span class="text-[12px] text-on-surface-secondary"><bdi>{{ f[3] | money }}</bdi> {{ 'mp.cart_each' | t }}</span>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="rounded-[20px] bg-[#f3ece7] p-4 {% if layout == 'page' %}lg:sticky lg:top-8 lg:p-6{% endif %}">
      <dl class="m-0 flex flex-col gap-2 text-sm">
        <div class="flex justify-between text-[#5b463f]">
          <dt>{{ 'mp.cart_subtotal' | t: count: sample_count }}</dt>
          <dd class="m-0"><bdi>{{ sample_total | money }}</bdi></dd>
        </div>
        <div class="flex justify-between text-[#5b463f]">
          <dt>{{ 'mp.cart_shipping' | t }}</dt>
          <dd class="m-0">{{ 'mp.cart_at_checkout' | t }}</dd>
        </div>
        <div class="mt-1 flex items-baseline justify-between border-t border-[#e2d6ce] pt-3">
          <dt class="font-heading font-bold text-[#4a3530]">{{ 'cart.total_label' | t }}</dt>
          <dd class="m-0 font-heading text-xl font-bold text-[#4a3530]"><bdi>{{ sample_total | money }}</bdi></dd>
        </div>
      </dl>
      <span class="mt-4 flex h-12 w-full items-center justify-center rounded-button bg-interactive font-heading text-[15px] font-bold text-interactive-text shadow-[0_4px_0_#7f4a38]" aria-disabled="true">{{ 'cart.checkout' | t }}</span>
      <p class="m-0 mt-2 text-center text-xs text-on-surface-secondary">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
    </div>
  </div>
</div>
