{% doc %}
  Renders a platform-generated filter checkbox as a text row or visual swatch.
  Used by both the visible and the expandable value lists in filter-group.
  The generated values are not independently authored block usages.

  @param {object} filter - Collection/search filter owning the URL parameter. @required
  @param {object} value - A platform filter value. @required

  @example
  {% render 'filter-value', filter: filter, value: value %}
{% enddoc %}

{%- assign is_disabled = false -%}
{% if value.count == 0 and value.active == false %}{% assign is_disabled = true %}{% endif %}
<li>
  {% if filter.presentation == 'swatch' or filter.presentation == 'image' %}
    {%- capture value_label -%}{{ value.label }}{% if value.count != blank %} ({{ value.count }}){% endif %}{%- endcapture -%}
    <label class="group/swatch relative inline-flex{% if is_disabled %} opacity-50 cursor-not-allowed{% else %} cursor-pointer motion-safe:active:scale-[0.93]{% endif %}" title="{{ value_label | escape }}">
      <input type="checkbox" name="{{ filter.param_name | escape }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if is_disabled %} disabled{% endif %} class="sr-only">
      <span class="relative swatch-md rounded-full border-2 border-border shrink-0 overflow-hidden inline-flex items-center justify-center bg-surface-secondary group-has-[:checked]/swatch:border-interactive group-has-[:focus-visible]/swatch:ring-2 group-has-[:focus-visible]/swatch:ring-accent group-has-[:focus-visible]/swatch:ring-offset-2"
        {% if value.swatch.color %}style="background-color: {{ value.swatch.color | escape }}"{% elsif value.swatch.image %}style="background-image: url('{{ value.swatch.image | image_url: width: 100 | escape }}'); background-size: cover; background-position: center"{% elsif value.image %}style="background-image: url('{{ value.image | image_url: width: 100 | escape }}'); background-size: cover; background-position: center"{% endif %}>
        <span class="absolute inset-0 flex items-center justify-center opacity-0 group-has-[:checked]/swatch:opacity-100 motion-safe:transition-opacity motion-safe:duration-200 bg-black/25" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        </span>
        {% if is_disabled %}
          <svg class="absolute inset-0 size-full text-on-surface" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><line x1="4" y1="4" x2="20" y2="20"/></svg>
        {% endif %}
      </span>
      <span class="sr-only">{{ value_label | escape }}{% if is_disabled %} ({{ 'collections.value_unavailable' | t }}){% endif %}</span>
    </label>
  {% else %}
    <label class="group/filter inline-flex min-h-10 items-center gap-1.5 rounded-full border-2 border-[#e9d3c8] bg-white px-3.5 text-[14px] font-semibold text-[#4a3530] has-[:checked]:border-[#4a3530] has-[:checked]:bg-[#4a3530] has-[:checked]:text-white has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-accent{% if is_disabled %} opacity-40 cursor-not-allowed{% else %} cursor-pointer motion-safe:active:scale-[0.96]{% endif %}">
      <input type="checkbox" name="{{ filter.param_name | escape }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if is_disabled %} disabled{% endif %} class="sr-only">
      <svg class="hidden size-3.5 group-has-[:checked]/filter:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <span>{{ value.label | escape }}{% if is_disabled %}<span class="sr-only"> ({{ 'collections.value_unavailable' | t }})</span>{% endif %}</span>
      {% if value.count != blank %}<span class="text-[12px] font-medium opacity-60">{{ value.count }}</span>{% endif %}
    </label>
  {% endif %}
</li>
