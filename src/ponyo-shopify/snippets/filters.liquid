{% doc %}
  Renders the shared collection/search filter toolbar, sort select, active chips,
  persistent dialog, and their named partials. Page templates own the form and
  capture each independently editable button block before rendering this utility.
  Only the dialog's filter-list partial is replaced, so its open state survives.

  @param {string} page_type - 'collection' or 'search'. @required
  @param {object} resource - The collection or search drop. @required
  @param {string} drawer_id - Stable ID targeted by the captured command buttons. @required
  @param {string} filter_trigger - Captured button block that opens the dialog. @required
  @param {string} toolbar_submit - Captured no-JavaScript toolbar submit button. @required
  @param {string} close_button - Captured dialog close button block. @required
  @param {string} show_results_button - Captured dialog show-results button block. @required
  @param {string} drawer_submit - Captured no-JavaScript dialog submit button. @required
  @param {string} [search_terms] - Sanitized, unescaped search terms; only for search.

  @example
  {% capture filter_trigger %}
    {% block 'button', commandfor: 'collection-filter-drawer', command: 'show-modal' %}{{ 'collections.filter' | t }}{% endblock %}
  {% endcapture %}
  {% render 'filters', page_type: 'collection', resource: collection, drawer_id: 'collection-filter-drawer', filter_trigger: filter_trigger, toolbar_submit: submit_button, close_button: close_button, show_results_button: show_results_button, drawer_submit: drawer_submit %}
{% enddoc %}

{%- liquid
  assign selected_sort = resource.sort_by | default: resource.default_sort_by
  assign show_toolbar = true
  if page_type == 'search'
    assign show_toolbar = false
    if resource.performed and resource.terms != blank
      assign show_toolbar = true
    endif
    assign escaped_terms = search_terms | escape
    assign encoded_terms = search_terms | url_encode
    assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms
  else
    assign clear_url = resource.url
  endif
-%}

{% capture toolbar_markup %}
  <div class="max-w-page mx-auto px-margin mb-5 grid grid-cols-2 items-center gap-2.5 md:mb-6 md:flex md:flex-wrap md:gap-4">
    {% if resource.filters.size > 0 %}<div class="contents md:block [&>*]:w-full md:[&>*]:w-auto">{{ filter_trigger }}</div>{% endif %}
    {% if page_type == 'collection' %}
      <div class="order-last col-span-2 md:order-none md:col-span-1">{% partial 'collection-count' %}
        <span data-results-count hidden>{{ resource.products_count }}</span>
        <span class="text-[13px] font-semibold text-on-surface-secondary">{{ 'collections.products_count' | t: count: resource.products_count }}</span>
        <span class="sr-only" data-live-announce>{{ 'collections.products_count' | t: count: resource.products_count }}</span>
      {% endpartial %}</div>
    {% else %}
      <span class="text-sm text-on-surface-secondary">{{ 'search.results_for' | t: count: resource.results_count, terms: escaped_terms }}</span>
    {% endif %}
    {% if resource.sort_options.size > 0 %}
      <div class="flex min-w-0 items-center gap-2 md:ms-auto{% if resource.filters.size == 0 %} col-span-2{% endif %}">
        <label for="{{ page_type | escape }}-sort" class="sr-only md:not-sr-only md:text-sm md:text-on-surface-secondary md:whitespace-nowrap">{{ 'collections.sort_by' | t }}</label>
        <div class="relative min-w-0 flex-1 md:flex-none">
          <select id="{{ page_type | escape }}-sort" name="sort_by" class="h-11 w-full appearance-none min-w-0 cursor-pointer truncate rounded-full border-2 border-[#e9d3c8] bg-white ps-4 pe-9 font-heading text-[14px] font-bold text-[#4a3530] md:w-auto">
            {% for option in resource.sort_options %}
              <option value="{{ option.value | escape }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name | escape }}</option>
            {% endfor %}
          </select>
          <span class="pointer-events-none absolute inset-e-3 top-1/2 -translate-y-1/2 size-4" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
        </div>
      </div>
    {% endif %}
    <noscript>{{ toolbar_submit }}</noscript>
  </div>
{% endcapture %}
{% if page_type == 'search' %}
  {% partial 'search-toolbar' %}
    {% if show_toolbar %}{{ toolbar_markup }}{% endif %}
  {% endpartial %}
{% else %}
  {{ toolbar_markup }}
{% endif %}

{%- assign has_active_filters = false -%}
{%- for filter in resource.filters -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}{%- assign has_active_filters = true -%}{%- endif -%}
  {%- else -%}
    {%- for value in filter.values -%}
      {%- if value.active -%}{%- assign has_active_filters = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if has_active_filters -%}{%- break -%}{%- endif -%}
{%- endfor -%}
{% capture chips_markup %}
  {% if has_active_filters %}
    <div class="max-w-page mx-auto px-margin flex flex-wrap items-center gap-2 mb-6" role="region" aria-label="{{ 'collections.active_filters' | t }}">
      {% for filter in resource.filters %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value != blank or filter.max_value.value != blank %}
            {%- capture price_label -%}{{ filter.label | escape }}: {{ filter.min_value.value | default: filter.range_min | money }} – {{ filter.max_value.value | default: filter.range_max | money }}{%- endcapture -%}
            {%- assign remove_label = 'collections.remove_filter' | t: filter: filter.label -%}
            <a href="{{ filter.url_to_remove | escape }}" aria-label="{{ remove_label | escape }}" class="inline-flex min-h-touch-target items-center gap-2 px-3 rounded-button bg-surface-secondary text-on-surface text-sm no-underline hover:bg-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-[color,transform] motion-safe:active:scale-[0.97]">{{ price_label }}<span class="inline-flex size-4 shrink-0" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span></a>
          {% endif %}
        {% else %}
          {% for value in filter.values %}
            {% if value.active %}
              {%- assign remove_label = 'collections.remove_filter' | t: filter: value.label -%}
              <a href="{{ value.url_to_remove | escape }}" aria-label="{{ remove_label | escape }}" class="inline-flex min-h-touch-target items-center gap-2 px-3 rounded-button bg-surface-secondary text-on-surface text-sm no-underline hover:bg-border focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-[color,transform] motion-safe:active:scale-[0.97]">{{ value.label | escape }}<span class="inline-flex size-4 shrink-0" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span></a>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endfor %}
      <a href="{{ clear_url | escape }}" class="inline-flex min-h-touch-target items-center text-sm text-accent underline underline-offset-2 rounded-sm hover:text-on-surface-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-[color,transform] motion-safe:active:scale-[0.97]">{{ 'collections.clear_all' | t }}</a>
    </div>
  {% endif %}
{% endcapture %}
{% if page_type == 'search' %}
  {% partial 'search-chips' %}
    {% if show_toolbar %}{{ chips_markup }}{% endif %}
  {% endpartial %}
{% else %}
  {% partial 'collection-chips' %}{{ chips_markup }}{% endpartial %}
{% endif %}

{% capture filter_groups %}
  {% for filter in resource.filters %}
    {% render 'filter-group', filter: filter %}
  {% endfor %}
{% endcapture %}
<s-dialog class="block">
  <dialog id="{{ drawer_id | escape }}" aria-labelledby="{{ drawer_id | escape }}-title" class="overlay-panel [--panel-closed-transform:translateX(-100%)] rtl:[--panel-closed-transform:translateX(100%)] [:where(&)]:fixed [:where(&)]:inset-y-0 [:where(&)]:inset-s-0 [:where(&)]:inset-e-auto [:where(&)]:w-screen [:where(&)]:h-full [:where(&)]:pt-(--safe-area-inset-top) [:where(&)]:pb-(--safe-area-inset-bottom) [:where(&)]:ps-(--safe-area-inset-inline-start) [:where(&)]:pe-0 min-[480px]:[:where(&)]:w-drawer-width max-[479px]:w-[92vw] overflow-hidden rounded-e-[24px] bg-[#fffaf5] text-on-surface">
    <div class="flex flex-col h-full">
      <div class="flex items-center shrink-0 border-b border-[#efe1d8] bg-white ps-5 pe-2 py-2.5">
        <h2 id="{{ drawer_id | escape }}-title" class="m-0 flex-1 font-heading text-[20px] font-extrabold text-[#4a3530]">{{ 'collections.filters' | t }}</h2>
        {{ close_button }}
      </div>
      <div class="flex-1 overflow-y-auto px-5 py-2">
        {% if page_type == 'search' %}
          {% partial 'search-filters' %}{{ filter_groups }}{% endpartial %}
        {% else %}
          {% partial 'collection-filters' %}{{ filter_groups }}{% endpartial %}
        {% endif %}
      </div>
      <div class="shrink-0 flex items-center gap-3 border-t border-[#efe1d8] bg-white px-5 pt-3 pb-[max(.75rem,env(safe-area-inset-bottom))]">
        <a href="{{ clear_url | escape }}" class="shrink-0 font-heading text-[14px] font-bold text-[#4a3530] underline underline-offset-4">{{ 'collections.clear_all' | t }}</a>
        <div class="flex-1">{{ show_results_button }}</div>
        <noscript>{{ drawer_submit }}</noscript>
      </div>
    </div>
  </dialog>
</s-dialog>

<script type="module" src="{{ 's-live-form.js' | asset_url }}"></script>
<script type="module" src="{{ 's-dialog.js' | asset_url }}"></script>
