{% doc %}
  Renders the specialized left-side mobile navigation drawer: a stacked-panel
  `<s-mobile-nav>` over the primary menu (up to three levels), the mobile
  localization accordion, and the drawer header with contextual back/title
  controls for nested panels. Loads `s-mobile-nav.js` at this call site.

  Open it from anywhere with `commandfor="mobile-nav-drawer" command="show-modal"`.
  The public `main-menu` block renders this snippet with its resolved menu so
  desktop and mobile navigation cannot diverge.

  @param {object} menu - Primary navigation link list resolved by the main-menu block.
  @param {string} close_button - Captured layout-owned close control targeting mobile-nav-drawer. @required
  @param {string} localization_submit - Captured layout-owned language submit control forwarded to localization-form. @required

  @category interactive
  @renders s-mobile-nav

  @example
  {%- capture close_attributes -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
  {%- capture mobile_close -%}
    {% block 'button', commandfor: 'mobile-nav-drawer', command: 'close', variant: 'button-ghost', class: 'ms-auto size-touch-target rounded hover:bg-transparent hover:opacity-70', attributes: close_attributes %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
  {%- endcapture -%}
  {% capture update_button %}{% block 'button', type: 'submit', variant: 'button-secondary' %}{{ 'localization.update_language' | t }}{% endblock %}{% endcapture %}
  {% render 'mobile-nav-drawer', menu: menu, close_button: mobile_close, localization_submit: update_button %}
{% enddoc %}

{%- capture mobile_nav_header -%}
  <div class="relative flex items-center shrink-0 px-4 py-1 min-h-[52px]">
    <button type="button" id="mobile-nav-back" commandfor="mobile-nav" command="--pop" class="hidden items-center gap-1 text-sm text-on-surface hover:opacity-70 motion-safe:transition motion-safe:active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm ps-1 pe-2 py-2" aria-label="{{ 'general.back' | t }}">
      <span class="inline-flex items-center justify-center shrink-0 size-4 rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
    </button>
    {%- comment -%} The root title still names the dialog for assistive technology, but only nested-panel titles are shown visually. {%- endcomment -%}
    <span class="hidden absolute left-1/2 -translate-x-1/2 text-sm font-medium text-on-surface pointer-events-none" id="mobile-nav-title" aria-live="polite">{{ 'header.mobile_navigation' | t }}</span>
    <span class="font-heading text-lg font-extrabold uppercase tracking-[0.14em] text-[#2e211d] [#mobile-nav-back.flex~&]:hidden" data-mobile-nav-brand>{{ shop.name | escape }}</span>
    {{ close_button }}
  </div>
{%- endcapture -%}

{%- capture mobile_nav_content -%}
  {%- comment -%} <s-mobile-nav> requires an ancestor <dialog> (for the contextual #mobile-nav-title / #mobile-nav-back header and the 'close' event). It reads [id$="-root"], [id^="mobile-nav-panel-"], [data-mobile-nav-push], and <details><summary><ul> for animated disclosures. Command: --pop. See assets/s-mobile-nav.js class JSDoc. {%- endcomment -%}
  {%- comment -%} Mobile nav lists reset global unclassed list defaults so disclosure rows measure and stack predictably. {%- endcomment -%}
  <s-mobile-nav id="mobile-nav" class="block relative h-full overflow-hidden">
    <div id="mobile-nav-panel-root" class="absolute inset-0 overflow-y-auto pb-6 motion-safe:transition-transform motion-safe:duration-280 motion-safe:ease-ui transform-[translateX(0)]">
      {%- liquid
        assign nav_all_url = routes.all_products_collection_url
        assign nav_domina_url = pages['domina-xl'].url | default: nav_all_url
        assign nav_faq_url = pages['faq'].url | default: routes.root_url
        assign nav_contact_url = pages['contact'].url | default: routes.root_url
        assign nav_about_url = pages['about'].url | default: routes.root_url
        assign nav_categories = 'bears|home.categories.bears|maker-bear.jpg^^bunnies|home.categories.bunnies|maker-bunny.jpg^^cats|home.categories.cats|maker-cat.jpg^^characters|home.categories.characters|maker-dinosaur.jpg^^pandas|mnav.pandas|ponyo-12.png^^penguins|home.categories.penguins|maker-penguin.jpg' | split: '^^'
      -%}

      {%- comment -%} Account card {%- endcomment -%}
      <div class="mb-5 rounded-[22px] bg-[#2e211d] p-4 text-white">
        {%- if customer -%}
          <p class="m-0 font-heading text-lg font-bold">{%- assign nav_greet = customer.first_name | default: customer.email | escape -%}{{ 'acct.hi' | t: name: nav_greet }}</p>
          <a href="{{ routes.account_url }}" class="mt-3 inline-flex h-10 items-center rounded-full bg-tangerine px-5 font-heading text-sm font-bold text-[#3f2418] no-underline">{{ 'acct.my_account' | t }}</a>
        {%- else -%}
          <p class="m-0 font-heading text-lg font-bold">{{ 'acct.welcome' | t }}</p>
          <p class="m-0 mt-1 text-[13px] leading-relaxed text-[#e8d6cd]">{{ 'acct.welcome_body' | t }}</p>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <a href="{{ routes.account_login_url }}" class="inline-flex h-10 items-center justify-center rounded-full bg-tangerine font-heading text-sm font-bold text-[#3f2418] no-underline">{{ 'acct.sign_in' | t }}</a>
            <a href="{{ routes.account_register_url | default: routes.account_login_url }}" class="inline-flex h-10 items-center justify-center rounded-full border border-white/40 font-heading text-sm font-bold text-white no-underline">{{ 'acct.create' | t }}</a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Main menu links (from the store's main menu) {%- endcomment -%}
      <p class="m-0 mb-1.5 px-1 text-[11px] font-bold uppercase tracking-wide text-on-surface-secondary">{{ 'mnav.shop' | t }}</p>
      <nav aria-label="{{ 'header.mobile_navigation' | t }}">
        <ul role="list" class="m-0 flex list-none flex-col gap-1 p-0">
          {% for link in menu.links %}
            <li class="m-0">
              {% if link.links.size > 0 %}
                {%- comment -%} aria-expanded is toggled by s-mobile-nav.js on push/pop so SR users hear open/closed state. No aria-haspopup — these sub-panels are link lists (disclosure pattern), not ARIA menus. {%- endcomment -%}
                <button type="button" aria-expanded="false" data-mobile-nav-push="mobile-nav-panel-{{ forloop.index }}-{{ link.handle | handleize }}" data-panel-title="{{ link.title | escape }}" class="flex w-full items-center justify-between rounded-[14px] px-3 py-3 text-[16px] font-semibold text-[#3f302b] hover:bg-[#f3ece7] motion-safe:transition motion-safe:active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent cursor-pointer">
                  <span>{{ link.title | escape }}</span>
                  <span class="inline-flex items-center justify-center shrink-0 size-4 text-on-surface-secondary rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                </button>
              {% else %}
                <a href="{{ link.url }}" class="flex items-center justify-between rounded-[14px] px-3 py-3 text-[16px] font-semibold no-underline text-[#3f302b] hover:bg-[#f3ece7] motion-safe:transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent {% if link.current %}bg-[#f3ece7]{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                  <span>{{ link.title | escape }}</span>
                  <span class="inline-flex items-center justify-center shrink-0 size-4 text-[#c9a596] rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

      {%- comment -%} Category tiles linked to real collections {%- endcomment -%}
      <p class="m-0 mb-2 mt-6 px-1 text-[11px] font-bold uppercase tracking-wide text-on-surface-secondary">{{ 'home.categories.label' | t }}</p>
      <ul role="list" class="m-0 grid list-none grid-cols-3 gap-2 p-0">
        {%- for entry in nav_categories -%}
          {%- assign c = entry | split: '|' -%}
          {%- assign c_url = collections[c[0]].url | default: nav_all_url -%}
          {%- assign c_image = images[c[2]] -%}
          <li>
            <a href="{{ c_url }}" class="flex flex-col items-center gap-1.5 rounded-[16px] bg-white p-2 pb-2.5 text-center no-underline shadow-[0_3px_0_#efe1d8] motion-safe:transition motion-safe:active:scale-[0.97]">
              <span class="block size-14 overflow-hidden rounded-full bg-[#fbf3ec]">
                {%- if c_image != blank -%}{{ c_image | image_url: width: 112 | image_tag: alt: '', class: 'size-full object-cover', loading: 'lazy', widths: '112,168' }}{%- endif -%}
              </span>
              <span class="text-[12.5px] font-bold text-[#3f302b]">{{ c[1] | t }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%} Domina XL promo {%- endcomment -%}
      <a href="{{ nav_domina_url }}" class="mt-5 flex items-center gap-3 overflow-hidden rounded-[20px] bg-[#f6c453] p-3 pe-4 no-underline">
        {%- assign promo_image = images['ponyo-3.png'] -%}
        <span class="block size-16 shrink-0 overflow-hidden rounded-[14px] bg-[#fff3d1]">
          {%- if promo_image != blank -%}{{ promo_image | image_url: width: 128 | image_tag: alt: '', class: 'size-full object-cover', loading: 'lazy', widths: '128,192' }}{%- endif -%}
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="font-heading text-[15px] font-bold leading-tight tracking-[0.02em] text-[#2e211d]">{{ 'mp.domina_badge' | t }}</span>
          <span class="mt-0.5 text-[12.5px] leading-snug text-[#5a4320]">{{ 'mnav.domina_body' | t }}</span>
        </span>
        <span class="ms-auto inline-flex size-4 shrink-0 text-[#2e211d] rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
      </a>

      {%- comment -%} Help links {%- endcomment -%}
      <p class="m-0 mb-1.5 mt-6 px-1 text-[11px] font-bold uppercase tracking-wide text-on-surface-secondary">{{ 'acct.help' | t }}</p>
      <ul role="list" class="m-0 grid list-none grid-cols-1 gap-0.5 p-0">
        <li><a href="{{ routes.all_products_collection_url }}?view=wishlist" class="flex items-center justify-between rounded-[12px] px-3 py-2.5 text-[14px] font-semibold text-[#5b463f] no-underline hover:bg-[#f3ece7]"><span>♡ {{ 'wishlist.title' | t }}</span><span class="rounded-full bg-[#e0566b] px-2 text-[11px] font-bold leading-5 text-white" data-wishlist-count hidden>0</span></a></li>
        <li><a href="{{ nav_faq_url }}" class="block rounded-[12px] px-3 py-2.5 text-[14px] font-semibold text-[#5b463f] no-underline hover:bg-[#f3ece7]">{{ 'acct.faq' | t }}</a></li>
        <li><a href="{{ nav_contact_url }}" class="block rounded-[12px] px-3 py-2.5 text-[14px] font-semibold text-[#5b463f] no-underline hover:bg-[#f3ece7]">{{ 'acct.contact' | t }}</a></li>
        <li><a href="{{ nav_about_url }}" class="block rounded-[12px] px-3 py-2.5 text-[14px] font-semibold text-[#5b463f] no-underline hover:bg-[#f3ece7]">{{ 'mnav.about' | t }}</a></li>
      </ul>

      {% render 'localization-form', show_country: true, id: 'mobile-nav-localization', class: 'block border-t border-border mt-5 pt-4', presentation: 'accordion', show_labels: true, submit_button: localization_submit %}
    </div>

    {% for link in menu.links %}
      {% if link.links.size > 0 %}
        <div id="mobile-nav-panel-{{ forloop.index }}-{{ link.handle | handleize }}" data-panel-title="{{ link.title | escape }}" class="absolute inset-0 overflow-y-auto motion-safe:transition-transform motion-safe:duration-280 motion-safe:ease-ui transform-[translateX(100%)] rtl:transform-[translateX(-100%)]">
          {%- liquid
            assign mnav_chips = true
            for sub in link.links
              if sub.links.size > 0
                assign mnav_chips = false
              endif
            endfor
          -%}
          {%- comment -%} Ponyo: a panel with only direct links shows marketplace-style tag chips with a collection photo, matching the desktop dropdown. {%- endcomment -%}
          <ul role="list" class="m-0 list-none p-0 {% if mnav_chips %}flex flex-wrap gap-2 pt-2{% else %}flex flex-col space-y-0{% endif %}">
            {% for sub in link.links %}
              <li class="m-0">
                {% if sub.links.size > 0 %}
                  {%- comment -%} Third-level mobile groups use push panels instead of details so disclosure content cannot overlap during height animation. {%- endcomment -%}
                  <button type="button" aria-expanded="false" data-mobile-nav-push="mobile-nav-panel-{{ forloop.parentloop.index }}-{{ link.handle | handleize }}-{{ sub.handle | handleize }}" data-panel-title="{{ sub.title | escape }}" class="flex w-full items-center justify-between py-3 text-base font-normal text-on-surface hover:opacity-70 motion-safe:transition motion-safe:active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm cursor-pointer">
                    <span>{{ sub.title | escape }}</span>
                    <span class="inline-flex items-center justify-center shrink-0 size-4 text-on-surface-secondary rtl:-scale-x-100" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
                  </button>
                {% elsif mnav_chips %}
                  {%- liquid
                    assign chip_image = blank
                    if sub.type == 'collection_link' and sub.object != blank
                      assign chip_image = sub.object.featured_image
                      if chip_image == blank
                        assign chip_image = sub.object.products.first.featured_image
                      endif
                    endif
                  -%}
                  <a href="{{ sub.url }}" class="inline-flex items-center gap-2 rounded-full border border-[#ecdcd0] bg-white py-1.5 ps-1.5 pe-4 text-[14px] font-semibold text-[#4a3530] no-underline motion-safe:transition motion-safe:active:scale-[0.97] hover:bg-[#f8e4df] aria-[current=page]:border-[#e6bfb5] aria-[current=page]:bg-[#f8e4df] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"{% if sub.current %} aria-current="page"{% endif %}>
                    <span class="inline-flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#f3e6dc] font-heading text-[13px] text-[#8a6a5e] [&_img]:size-full [&_img]:object-cover" aria-hidden="true">
                      {%- if chip_image != blank -%}
                        {{ chip_image | image_url: width: 80, height: 80, crop: 'center' | image_tag: alt: '', loading: 'lazy', width: 36, height: 36 }}
                      {%- else -%}
                        {{ sub.title | slice: 0 }}
                      {%- endif -%}
                    </span>
                    {{ sub.title | escape }}
                  </a>
                {% else %}
                  <a href="{{ sub.url }}" class="flex items-center py-3 text-base font-normal no-underline text-on-surface hover:opacity-70 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"{% if sub.current %} aria-current="page"{% endif %}>
                    {{ sub.title | escape }}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>

        {% for sub in link.links %}
          {% if sub.links.size > 0 %}
            <div id="mobile-nav-panel-{{ forloop.parentloop.index }}-{{ link.handle | handleize }}-{{ sub.handle | handleize }}" data-panel-title="{{ sub.title | escape }}" class="absolute inset-0 overflow-y-auto motion-safe:transition-transform motion-safe:duration-280 motion-safe:ease-ui transform-[translateX(100%)] rtl:transform-[translateX(-100%)]">
              <ul role="list" class="m-0 flex list-none flex-col space-y-0 p-0">
                {% for subsub in sub.links %}
                  <li class="m-0">
                    <a href="{{ subsub.url }}" class="flex items-center py-3 text-base font-normal no-underline text-on-surface hover:opacity-70 motion-safe:transition-opacity focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded-sm"{% if subsub.current %} aria-current="page"{% endif %}>
                      {{ subsub.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </div>

          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
  </s-mobile-nav>
{%- endcapture -%}

{% render 'drawer',
  id: 'mobile-nav-drawer',
  position: 'left',
  header: mobile_nav_header,
  content: mobile_nav_content,
  close_on_navigate: true,
  attributes: 'aria-labelledby="mobile-nav-title"'
%}
<script type="module" src="{{ 's-mobile-nav.js' | asset_url }}"></script>
