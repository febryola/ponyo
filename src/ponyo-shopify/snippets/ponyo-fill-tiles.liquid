{% doc %}
  Fills the empty slots at the end of a product grid with Ponyo promo tiles, so
  a short row never leaves blank space. Each tile shows only at the breakpoints
  where its slot would otherwise be empty. Render inside the grid's <ul>.

  @param {number} count - Number of products already in the grid. @required
  @param {number} [cols_sm] - Columns on phones (default 2).
  @param {number} [cols_md] - Columns from md (default 4).
  @param {number} [cols_lg] - Columns from lg (default 6).
  @param {number} [cols_xl] - Columns from xl (optional; defaults to cols_lg).
  @param {number} [offset] - Rotate which promo tiles show first (default 0).

  @example
  {% render 'ponyo-fill-tiles', count: 3, cols_sm: 2, cols_md: 4, cols_lg: 6 %}
{% enddoc %}
{%- liquid
  assign f_sm = cols_sm | default: 2
  assign f_md = cols_md | default: 4
  assign f_lg = cols_lg | default: 6
  assign f_xl = cols_xl | default: f_lg
  assign f_off = offset | default: 0
  assign r_xl = count | modulo: f_xl
  assign need_xl = 0
  if r_xl > 0
    assign need_xl = f_xl | minus: r_xl
  endif
  assign r_sm = count | modulo: f_sm
  assign need_sm = 0
  if r_sm > 0
    assign need_sm = f_sm | minus: r_sm
  endif
  assign r_md = count | modulo: f_md
  assign need_md = 0
  if r_md > 0
    assign need_md = f_md | minus: r_md
  endif
  assign r_lg = count | modulo: f_lg
  assign need_lg = 0
  if r_lg > 0
    assign need_lg = f_lg | minus: r_lg
  endif
  assign need_max = need_sm
  if need_md > need_max
    assign need_max = need_md
  endif
  if need_lg > need_max
    assign need_max = need_lg
  endif
  if need_xl > need_max
    assign need_max = need_xl
  endif
  assign promo_list = 'request|bg-[#fde4e8] text-[#5c2330]^^drops|bg-[#dbe9f5] text-[#22384b]^^domina|bg-[#f6c453] text-[#2e211d]^^all|bg-[#e6efdf] text-[#2f4a2a]^^rare|bg-[#2e211d] text-[#f6c453]' | split: '^^'
  assign f_domina = pages['domina-xl'].url | default: routes.all_products_collection_url
  assign f_rare = collections['rare-finds'].url | default: routes.all_products_collection_url
  assign f_contact = pages['contact'].url | default: routes.root_url
-%}
{%- comment -%} Visibility classes used below, listed whole so the compiler keeps them: hidden block md:block md:hidden lg:block lg:hidden xl:block xl:hidden {%- endcomment -%}
{%- if need_max > 0 -%}
  {%- for i in (1..need_max) -%}
    {%- liquid
      assign vis = 'hidden'
      if i <= need_sm
        assign vis = 'block'
      endif
      if i <= need_md
        assign vis = vis | append: ' md:block'
      else
        assign vis = vis | append: ' md:hidden'
      endif
      if i <= need_lg
        assign vis = vis | append: ' lg:block'
      else
        assign vis = vis | append: ' lg:hidden'
      endif
      if i <= need_xl
        assign vis = vis | append: ' xl:block'
      else
        assign vis = vis | append: ' xl:hidden'
      endif
      assign p_index = i | minus: 1 | plus: f_off | modulo: promo_list.size
      assign p = promo_list[p_index] | split: '|'
      case p[0]
        when 'request'
          assign p_url = f_contact
        when 'drops'
          assign p_url = routes.root_url | append: '#drops'
        when 'domina'
          assign p_url = f_domina
        when 'rare'
          assign p_url = f_rare
        else
          assign p_url = routes.all_products_collection_url
      endcase
      assign p_title = 'fill.' | append: p[0] | append: '_title'
      assign p_body = 'fill.' | append: p[0] | append: '_body'
      assign p_cta = 'fill.' | append: p[0] | append: '_cta'
    -%}
    <li class="{{ vis }}">
      <a href="{{ p_url }}" class="group/fill relative flex h-full min-h-[220px] flex-col justify-between overflow-hidden p-4 no-underline {{ p[1] }}">
        <svg viewBox="0 0 64 64" class="absolute -end-3 -bottom-3 size-24 opacity-15 motion-safe:transition-transform motion-safe:duration-500 group-hover/fill:-translate-y-1" aria-hidden="true"><path d="M12 28C12 15 20 6 32 6C44 6 52 15 52 28C52 33 48 36 44 36H20C16 36 12 33 12 28Z" fill="currentColor"/><path d="M19 38c0 4 -2 6 -2 10M27 38c0 5 2 7 0 12M35 38c0 5 -1 7 1 12M43 38c0 4 2 6 1 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none"/></svg>
        <span class="relative flex flex-col gap-1.5">
          <span class="text-[10.5px] font-bold uppercase tracking-[0.12em] opacity-70">Ponyo</span>
          <span class="font-heading text-[19px] font-bold leading-tight">{{ p_title | t }}</span>
          <span class="text-[12.5px] leading-snug opacity-80">{{ p_body | t }}</span>
        </span>
        <span class="relative mt-3 inline-flex items-center gap-1 text-[13px] font-bold">{{ p_cta | t }} <span aria-hidden="true" class="motion-safe:transition-transform group-hover/fill:translate-x-1">→</span></span>
      </a>
    </li>
  {%- endfor -%}
{%- endif -%}
