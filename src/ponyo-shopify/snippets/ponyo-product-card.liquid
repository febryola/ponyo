{% doc %}
  Ponyo product card used on the homepage shelves: square photo with a second
  photo on hover, wishlist heart, real badges (rare, premium, XL, sold out,
  sale), size tier, real star rating when reviews exist, and price.

  @param {object} product - The product to show. @required
  @param {string} [sizes] - Image sizes attribute.
  @param {string} [tone] - 'light' (default) or 'dark' for dark panels.
  @param {boolean} [eager] - Load the main photo eagerly.

  @example
  {% render 'ponyo-product-card', product: product, sizes: '(min-width: 1024px) 280px, 45vw' %}
{% enddoc %}
{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign card_tier = product.metafields.ponyo.size_tier.value
  assign card_off = 0
  if card_variant.compare_at_price > card_variant.price
    assign card_off = card_variant.compare_at_price | minus: card_variant.price | times: 100 | divided_by: card_variant.compare_at_price
  endif
  assign card_sizes = sizes | default: '(min-width: 1024px) 280px, 45vw'
  if tone == 'dark'
    assign shell_class = 'bg-[#3a2b26] border-white/10 hover:border-white/25'
    assign title_class = 'text-white'
    assign meta_class = 'text-[#f6c453]'
    assign price_class = 'text-white'
  else
    assign shell_class = 'bg-white border-[#e8ded8] hover:border-[#c9b2a6] hover:shadow-[0_4px_14px_rgba(46,33,29,.12)]'
    assign title_class = 'text-[#3f302b]'
    assign meta_class = 'text-accent'
    assign price_class = 'text-[#3f302b]'
  endif
  if eager
    assign card_loading = 'eager'
  else
    assign card_loading = 'lazy'
  endif
-%}
{%- liquid
  assign urg_now = 'now' | date: '%s' | plus: 0
  assign urg_pub = product.published_at | date: '%s' | plus: 0
  assign urg_age = urg_now | minus: urg_pub | divided_by: 86400
  assign urg_new = false
  if product.tags contains 'new-arrival' or urg_age < 30
    assign urg_new = true
  endif
  assign urg_left = 0
  if card_variant.inventory_management == 'shopify' and card_variant.inventory_policy == 'deny' and card_variant.inventory_quantity > 0 and card_variant.inventory_quantity <= 5
    assign urg_left = card_variant.inventory_quantity
  endif
  assign urg_limited = false
  if product.metafields.ponyo.availability_status.value == 'Limited'
    assign urg_limited = true
  endif
-%}
<div class="group/card relative flex h-full flex-col rounded-none border motion-safe:transition motion-safe:duration-200 {{ shell_class }}">
  <a href="{{ product.url | escape }}" class="relative mb-2 block aspect-square overflow-hidden rounded-none bg-[#fbf3ec]" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      {{ product.featured_image | image_url: width: 700 | image_tag: alt: '', loading: card_loading, widths: '300,450,600,700', sizes: card_sizes, class: 'size-full object-cover object-[center_30%] motion-safe:transition-transform motion-safe:duration-700 group-hover/card:scale-[1.04]' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'size-full' }}
    {%- endif -%}
    {% render 'card-hover-image', product: product, sizes: card_sizes %}
  </a>
  <span class="pointer-events-none absolute start-1.5 top-1.5 z-[2] flex flex-wrap gap-1">
    {%- unless product.available -%}<span class="rounded-none bg-[#4a3530] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-white">{{ 'mp.sold_out' | t }}</span>{%- endunless -%}
    {%- if card_off > 0 -%}<span class="rounded-none bg-tangerine px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#3f2418]">{{ 'mp.save_percent' | t: percent: card_off }}</span>{%- endif -%}
    {%- if product.tags contains 'rare' or product.tags contains 'Rare' -%}<span class="rounded-none bg-[#2e211d] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#f6c453]">✦ {{ 'mp.badge_rare' | t }}</span>{%- endif -%}
    {%- if product.tags contains 'premium' or product.tags contains 'Premium' -%}<span class="rounded-none bg-white px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#2e211d] shadow-sm">{{ 'mp.badge_premium' | t }}</span>{%- endif -%}
    {%- if urg_new -%}<span class="rounded-none bg-[#dbe9f5] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#2c4256]">{{ 'explore.badge_new' | t }}</span>{%- endif -%}
    {%- if urg_limited -%}<span class="rounded-none bg-[#fde3cf] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#7a3d14]">{{ 'marketplace.status_limited' | t }}</span>{%- endif -%}
    {%- if card_tier == 'XL' -%}<span class="rounded-none bg-[#f6c453] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-[#2e211d]">XL</span>{%- endif -%}
  </span>
  {% render 'wishlist-button', product: product, class: 'absolute end-1.5 top-1.5 z-[2]' %}
  <div class="flex flex-1 flex-col gap-0.5 px-2 pb-2.5 md:px-2.5">
    <h3 class="m-0 line-clamp-2 font-body text-[13.5px] font-medium leading-snug {{ title_class }}"><a href="{{ product.url | escape }}" class="text-inherit no-underline after:absolute after:inset-0 after:z-[1] after:content-['']">{{ product.title | escape }}</a></h3>
    {%- if card_tier != blank -%}
      <p class="m-0 text-[12px] font-bold {{ meta_class }}">{{ card_tier | escape }}{% if product.metafields.ponyo.dimensions != blank %} · {{ product.metafields.ponyo.dimensions.value | escape }}{% endif %}</p>
    {%- elsif product.type != blank -%}
      <p class="m-0 text-[12px] font-bold {{ meta_class }}">{{ product.type | escape }}</p>
    {%- endif -%}
    {% render 'rating-stars', product: product %}
    {%- if urg_left > 0 -%}<p class="m-0 text-[12px] font-bold text-[#c2410c]">🔥 {{ 'explore.only_left' | t: count: urg_left }}</p>{%- endif -%}
    <p class="m-0 mt-auto flex items-baseline gap-2 pt-1 font-heading text-[17px] font-bold {{ price_class }}">
      {%- if product.price_varies -%}{%- assign card_from = product.price_min | money_without_trailing_zeros -%}{{ 'wishlist.from' | t: price: card_from }}{%- else -%}{{ card_variant.price | money_without_trailing_zeros }}{%- endif -%}
      {%- if card_variant.compare_at_price > card_variant.price -%}<s class="font-body text-[13px] font-normal opacity-60">{{ card_variant.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
    </p>
  </div>
</div>
