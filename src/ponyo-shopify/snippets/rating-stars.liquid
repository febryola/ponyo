{% doc %}
  Star rating from the standard product review metafields (reviews.rating and
  reviews.rating_count) that review apps fill in. Renders nothing until a
  product has real reviews, so no rating is ever shown without data.

  @param {object} product - The product whose rating to show. @required
  @param {string} [size] - 'sm' (cards) or 'md' (product page). Defaults to 'sm'.

  @example
  {% render 'rating-stars', product: product %}
{% enddoc %}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank and rating_count > 0 -%}
  {%- liquid
    assign scale_max = rating.scale_max | default: 5
    assign rating_value = rating.rating | times: 1.0
    assign percent = rating_value | divided_by: scale_max | times: 100
    if size == 'md'
      assign star_class = 'h-[18px]'
      assign text_class = 'text-[14px]'
    else
      assign star_class = 'h-[13px]'
      assign text_class = 'text-[12px]'
    endif
  -%}
  <span class="inline-flex items-center gap-1.5" role="img" aria-label="{{ 'wishlist.rating_label' | t: rating: rating_value, max: scale_max, count: rating_count }}">
    <span class="relative inline-block {{ star_class }} aspect-[5/1]" aria-hidden="true">
      <svg viewBox="0 0 100 20" class="absolute inset-0 size-full text-[#e9d3c8]"><g fill="currentColor">{%- for i in (0..4) -%}<path transform="translate({{ i | times: 20 }} 0)" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.8Z"/>{%- endfor -%}</g></svg>
      <span class="absolute inset-y-0 start-0 overflow-hidden" style="width: {{ percent | round: 1 }}%"><svg viewBox="0 0 100 20" class="{{ star_class }} aspect-[5/1] text-[#f2a93b]"><g fill="currentColor">{%- for i in (0..4) -%}<path transform="translate({{ i | times: 20 }} 0)" d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9L10 14.9 4.8 17.7l1-5.9L1.5 7.7l5.9-.8Z"/>{%- endfor -%}</g></svg></span>
    </span>
    <span class="{{ text_class }} font-semibold text-on-surface-secondary">{{ rating_value | round: 1 }} ({{ rating_count }})</span>
  </span>
{%- endif -%}
