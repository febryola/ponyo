{% doc %}
  "Recently viewed" strip filled in the browser from the plush this shopper
  opened before (assets/ponyo-wishlist.js). Stays hidden until there is at least
  one product to show.

  @param {string} [exclude] - Product handle to leave out (the current product).

  @example
  {% render 'recently-viewed', exclude: product.handle %}
{% enddoc %}
<section class="w-full max-w-page mx-auto px-margin py-8 md:py-10" aria-labelledby="recently-viewed-title" data-recently-viewed data-exclude="{{ exclude | escape }}" data-currency="{{ cart.currency.iso_code }}" hidden>
  <div class="mb-5 flex items-end justify-between gap-3">
    <h2 id="recently-viewed-title" class="m-0 font-heading text-[24px] font-extrabold leading-tight tracking-tight text-[#4a3530] md:text-[32px]">{{ 'explore.recent_title' | t }}</h2>
    <a href="{{ routes.all_products_collection_url }}?view=wishlist" class="rounded-full border-2 border-[#e9d3c8] bg-white px-4 py-2 font-heading text-[13.5px] font-bold text-[#4a3530] no-underline hover:bg-[#f3ece7]">♡ {{ 'wishlist.title' | t }}</a>
  </div>
  <ul role="list" class="-mx-1 flex snap-x gap-2 overflow-x-auto px-1 pb-3 [scrollbar-width:none] md:gap-2.5 [&::-webkit-scrollbar]:hidden" data-recently-viewed-list></ul>
  <template data-recently-viewed-card>
    <li class="w-[150px] shrink-0 snap-start md:w-[190px]">
      <div class="group/card relative flex h-full flex-col rounded-none border border-[#e8ded8] bg-white pb-2.5 motion-safe:transition motion-safe:duration-200 hover:border-[#c9b2a6] hover:shadow-[0_4px_14px_rgba(46,33,29,.12)]">
        <span class="relative mb-2 block aspect-square overflow-hidden rounded-none bg-[#fbf3ec]"><img data-image class="size-full object-cover object-[center_30%]" loading="lazy" alt=""></span>
        <button type="button" class="absolute end-1.5 top-1.5 z-[2] inline-flex size-8 items-center justify-center rounded-full bg-white/90 text-[#4a3530] shadow-[0_2px_10px_rgba(46,33,29,.12)] aria-pressed:text-[#e0566b]" data-wishlist-toggle="" aria-pressed="false" aria-label="{{ 'wishlist.save' | t }}">
          <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.5 1.1 5 2.9 1.5-1.8 3-2.9 5-2.9 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" fill="currentColor" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
        <h3 class="m-0 line-clamp-2 px-2 font-body text-[13px] font-medium leading-snug text-[#3f302b]"><a data-link data-title class="text-inherit no-underline after:absolute after:inset-0 after:z-[1] after:content-['']"></a></h3>
        <p class="m-0 mt-auto px-2 pt-1 font-heading text-[15px] font-bold text-[#3f302b]" data-price></p>
      </div>
    </li>
  </template>
</section>
