<script type="application/ld+json">{{ article | structured_data }}</script>

{%- liquid
  assign tags_down = article.tags | join: ',' | downcase
  if tags_down contains 'domina'
    assign art_tone = 'from-[#fbe7b0] to-[#f6c453]'
    assign art_fallback = images['ponyo-3.png']
    assign art_shop = collections['domina-xl']
    assign art_emoji = '🧸'
  elsif tags_down contains 'premium'
    assign art_tone = 'from-[#fdf0f2] to-[#fde4e8]'
    assign art_fallback = images['ponyo-5.png']
    assign art_shop = collections['premium']
    assign art_emoji = '✨'
  elsif tags_down contains 'care'
    assign art_tone = 'from-[#eef5fb] to-[#dbe9f5]'
    assign art_fallback = images['ponyo-6.png']
    assign art_shop = collections['new-arrivals']
    assign art_emoji = '🫧'
  else
    assign art_tone = 'from-[#fbf3ec] to-[#f3e4da]'
    assign art_fallback = images['ponyo-2.png']
    assign art_shop = collections['new-arrivals']
    assign art_emoji = '✦'
  endif
  if art_shop == blank or art_shop.products_count == 0
    assign art_shop = collections.all
  endif
  assign art_words = article.content | strip_html | split: ' ' | size
  assign art_minutes = art_words | divided_by: 200 | at_least: 1
  assign article_date = article.published_at | date: format: 'date'
  assign article_datetime = article.published_at | date: '%Y-%m-%d'
  assign escaped_author = article.author | escape
-%}
{% style %}
  @keyframes ponyo-bob { 0%, 100% { transform: translateY(0) rotate(-6deg); } 50% { transform: translateY(-12px) rotate(6deg); } }
  @keyframes ponyo-twinkle { 0%, 100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1.15); } }
  .ponyo-prose { counter-reset: ponyo-step; font-size: 17px; line-height: 1.8; color: #5b463f; }
  .ponyo-prose p { margin: 0 0 1.15em; }
  .ponyo-prose h2 { counter-increment: ponyo-step; position: relative; margin: 2.2em 0 .7em; padding-inline-start: 56px; font-family: var(--font-heading, inherit); font-size: clamp(22px, 3vw, 28px); font-weight: 800; line-height: 1.2; color: #4a3530; }
  .ponyo-prose h2::before { content: counter(ponyo-step); position: absolute; inset-inline-start: 0; top: 50%; transform: translateY(-50%) rotate(-6deg); display: grid; place-items: center; width: 42px; height: 42px; border-radius: 14px; background: #ee8a4c; color: #3f2418; font-size: 19px; box-shadow: 0 4px 0 #7f4a38; }
  .ponyo-prose ul { list-style: none; margin: 0 0 1.4em; padding: 0; display: grid; gap: 10px; }
  .ponyo-prose li { position: relative; padding: 14px 18px 14px 48px; border-radius: 18px; background: #fff; border: 2px solid #efe1d8; }
  .ponyo-prose li::before { content: '✦'; position: absolute; inset-inline-start: 18px; top: 14px; color: #f2a93b; }
  .ponyo-prose strong { color: #4a3530; }
  .ponyo-prose em { font-style: normal; display: inline-block; padding: 1px 10px; border-radius: 999px; background: #dbe9f5; color: #22384b; font-weight: 700; }
  .ponyo-prose a { color: #c2410c; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .ponyo-prose a:hover { color: #4a3530; }
  .ponyo-prose > *:first-child > p:first-child::first-letter, .ponyo-prose > p:first-child::first-letter { float: left; margin: 6px 10px 0 0; font-family: var(--font-heading, inherit); font-size: 3.4em; line-height: .8; font-weight: 800; color: #ee8a4c; }
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity .6s ease, transform .6s cubic-bezier(.2,.8,.2,1); }
    [data-reveal].is-visible { opacity: 1; transform: none; }
    .ponyo-bob { animation: ponyo-bob 4s ease-in-out infinite; }
    .ponyo-twinkle { animation: ponyo-twinkle 2.6s ease-in-out infinite; }
  }
{% endstyle %}

{%- comment -%} Reading progress bar {%- endcomment -%}
<div class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1.5 bg-transparent" aria-hidden="true"><div class="h-full origin-left scale-x-0 bg-linear-to-r from-[#f6c453] via-[#ee8a4c] to-[#e0566b]" data-read-progress></div></div>

{%- comment -%} Article hero: tinted banner, title, meta chips and a big photo with floating decorations. {%- endcomment -%}
<div class="w-full px-margin pt-4 md:px-6 md:pt-6">
  <div class="relative isolate mx-auto grid w-full max-w-[1400px] items-center gap-6 overflow-hidden rounded-[28px] bg-linear-to-br {{ art_tone }} p-6 md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] md:gap-10 md:p-12">
    <span class="ponyo-twinkle pointer-events-none absolute start-[46%] top-8 -z-10 text-[28px] text-white" aria-hidden="true">✦</span>
    <span class="ponyo-twinkle pointer-events-none absolute bottom-10 start-8 -z-10 text-[20px] text-white [animation-delay:1s]" aria-hidden="true">✦</span>
    <div class="flex flex-col items-start gap-4">
      <nav aria-label="{{ 'mp.breadcrumb' | t | escape }}" class="text-[13px] font-semibold text-[#6b5048]">
        <a href="{{ routes.root_url }}" class="text-inherit no-underline hover:underline">{{ 'mp.home' | t }}</a>
        <span aria-hidden="true"> › </span>
        <a href="{{ blog.url }}" class="text-inherit no-underline hover:underline">{{ 'home.footer.journal' | t }}</a>
      </nav>
      {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold leading-[1.05] tracking-tight text-balance text-[#3a2b26] text-[34px]! md:text-[54px]!' %}{{ article.title | escape }}{% endblock %}
      {%- if article.excerpt != blank -%}<div class="max-w-[520px] text-[16px] leading-relaxed text-[#5b463f] md:text-[18px]">{{ article.excerpt | strip_html | truncatewords: 40 }}</div>{%- endif -%}
      <div class="flex flex-wrap items-center gap-2 text-[13px] font-bold">
        <span class="rounded-full bg-white/80 px-3.5 py-1.5 text-[#4a3530]">⏱ {{ 'journal.read_time' | t: minutes: art_minutes }}</span>
        <span class="rounded-full bg-white/80 px-3.5 py-1.5 text-[#4a3530]"><time datetime="{{ article_datetime }}">{{ article_date }}</time></span>
        {%- for tag in article.tags limit: 3 -%}<a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="rounded-full bg-[#3a2b26] px-3.5 py-1.5 text-white no-underline hover:bg-[#4a3530]">#{{ tag | escape }}</a>{%- endfor -%}
      </div>
    </div>
    <div class="relative">
      <div class="aspect-[4/3] overflow-hidden rounded-[24px] bg-white/50 shadow-[0_20px_44px_rgba(46,33,29,.18)] [&_img]:size-full [&_img]:object-cover">
        {%- if article.image -%}
          {%- assign article_image_alt = article.image.alt | default: article.title -%}
          {%- comment -%} The sizes value mirrors the article LCP preload in layout/theme.liquid. {%- endcomment -%}
          {% block 'image', image: article.image, sizes: '(min-width: 768px) 42em, 100vw', attributes: 'loading="eager" fetchpriority="high"', alt: article_image_alt, class: 'aspect-[4/3]' %}{% endblock %}
        {%- else -%}
          {{ art_fallback | image_url: width: 1200 | image_tag: alt: '', loading: 'eager', fetchpriority: 'high', widths: '500,800,1200', sizes: '(min-width: 768px) 45vw, 100vw', class: 'size-full object-cover' }}
        {%- endif -%}
      </div>
      <span class="ponyo-bob absolute -end-2 -top-5 grid size-16 place-items-center rounded-full bg-white text-[30px] shadow-[0_10px_24px_rgba(46,33,29,.18)] md:-end-5 md:size-20 md:text-[38px]" aria-hidden="true">{{ art_emoji }}</span>
    </div>
  </div>
</div>

{% block 'container', class: 'w-full max-w-page mx-auto px-margin' %}
  <article class="mx-auto max-w-[720px] py-10 md:py-14" data-article>
    {%- if article.content != blank -%}
      <div class="ponyo-prose" data-article-body>
        {%- comment -%} The schema-backed setting keeps the article body connected as one richtext presentation block. {%- endcomment -%}
        {% block 'richtext', text: article.content %}{% endblock %}
      </div>
    {%- endif -%}

    {%- comment -%} Shop the story: plush related to this article, moved into the middle of the story by script. {%- endcomment -%}
    <aside class="my-10 rounded-[26px] bg-linear-to-br from-[#2e211d] to-[#4a3530] p-5 text-white md:p-7" data-shop-story aria-labelledby="shop-story-title">
      <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="m-0 text-[12px] font-extrabold uppercase tracking-[0.12em] text-[#f6c453]">✦ {{ 'journal.shop_kicker' | t }}</p>
          <h2 id="shop-story-title" class="m-0 font-heading text-[22px] font-extrabold md:text-[26px]">{{ art_shop.title | escape }}</h2>
        </div>
        <a href="{{ art_shop.url }}" class="rounded-full border-2 border-white/25 px-4 py-2 font-heading text-[13.5px] font-bold text-white no-underline hover:bg-white/10">{{ 'home.v2.see_all' | t }} →</a>
      </div>
      <ul role="list" class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {%- for product in art_shop.products limit: 3 -%}
          <li class="{% if forloop.index == 3 %}hidden sm:block{% endif %}">{% render 'ponyo-product-card', product: product, tone: 'dark', sizes: '(min-width: 768px) 220px, 45vw' %}</li>
        {%- endfor -%}
      </ul>
    </aside>

    {%- comment -%}Comments section{%- endcomment -%}
    {% if blog.comments_enabled? %}
      <hr class="my-12 border-border">
      <section class="mt-8">
        {% block 'heading', tag: 'h2', variant: 'xl', class: 'mb-8' %}{{ 'blog.comments_count' | t: count: article.comments_count }}{% endblock %}

        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div class="py-6{% unless forloop.last %} border-b border-border{% endunless %}">
              <div class="flex items-center gap-2 mb-2">
                {% block 'text', variant: 'md', class: 'font-medium text-on-surface' %}{{ comment.author | escape }}{% endblock %}
                <span class="text-on-surface-secondary" aria-hidden="true">&middot;</span>
                <time datetime="{{ comment.created_at | date: '%Y-%m-%dT%H:%M:%S%z' }}" class="text-sm text-on-surface-secondary">
                  {{ comment.created_at | date: format: 'date' }}
                </time>
              </div>
              <div class="text-on-surface">{{ comment.content | escape | newline_to_br }}</div>
            </div>
          {% endfor %}

          {% block 'pagination', paginate: paginate %}{% endblock %}
        {% endpaginate %}

        {% form 'new_comment', article %}
          {%- if form.errors -%}
            <div role="alert" class="flex items-start gap-3 p-4 rounded-lg border-s-4 border-s-critical bg-critical/10 text-on-surface mb-4">
              <div class="flex-1">
                <p class="font-body text-base leading-relaxed text-pretty font-medium mb-1">{{ 'forms.form_errors_title' | t }}</p>
                <ul class="text-sm list-disc ps-4">
                  {% for field in form.errors %}
                    <li>{{ form.errors.translated_fields[field] | escape }} {{ form.errors.messages[field] | escape }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>

            {%- for field in form.errors -%}
              {%- capture field_error_message -%}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{%- endcapture -%}
              {%- case field -%}
                {%- when 'author' -%}
                  {%- assign comment_name_error = field_error_message -%}
                {%- when 'email' -%}
                  {%- assign comment_email_error = field_error_message -%}
                {%- when 'body' -%}
                  {%- assign comment_body_error = field_error_message -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- endif -%}

          <div class="flex flex-col gap-4 mt-8 max-w-md">
            {% block 'text', tag: 'h3', variant: 'lg' %}{{ 'blog.comment_form_title' | t }}{% endblock %}

            {%- assign comment_name_label = 'blog.comment_form_name' | t -%}
            {%- assign comment_email_label = 'blog.comment_form_email' | t -%}
            {%- assign comment_body_label = 'blog.comment_form_body' | t -%}

            {%- comment -%} Comment form repopulation with form.author and form.email {%- endcomment -%}
            <div class="space-y-1.5">
              <label for="comment-name" class="block text-sm font-medium text-on-surface">
                {{- comment_name_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <input
                type="text"
                name="comment[author]"
                id="comment-name"
                class="w-full"
                {%- if form.author != blank %} value="{{ form.author | escape }}"{% endif %}
                autocomplete="name"
                required
                aria-required="true"
                {%- if comment_name_error != blank %} aria-invalid="true" aria-describedby="comment-name-error"{% endif %}
              >
              {%- if comment_name_error != blank -%}
                <p id="comment-name-error" class="text-sm text-critical" role="alert">{{ comment_name_error | escape }}</p>
              {%- endif -%}
            </div>
            <div class="space-y-1.5">
              <label for="comment-email" class="block text-sm font-medium text-on-surface">
                {{- comment_email_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <input
                type="email"
                name="comment[email]"
                id="comment-email"
                class="w-full"
                {%- if form.email != blank %} value="{{ form.email | escape }}"{% endif %}
                autocomplete="email"
                required
                aria-required="true"
                {%- if comment_email_error != blank %} aria-invalid="true" aria-describedby="comment-email-error"{% endif %}
              >
              {%- if comment_email_error != blank -%}
                <p id="comment-email-error" class="text-sm text-critical" role="alert">{{ comment_email_error | escape }}</p>
              {%- endif -%}
            </div>
            <div class="space-y-1.5">
              <label for="comment-body" class="block text-sm font-medium text-on-surface">
                {{- comment_body_label | escape -}}
                <span class="text-critical ms-0.5" aria-hidden="true">*</span><span class="sr-only"> ({{ 'forms.required' | t }})</span>
              </label>
              <textarea
                name="comment[body]"
                id="comment-body"
                rows="4"
                class="w-full"
                required
                aria-required="true"
                {%- if comment_body_error != blank %} aria-invalid="true" aria-describedby="comment-body-error"{% endif %}
              >
                {%- if form.body != blank %}{{ form.body | escape }}{% endif -%}
              </textarea>
              {%- if comment_body_error != blank -%}
                <p id="comment-body-error" class="text-sm text-critical" role="alert">{{ comment_body_error | escape }}</p>
              {%- endif -%}
            </div>

            {% block 'button', type: 'submit' %}{{- 'blog.comment_form_submit' | t -}}{% endblock %}
          </div>
        {% endform %}
      </section>
    {% endif %}
  </article>
{% endblock %}

{%- comment -%} Keep reading: other journal stories with photos. {%- endcomment -%}
{%- assign other_count = 0 -%}
{%- for other in blog.articles -%}{%- unless other.id == article.id -%}{%- assign other_count = other_count | plus: 1 -%}{%- endunless -%}{%- endfor -%}
{%- if other_count > 0 -%}
<section class="w-full max-w-page mx-auto px-margin py-8 md:py-10" aria-labelledby="keep-reading-title">
  <h2 id="keep-reading-title" class="mb-5 font-heading text-[24px] font-extrabold tracking-tight text-[#4a3530] md:text-[32px]">{{ 'journal.keep_reading' | t }}</h2>
  <ul role="list" class="grid gap-4 md:grid-cols-3 md:gap-6">
    {%- assign fallback_list = 'ponyo-3.png,ponyo-5.png,ponyo-6.png,ponyo-2.png' | split: ',' -%}
    {%- for other in blog.articles limit: 4 -%}
      {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
      {%- assign fb_index = forloop.index0 | modulo: 4 -%}
      {%- assign other_img = other.image | default: images[fallback_list[fb_index]] -%}
      <li data-reveal>
        <a href="{{ other.url }}" class="group/story flex h-full flex-col overflow-hidden rounded-[22px] border-2 border-[#efe1d8] bg-white text-[#4a3530] no-underline motion-safe:transition motion-safe:hover:-translate-y-1 hover:shadow-[0_14px_30px_rgba(110,74,62,.14)]">
          <span class="block aspect-[16/10] overflow-hidden bg-[#fbf3ec]">{%- if other_img != blank -%}{{ other_img | image_url: width: 700 | image_tag: alt: '', loading: 'lazy', widths: '400,700', sizes: '(min-width: 768px) 33vw, 100vw', class: 'size-full object-cover motion-safe:transition-transform motion-safe:duration-700 group-hover/story:scale-105' }}{%- endif -%}</span>
          <span class="flex flex-1 flex-col gap-2 p-5">
            <span class="font-heading text-[18px] font-extrabold leading-snug">{{ other.title | escape }}</span>
            <span class="mt-auto font-heading text-[14px] font-bold text-accent">{{ 'journal.read_story' | t }} →</span>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}
{% render 'explore-strip' %}

<script>
  (() => {
    const body = document.querySelector('[data-article-body]');
    const shop = document.querySelector('[data-shop-story]');
    if (body && shop) {
      const heads = body.querySelectorAll('h2');
      const anchor = heads[Math.min(2, heads.length - 1)];
      if (heads.length >= 3 && anchor) anchor.before(shop);
    }
    const bar = document.querySelector('[data-read-progress]');
    const article = document.querySelector('[data-article]');
    if (bar && article) {
      const update = () => {
        const r = article.getBoundingClientRect();
        const total = r.height - window.innerHeight * 0.6;
        const progress = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
        bar.style.transform = 'scaleX(' + progress + ')';
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
    if (body) body.querySelectorAll('h2, p, ul, blockquote, img').forEach((el) => el.setAttribute('data-reveal', ''));
    const reveal = document.querySelectorAll('[data-reveal]');
    if (!('IntersectionObserver' in window)) { reveal.forEach((el) => el.classList.add('is-visible')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    reveal.forEach((el) => io.observe(el));
  })();
</script>
