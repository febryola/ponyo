{%- comment -%} Journal hero: copy beside a rounded image, like the reference. {%- endcomment -%}
{% block 'container', class: 'w-full bg-linear-[112deg] from-[#f9efe8] to-[#fbf3ec]', attributes: 'aria-labelledby="journal-heading"' %}
  <div class="mx-auto grid max-w-page items-center gap-8 px-margin py-12 md:grid-cols-2 md:gap-14 md:py-16">
    <div class="flex flex-col items-start gap-3">
      {% block 'text', variant: 'sm', class: 'text-[10px]! font-black uppercase tracking-[1.4px] text-accent' %}{{ 'home.pages.journal_eyebrow' | t }}{% endblock %}
      {%- liquid
        assign journal_heading = blog.title
        if journal_heading == blank or blog.handle == 'news'
          assign journal_heading = 'home.pages.journal_title' | t
        endif
      -%}
      {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold tracking-tight text-balance text-[#4a3530] text-4xl! md:text-[52px]!', attributes: 'id="journal-heading"' %}{{ journal_heading | escape }}{% endblock %}
      {% block 'text', class: 'max-w-md text-on-surface-secondary' %}{{ 'home.pages.journal_sub' | t }}{% endblock %}
    </div>
    {%- assign journal_hero_image = images['ponyo-2.png'] -%}
    <div class="aspect-[4/3] overflow-hidden rounded-xl bg-oat shadow-[0_18px_42px_rgba(110,74,62,.13)] [&_img]:size-full [&_img]:object-cover">
      {% block 'image', fallback_image: journal_hero_image, aspect_ratio: 'aspect-[4/3]', alt: 'A selection of plush characters arranged together', sizes: '(min-width: 768px) 50vw, 100vw', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
    </div>
  </div>
{% endblock %}

{% block 'container', class: 'w-full max-w-page mx-auto px-margin' %}
  <div class="py-12">

    <h2 class="sr-only">{{ 'blog.articles_heading' | t }}</h2>

    {% paginate blog.articles by 12 %}
      {%- if blog.articles.size > 0 -%}
        <ul role="list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-fade-in">
          {%- for article in blog.articles -%}
            {%- comment -%} The six-slot eager threshold matches two large-screen three-column rows; the slot-one image receives the LCP priority hint when present. {%- endcomment -%}
            {%- if forloop.index <= 6 -%}
              {%- assign img_loading_lazy = false -%}
            {%- else -%}
              {%- assign img_loading_lazy = true -%}
            {%- endif -%}
            {%- if forloop.first -%}{%- assign fetch_priority = 'high' -%}{%- else -%}{%- assign fetch_priority = 'auto' -%}{%- endif -%}
            {%- if img_loading_lazy -%}{%- assign image_loading = 'loading="lazy"' -%}{%- else -%}{%- assign image_loading = 'loading="eager"' -%}{%- endif -%}
            {%- assign image_attributes = image_loading | append: ' fetchpriority="' | append: fetch_priority | append: '"' -%}
            {%- assign card_article = article -%}
            {%- liquid
              assign card_tags = card_article.tags | join: ',' | downcase
              if card_article.image != blank
                assign card_image = card_article.image
              elsif card_tags contains 'domina'
                assign card_image = images['ponyo-3.png']
              elsif card_tags contains 'premium'
                assign card_image = images['ponyo-5.png']
              elsif card_tags contains 'care'
                assign card_image = images['ponyo-6.png']
              else
                assign card_image = images['ponyo-2.png']
              endif
              assign card_has_media = false
              if card_image != blank
                assign card_has_media = true
              endif
            -%}
            {%- comment -%} Imageless articles use link_mode: 'card' so the shell provides the accessible whole-card link. {%- endcomment -%}
            {%- if card_has_media -%}{%- assign card_link_mode = 'content' -%}{%- else -%}{%- assign card_link_mode = 'card' -%}{%- endif -%}

            <li>
              {% block 'card', block.name: 't:blocks.article_card', url: card_article.url, aria_label: card_article.title, link_mode: card_link_mode, border_radius: 'rounded-card', class: 'h-full overflow-hidden border border-border bg-white p-3 shadow-[0_5px_18px_rgba(110,74,62,.055)] motion-safe:transition hover:-translate-y-1' %}
                {% if card_has_media %}
                  {%- comment -%} The image sizes match the blog preload imagesizes; child image settings remain independently editable. {%- endcomment -%}
                  {%- comment -%} Inherit the shell radius so its editor setting controls the media link too. {%- endcomment -%}
                  <a href="{{ card_article.url | escape }}" class="relative block overflow-hidden rounded-[inherit] motion-safe:[&_img]:transition-transform motion-safe:[&_img]:duration-700 hover:[&_img]:scale-105" aria-label="{{ card_article.title | escape }}">
                    {% block 'image', fallback_image: card_image, sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw', aspect_ratio: 'aspect-square', image: card_article.image, alt: card_article.title, attributes: image_attributes, seed: forloop.index, placeholder_kind: 'article' %}{% endblock %}
                  </a>
                {% endif %}
                <div class="flex flex-col gap-0.5">
                  {% block 'text', tag: 'h3', class: 'mt-1 font-heading text-lg! font-extrabold leading-snug text-[#4a3530] line-clamp-2' %}{{ card_article.title | escape }}{% endblock %}
                  {%- assign article_date = card_article.published_at | date: format: 'date' -%}
                  {%- assign article_datetime = card_article.published_at | date: '%Y-%m-%d' -%}
                  {%- assign escaped_author = card_article.author | escape -%}
                  {%- comment -%} The `_html` metadata translations own the semantic `<time>`; the text block renders its content raw so that element survives the selectable wrapper. {%- endcomment -%}
                  {% block 'text', variant: 'sm', class: 'text-on-surface-secondary' %}{% if card_article.author %}{{ 'blog.article_metadata_html' | t: date: article_date, datetime: article_datetime, author: escaped_author }}{% else %}{{ 'blog.article_metadata_no_author_html' | t: date: article_date, datetime: article_datetime }}{% endif %}{% endblock %}
                  {%- if card_article.excerpt_or_content != blank -%}
                    {% block 'text', variant: 'sm', class: 'text-on-surface-secondary line-clamp-3' %}{{ card_article.excerpt_or_content | strip_html | truncatewords: 25 }}{% endblock %}
                  {%- endif -%}
                </div>
              {% endblock %}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        {%- comment -%} Until the first article is published, show the journal's three guide cards from the reference. {%- endcomment -%}
        <ul role="list" class="grid gap-4 md:grid-cols-3 md:gap-[18px]">
          {%- assign journal_samples = 'ponyo-3.png|card1|An oversized bunny plush shown beside a person for scale^^ponyo-5.png|card2|Close-up details of a soft teddy bear plush^^ponyo-2.png|card3|A selection of plush characters arranged together' | split: '^^' -%}
          {%- for sample in journal_samples -%}
            {%- assign js = sample | split: '|' -%}
            {%- assign journal_image = images[js[0]] -%}
            {%- assign label_key = 'home.journal.' | append: js[1] | append: '_label' -%}
            {%- assign title_key = 'home.journal.' | append: js[1] | append: '_title' -%}
            {%- assign cta_key = 'home.journal.' | append: js[1] | append: '_cta' -%}
            {%- assign journal_title = title_key | t -%}
            <li>
              {% block 'card', aria_label: journal_title, class: 'relative isolate min-h-[300px] md:min-h-[360px] overflow-hidden bg-oat gap-0!', border_radius: 'rounded-card' %}
                <div class="absolute inset-0 -z-20 [&_img]:size-full [&_img]:object-cover">
                  {% block 'image', fallback_image: journal_image, alt: js[2], class: 'absolute inset-0', sizes: '(min-width: 768px) 33vw, 100vw', attributes: 'loading="lazy"' %}{% endblock %}
                </div>
                <div class="absolute inset-x-0 bottom-0 top-1/5 -z-10 bg-linear-to-b from-transparent to-[rgba(74,53,48,.8)]" aria-hidden="true"></div>
                <div class="absolute inset-x-5 bottom-5 flex flex-col gap-2 text-white">
                  {% block 'text', variant: 'sm', class: 'text-[10px]! font-extrabold tracking-[1.5px]' %}{{ label_key | t }}{% endblock %}
                  {% block 'text', tag: 'h3', class: 'font-heading text-xl! md:text-2xl! font-extrabold leading-tight text-balance' %}{{ journal_title }}{% endblock %}
                  {% block 'text', variant: 'sm', class: 'text-xs! font-extrabold' %}{{ cta_key | t }}{% endblock %}
                </div>
              {% endblock %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {% block 'pagination', paginate: paginate, class: 'mt-12' %}{% endblock %}
    {% endpaginate %}
  </div>
{% endblock %}
