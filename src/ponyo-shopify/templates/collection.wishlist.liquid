{%- comment -%} My Wishlist: open with /collections/all?view=wishlist. Saved plush are kept in this browser and loaded by assets/ponyo-wishlist.js. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-10 md:py-14', attributes: 'aria-labelledby="wishlist-title"' %}
  <div data-wishlist-page data-currency="{{ cart.currency.iso_code }}">
    <div class="mb-8 flex flex-col items-center gap-2 text-center">
      <span class="inline-flex size-14 items-center justify-center rounded-full bg-[#fde4e8] text-[#e0566b]" aria-hidden="true"><svg viewBox="0 0 24 24" class="size-7"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.5 1.1 5 2.9 1.5-1.8 3-2.9 5-2.9 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" fill="currentColor"/></svg></span>
      {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold tracking-tight text-[#4a3530] text-3xl! md:text-[40px]!', attributes: 'id="wishlist-title"' %}{{ 'wishlist.title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-[460px] text-on-surface-secondary' %}{{ 'wishlist.intro' | t }}{% endblock %}
    </div>

    <ul role="list" class="grid grid-cols-2 gap-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 md:gap-2.5" data-wishlist-grid hidden></ul>

    <div class="mx-auto flex max-w-[460px] flex-col items-center gap-3 rounded-[24px] border-2 border-dashed border-[#e9d3c8] bg-white px-6 py-12 text-center" data-wishlist-empty>
      {% block 'text', tag: 'h2', class: 'font-heading text-xl! font-bold text-[#4a3530]' %}{{ 'wishlist.empty' | t }}{% endblock %}
      {% block 'text', variant: 'sm', class: 'text-on-surface-secondary' %}{{ 'wishlist.empty_body' | t }}{% endblock %}
      {% block 'button', url: routes.all_products_collection_url, variant: 'button-primary', class: 'mt-2 h-11 rounded-full px-7 font-heading text-sm font-bold shadow-[0_4px_0_#7f4a38]' %}{{ 'wishlist.browse' | t }}{% endblock %}
    </div>

    <template data-wishlist-card>
      <li class="h-full">
        <div class="group/card relative flex h-full flex-col rounded-none border border-[#e8ded8] bg-white motion-safe:transition motion-safe:duration-200 hover:border-[#c9b2a6] hover:shadow-[0_4px_14px_rgba(46,33,29,.12)]">
          <a data-link class="relative mb-2 block aspect-square overflow-hidden rounded-none bg-[#fbf3ec]" tabindex="-1" aria-hidden="true">
            <img data-image class="size-full object-cover object-[center_30%]" loading="lazy" alt="">
            <span data-soldout hidden class="absolute start-1.5 top-1.5 rounded-none bg-[#4a3530] px-1.5 py-0.5 text-[10.5px] font-bold uppercase tracking-wide text-white">{{ 'mp.sold_out' | t }}</span>
          </a>
          <button type="button" class="absolute end-1.5 top-1.5 z-[2] inline-flex size-9 items-center justify-center rounded-full bg-white/90 text-[#e0566b] shadow-[0_2px_10px_rgba(46,33,29,.12)] hover:bg-white" data-wishlist-toggle="" aria-pressed="true" aria-label="{{ 'wishlist.remove' | t }}">
            <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.5 1.1 5 2.9 1.5-1.8 3-2.9 5-2.9 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2Z" fill="currentColor"/></svg>
          </button>
          <h2 class="m-0 line-clamp-2 px-2 font-body text-[13.5px] font-medium leading-snug md:px-2.5 text-[#3f302b]"><a data-link data-title class="text-inherit no-underline after:absolute after:inset-0 after:z-[1] after:content-['']"></a></h2>
          <p class="m-0 mt-auto flex items-baseline gap-2 px-2 pt-1 pb-2.5 font-heading text-[17px] md:px-2.5 font-bold text-[#3f302b]"><span data-price></span><s data-compare class="font-body text-[13px] font-normal opacity-60"></s></p>
        </div>
      </li>
    </template>
  </div>
{% endblock %}

{% render 'explore-strip' %}
