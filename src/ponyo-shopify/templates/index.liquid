{%- comment -%} Marketplace aisles: Amazon-style quad cards so shoppers see every kind of plush at a glance. Each card shows up to four real products from its collection; a short collection ends with a See all tile. {%- endcomment -%}
{%- liquid
  assign aisle_handles = 'rare-finds|home.aisles.rare_title|home.aisles.rare_sub^^premium|home.aisles.premium_title|home.aisles.premium_sub^^domina-xl|home.aisles.xl_title|home.aisles.xl_sub' | split: '^^'
  assign aisle_animals = 'bears|home.categories.bears^^bunnies|home.categories.bunnies^^cats|home.categories.cats^^pandas|home.categories.pandas' | split: '^^'
-%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'pt-8 pb-2 md:pt-12', attributes: 'aria-labelledby="aisles-title"' %}
  <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
    <div class="flex flex-col gap-1">
      {% block 'heading', tag: 'h2', variant: 'md', class: 'font-extrabold leading-tight tracking-tight text-[#4a3530] text-[24px]! md:text-[32px]!', attributes: 'id="aisles-title"' %}{{ 'home.aisles.title' | t }}{% endblock %}
      {% block 'text', class: 'text-[14px]! md:text-[15px]! text-on-surface-secondary' %}{{ 'home.aisles.sub' | t }}{% endblock %}
    </div>
  </div>
  <ul role="list" class="m-0 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {%- for entry in aisle_handles -%}
      {%- assign a = entry | split: '|' -%}
      {%- assign aisle = collections[a[0]] -%}
      {%- if aisle == blank or aisle.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <li class="flex flex-col rounded-[10px] border border-[#e8ded8] bg-white p-4">
        <h3 class="m-0 font-heading text-[19px] font-bold leading-tight text-[#2e211d]">{{ a[1] | t }}</h3>
        <p class="m-0 mt-0.5 mb-3 text-[12.5px] text-on-surface-secondary">{{ a[2] | t }}</p>
        <div class="grid flex-1 grid-cols-2 gap-2.5">
          {%- for product in aisle.products limit: 4 -%}
            <a href="{{ product.url | escape }}" class="group/aisle flex flex-col gap-1 text-[#3f302b] no-underline">
              <span class="block aspect-square overflow-hidden bg-[#fbf3ec]">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 300 | image_tag: alt: product.title, loading: 'lazy', widths: '150,220,300', sizes: '(min-width: 1024px) 130px, 42vw', class: 'size-full object-cover motion-safe:transition-transform motion-safe:duration-500 group-hover/aisle:scale-105' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'size-full' }}
                {%- endif -%}
              </span>
              <span class="line-clamp-1 text-[12px] font-medium leading-snug">{{ product.title | escape }}</span>
              <span class="text-[12.5px] font-bold">{{ product.price | money_without_trailing_zeros }}</span>
            </a>
          {%- endfor -%}
          {%- if aisle.products.size < 4 -%}
            <a href="{{ aisle.url }}" class="flex aspect-square flex-col items-center justify-center gap-1 bg-[#f3ece7] text-center text-[13px] font-bold text-[#4a3530] no-underline hover:bg-[#ecdcd0]">
              <span class="text-[20px]" aria-hidden="true">→</span>{{ 'home.aisles.see_all' | t }}
            </a>
          {%- endif -%}
        </div>
        <a href="{{ aisle.url }}" class="mt-3 text-[13px] font-bold text-[#a04f2e] no-underline hover:underline">{%- assign aisle_name = a[1] | t -%}{{ 'home.aisles.see_more' | t: title: aisle_name }}</a>
      </li>
    {%- endfor -%}
    <li class="flex flex-col rounded-[10px] border border-[#e8ded8] bg-white p-4">
      <h3 class="m-0 font-heading text-[19px] font-bold leading-tight text-[#2e211d]">{{ 'home.aisles.animal_title' | t }}</h3>
      <p class="m-0 mt-0.5 mb-3 text-[12.5px] text-on-surface-secondary">{{ 'home.aisles.animal_sub' | t }}</p>
      <div class="grid flex-1 grid-cols-2 gap-2.5">
        {%- for entry in aisle_animals -%}
          {%- assign an = entry | split: '|' -%}
          {%- assign animal = collections[an[0]] -%}
          {%- if animal == blank or animal.products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign animal_image = animal.featured_image | default: animal.products.first.featured_image -%}
          <a href="{{ animal.url }}" class="group/aisle flex flex-col gap-1 text-[#3f302b] no-underline">
            <span class="block aspect-square overflow-hidden bg-[#fbf3ec]">
              {%- if animal_image != blank -%}
                {{ animal_image | image_url: width: 300 | image_tag: alt: '', loading: 'lazy', widths: '150,220,300', sizes: '(min-width: 1024px) 130px, 42vw', class: 'size-full object-cover motion-safe:transition-transform motion-safe:duration-500 group-hover/aisle:scale-105' }}
              {%- endif -%}
            </span>
            <span class="text-[12.5px] font-bold">{{ an[1] | t }}</span>
          </a>
        {%- endfor -%}
      </div>
      <a href="{{ routes.collections_url }}" class="mt-3 text-[13px] font-bold text-[#a04f2e] no-underline hover:underline">{{ 'home.aisles.animal_more' | t }}</a>
    </li>
  </ul>
{% endblock %}


