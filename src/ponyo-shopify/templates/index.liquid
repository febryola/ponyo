{% endblock %}

{% render 'recently-viewed' %}

{%- comment -%} Shop by animal: tabs that switch between the animal collections, each showing its own plush. {%- endcomment -%}
{%- assign animal_handles = 'bears,bunnies,cats,puppies,pandas,penguins,characters' | split: ',' -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-10 md:py-14', attributes: 'aria-labelledby="animals-title"' %}
  <div class="mb-5 flex flex-col gap-1 md:mb-6">
    {% block 'heading', tag: 'h2', variant: 'md', class: 'font-extrabold leading-tight tracking-tight text-[#4a3530] text-[26px]! md:text-[36px]!', attributes: 'id="animals-title"' %}{{ 'home.v2.animals_title' | t }}{% endblock %}
    {% block 'text', class: 'text-[14px]! md:text-[15.5px]! text-on-surface-secondary' %}{{ 'home.v2.animals_sub' | t }}{% endblock %}
  </div>
  <div data-tabs>
    <div role="tablist" aria-labelledby="animals-title" class="-mx-1 mb-5 flex gap-2 overflow-x-auto px-1 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {%- assign tab_index = 0 -%}
      {%- for handle in animal_handles -%}
        {%- assign ac = collections[handle] -%}
        {%- if ac == blank or ac.products_count == 0 -%}{%- continue -%}{%- endif -%}
        <button type="button" role="tab" id="animal-tab-{{ handle }}" aria-controls="animal-panel-{{ handle }}" aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}" tabindex="{% if tab_index == 0 %}0{% else %}-1{% endif %}" class="inline-flex h-11 shrink-0 items-center gap-2 rounded-full border-2 border-[#e9d3c8] bg-white ps-1.5 pe-4 font-heading text-[14.5px] font-bold text-[#4a3530] hover:bg-[#f3ece7] aria-selected:border-[#4a3530] aria-selected:bg-[#4a3530] aria-selected:text-white">
          <span class="block size-8 overflow-hidden rounded-full bg-[#fbf3ec]">{%- assign tab_img = ac.image | default: ac.products.first.featured_image -%}{%- if tab_img != blank -%}{{ tab_img | image_url: width: 80 | image_tag: alt: '', loading: 'lazy', class: 'size-full object-cover' }}{%- endif -%}</span>
          {{ ac.title | escape }}
        </button>
        {%- assign tab_index = tab_index | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- assign tab_index = 0 -%}
    {%- for handle in animal_handles -%}
      {%- assign ac = collections[handle] -%}
      {%- if ac == blank or ac.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <div role="tabpanel" id="animal-panel-{{ handle }}" aria-labelledby="animal-tab-{{ handle }}"{% if tab_index > 0 %} hidden{% endif %}>
        <ul role="list" class="-mx-1 flex snap-x gap-3 overflow-x-auto px-1 pb-3 [scrollbar-width:none] md:grid md:grid-cols-4 lg:grid-cols-6 md:gap-2.5 md:overflow-visible [&::-webkit-scrollbar]:hidden">
          {%- for product in ac.products limit: 6 -%}
            <li class="w-[46%] shrink-0 snap-start md:w-auto">{% render 'ponyo-product-card', product: product, sizes: '(min-width: 1024px) 200px, 46vw' %}</li>
          {%- endfor -%}
          {%- assign fill_n = ac.products_count | at_most: 6 -%}
          {% render 'ponyo-fill-tiles', count: fill_n, cols_sm: 1, cols_md: 4, cols_lg: 6, offset: 2 %}
        </ul>
        <a href="{{ ac.url }}" class="mt-3 inline-flex h-11 items-center rounded-full border-2 border-[#e9d3c8] bg-white px-5 font-heading text-[14px] font-bold text-[#4a3530] no-underline hover:bg-[#f3ece7]">{{ 'home.v2.shop_all_in' | t: name: ac.title }} →</a>
      </div>
      {%- assign tab_index = tab_index | plus: 1 -%}
    {%- endfor -%}
  </div>
  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      const tabs = [...root.querySelectorAll('[role="tab"]')];
      const select = (tab) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', on);
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        });
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const dir = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
          if (!dir) return;
          const next = tabs[(i + dir + tabs.length) % tabs.length];
          next.focus();
          select(next);
        });
      });
    })();
  </script>
{% endblock %}

