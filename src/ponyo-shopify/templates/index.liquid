{%- comment -%} Falling stars and snow over the top of the homepage only: fades out as shoppers scroll past the hero to the products. Skips reduced-motion users and pauses in background tabs. {%- endcomment -%}
<canvas class="pointer-events-none fixed inset-0 z-30 size-full" data-ponyo-sparkles aria-hidden="true"></canvas>
<script>
  (() => {
    const canvas = document.querySelector('[data-ponyo-sparkles]');
    if (!canvas || matchMedia('(prefers-reduced-motion: reduce)').matches) { canvas?.remove(); return; }
    const ctx = canvas.getContext('2d');
    const colors = ['#f6c453', '#f6c453', '#f4a6b4', '#a9c8e6', '#ee8a4c', '#ffffff'];
    let w = 0, h = 0, dpr = 1, particles = [], raf = 0, last = 0;
    const make = (fromTop) => {
      const star = Math.random() < 0.45;
      return {
        x: Math.random() * w,
        y: fromTop ? -20 - Math.random() * h * 0.3 : Math.random() * h,
        r: star ? 4 + Math.random() * 5 : 1.6 + Math.random() * 2.6,
        star,
        color: colors[(Math.random() * colors.length) | 0],
        vy: 18 + Math.random() * 34,
        sway: 10 + Math.random() * 22,
        phase: Math.random() * Math.PI * 2,
        spin: (Math.random() - 0.5) * 1.6,
        angle: Math.random() * Math.PI,
        alpha: 0.45 + Math.random() * 0.45,
        twinkle: 1.5 + Math.random() * 2.5,
      };
    };
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth; h = window.innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = 20;
      while (particles.length < target) particles.push(make(false));
      particles.length = target;
    };
    const drawStar = (p, t) => {
      const s = p.r;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      ctx.globalAlpha = p.alpha * (0.6 + 0.4 * Math.sin(t * p.twinkle + p.phase));
      ctx.fillStyle = p.color;
      ctx.beginPath();
      for (let i = 0; i < 4; i++) {
        ctx.rotate(Math.PI / 2);
        ctx.quadraticCurveTo(s * 0.18, s * 0.18, 0, s);
        ctx.quadraticCurveTo(-s * 0.18, s * 0.18, 0, 0);
      }
      ctx.fill();
      ctx.restore();
    };
    const drawSnow = (p) => {
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle = p.color;
      ctx.shadowColor = p.color === '#ffffff' ? 'rgba(169,200,230,.9)' : 'transparent';
      ctx.shadowBlur = p.color === '#ffffff' ? 4 : 0;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.shadowBlur = 0;
    };
    const frame = (now) => {
      const dt = Math.min(0.05, (now - (last || now)) / 1000);
      last = now;
      const t = now / 1000;
      ctx.clearRect(0, 0, w, h);
      for (const p of particles) {
        p.y += p.vy * dt;
        p.x += Math.sin(t * 0.8 + p.phase) * p.sway * dt;
        p.angle += p.spin * dt;
        if (p.y > h + 20) Object.assign(p, make(true));
        if (p.star) drawStar(p, t); else drawSnow(p);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    };
    const start = () => { if (!raf) { last = 0; raf = requestAnimationFrame(frame); } };
    const stop = () => { cancelAnimationFrame(raf); raf = 0; ctx.clearRect(0, 0, w, h); };
    const endMarker = document.querySelector('[data-sparkle-end]');
    let visible = 1;
    const update = () => {
      const end = endMarker ? endMarker.getBoundingClientRect().top + window.scrollY : h;
      const fadeFrom = end * 0.45;
      const y = window.scrollY;
      visible = y <= fadeFrom ? 1 : Math.max(0, 1 - (y - fadeFrom) / Math.max(1, end - fadeFrom));
      canvas.style.opacity = visible;
      if (visible === 0 || document.hidden) stop(); else start();
    };
    resize();
    window.addEventListener('resize', () => { resize(); update(); }, { passive: true });
    window.addEventListener('scroll', update, { passive: true });
    document.addEventListener('visibilitychange', update);
    update();
  })();
</script>

