      {% block 'heading', tag: 'h2', variant: 'md', class: 'font-extrabold leading-tight tracking-tight text-[#4a3530] text-[26px]! md:text-[36px]!', attributes: 'id="more-plush-title"' %}{{ 'home.more_plush.title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-[520px] text-[14px]! md:text-[15.5px]! text-on-surface-secondary' %}{{ 'home.more_plush.sub' | t }}{% endblock %}
