{%- comment -%} Rare Finds spotlight: one big featured plush plus four more, on a dark panel. {%- endcomment -%}
<div class="w-full px-margin md:px-6">
  {% block 'container', class: 'relative isolate mx-auto my-12 w-full max-w-[1400px] overflow-hidden rounded-[28px] bg-[#2e211d] px-5 md:my-16 md:px-12', padding: 'py-10 md:py-14', attributes: 'id="rare-finds" aria-labelledby="rare-finds-title"' %}
    <div class="pointer-events-none absolute -end-20 -top-24 -z-10 size-[340px] rounded-full bg-[#f6c453]/10 blur-2xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-28 -start-16 -z-10 size-[300px] rounded-full bg-[#e0566b]/10 blur-2xl" aria-hidden="true"></div>
    
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3 md:mb-8">
    <div class="flex flex-col gap-1">
      {% block 'heading', tag: 'h2', variant: 'md', class: 'font-extrabold leading-tight tracking-tight text-white text-[26px]! md:text-[36px]!', attributes: 'id="rare-finds-title"' %}{{ 'home.trending.title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-[520px] text-[14px]! md:text-[15.5px]! text-[#e8d6cd]' %}{{ 'home.trending.sub' | t }}{% endblock %}
    </div>
    {% block 'link', url: shelf_trending.url, class: 'min-h-0! rounded-full border-2 border-white/25 text-white! hover:bg-white/10! px-4 py-2 font-heading text-[13.5px]! font-bold no-underline!' %}{{ 'home.v2.see_all' | t }} →{% endblock %}
  </div>
    {%- assign spotlight = shelf_trending.products.first -%}
    {%- if spotlight != blank -%}
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:gap-6">
        <a href="{{ spotlight.url }}" class="group/spot relative flex min-h-[340px] flex-col justify-end overflow-hidden rounded-[22px] bg-[#3a2b26] p-5 text-white no-underline md:min-h-[460px] md:p-8">
          {%- if spotlight.featured_image != blank -%}
            {{ spotlight.featured_image | image_url: width: 1200 | image_tag: alt: spotlight.title, loading: 'lazy', widths: '500,800,1000,1200', sizes: '(min-width: 1024px) 680px, 100vw', class: 'absolute inset-0 -z-0 size-full object-cover motion-safe:transition-transform motion-safe:duration-700 group-hover/spot:scale-[1.04]' }}
          {%- endif -%}
          <span class="absolute inset-0 bg-linear-to-t from-[#2e211d]/90 via-[#2e211d]/20 to-transparent" aria-hidden="true"></span>
          <span class="absolute start-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-[#f6c453] px-3.5 py-1.5 font-heading text-[12px] font-bold uppercase tracking-[0.08em] text-[#2e211d] md:start-8 md:top-8">✦ {{ 'home.v2.spotlight' | t }}</span>
          <span class="relative flex flex-col gap-1.5">
            <span class="font-heading text-[28px] font-extrabold leading-tight md:text-[40px]">{{ spotlight.title | escape }}</span>
            {%- if spotlight.metafields.ponyo.size_tier != blank -%}<span class="text-[14px] font-semibold text-[#f6c453]">{{ spotlight.metafields.ponyo.size_tier.value | escape }}{% if spotlight.metafields.ponyo.dimensions != blank %} · {{ spotlight.metafields.ponyo.dimensions.value | escape }}{% endif %}</span>{%- endif -%}
            <span class="mt-2 flex items-center gap-3"><span class="font-heading text-[22px] font-bold">{{ spotlight.price | money_without_trailing_zeros }}</span><span class="inline-flex h-10 items-center rounded-full bg-white px-5 font-heading text-[14px] font-bold text-[#2e211d] motion-safe:transition group-hover/spot:bg-[#f6c453]">{{ 'home.v2.view_plush' | t }} →</span></span>
          </span>
        </a>
        <ul role="list" class="grid grid-cols-2 gap-2 md:gap-2.5">
          {%- for product in shelf_trending.products offset: 1 limit: 4 -%}
            <li>{% render 'ponyo-product-card', product: product, tone: 'dark', sizes: '(min-width: 1024px) 300px, 45vw' %}</li>
          {%- endfor -%}
          {%- assign fill_n = shelf_trending.products_count | minus: 1 | at_least: 0 | at_most: 4 -%}
          {% render 'ponyo-fill-tiles', count: fill_n, cols_sm: 2, cols_md: 2, cols_lg: 2, offset: 0 %}
        </ul>
      </div>
    {%- endif -%}
  {% endblock %}
</div>

{%- comment -%} Just landed: horizontal scroller of the newest plush. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-6 md:py-8', attributes: 'id="new-arrivals" aria-labelledby="new-arrivals-title"' %}
  
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3 md:mb-8">
    <div class="flex flex-col gap-1">
      {% block 'heading', tag: 'h2', variant: 'md', class: 'font-extrabold leading-tight tracking-tight text-[#4a3530] text-[26px]! md:text-[36px]!', attributes: 'id="new-arrivals-title"' %}{{ 'home.v2.new_title' | t }}{% endblock %}
      {% block 'text', class: 'max-w-[520px] text-[14px]! md:text-[15.5px]! text-on-surface-secondary' %}{{ 'home.v2.new_sub' | t }}{% endblock %}
    </div>
    {% block 'link', url: shelf_new.url, class: 'min-h-0! rounded-full border-2 border-[#e9d3c8] bg-white text-[#4a3530]! hover:bg-[#f3ece7]! px-4 py-2 font-heading text-[13.5px]! font-bold no-underline!' %}{{ 'home.v2.see_all' | t }} →{% endblock %}
  </div>
  <div class="relative" data-scroller>
    <ul role="list" class="-mx-1 flex snap-x snap-mandatory gap-2 overflow-x-auto px-1 pb-3 [scrollbar-width:none] md:gap-2.5 [&::-webkit-scrollbar]:hidden" data-scroller-track>
      {%- for product in shelf_new.products limit: 10 -%}
        <li class="w-[46%] shrink-0 snap-start sm:w-[31%] md:w-[23.5%] lg:w-[15.8%]">{% render 'ponyo-product-card', product: product, sizes: '(min-width: 1024px) 200px, 46vw' %}</li>
      {%- endfor -%}
    </ul>
    <button type="button" class="absolute -start-4 top-[38%] hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#2e211d] shadow-[0_6px_18px_rgba(46,33,29,.18)] hover:bg-[#f3ece7] md:inline-flex" data-scroller-prev aria-label="{{ 'home.slides.previous' | t }}"><span class="inline-flex size-4 rotate-180 rtl:rotate-0 [&_svg]:size-full" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span></button>
    <button type="button" class="absolute -end-4 top-[38%] hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-[#2e211d] shadow-[0_6px_18px_rgba(46,33,29,.18)] hover:bg-[#f3ece7] md:inline-flex" data-scroller-next aria-label="{{ 'home.slides.next' | t }}"><span class="inline-flex size-4 rtl:rotate-180 [&_svg]:size-full" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span></button>
  </div>
  <script>
    (() => {
      const root = document.currentScript.previousElementSibling;
      const track = root.querySelector('[data-scroller-track]');
      const step = () => track.clientWidth * 0.8 * (document.dir === 'rtl' ? -1 : 1);
      root.querySelector('[data-scroller-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
      root.querySelector('[data-scroller-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    })();
  </script>
{% endblock %}

{%- comment -%} Trending now: best-selling plush from the Trending collection (all plush until it exists). {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-6 md:py-8', attributes: 'id="more-plush" aria-labelledby="more-plush-title"' %}
