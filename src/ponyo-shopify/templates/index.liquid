{%- comment -%} Ponyo homepage, matched to the merchant's reference design. {%- endcomment -%}
{%- liquid
  assign hero_image = images['ponyo-2.png']
  assign domina_url = '/pages/domina-xl'
  assign domina_image = images['ponyo-3.png']
  assign tile_sizes = '(min-width: 1024px) 280px, 45vw'
  assign all_url = routes.all_products_collection_url
  assign panda_url = collections['pandas'].url | default: all_url
  assign puppy_url = collections['puppies'].url | default: all_url
  assign penguin_url = collections['penguins'].url | default: all_url
  assign url_bears = collections['bears'].url | default: all_url
  assign url_bunnies = collections['bunnies'].url | default: all_url
  assign url_cats = collections['cats'].url | default: all_url
  assign url_characters = collections['characters'].url | default: all_url
  assign url_mini = all_url | append: '?filter.p.m.ponyo.size_tier=Small'
  assign url_classic = all_url | append: '?filter.p.m.ponyo.size_tier=Medium'
  assign url_big = all_url | append: '?filter.p.m.ponyo.size_tier=Large'
  assign url_xl = all_url | append: '?filter.p.m.ponyo.size_tier=XL'

  comment
    Shelves read from real collections and fall back to all products while a collection is missing or empty.
  endcomment
  assign shelf_trending = collections['rare-finds']
  if shelf_trending == blank or shelf_trending.products_count == 0
    assign shelf_trending = collections.all
  endif
  assign shelf_domina = collections['domina-xl']
  if shelf_domina == blank or shelf_domina.products_count == 0
    assign shelf_domina = collections.all
  endif
  assign shelf_new = collections['new-arrivals']
  if shelf_new == blank or shelf_new.products_count == 0
    assign shelf_new = collections.all
  endif
  comment
    Premium Picks always reads the Premium Plushies collection. Collectibles gets its own spots only once it has products, so no link leads to an empty page.
  endcomment
  assign shelf_loved = collections['premium']
  if shelf_loved == blank or shelf_loved.products_count == 0
    assign shelf_loved = collections.all
  endif
  assign shelf_collectibles = collections['collectibles']
  assign has_collectibles = false
  if shelf_collectibles != blank and shelf_collectibles.products_count > 0
    assign has_collectibles = true
  endif
  assign shelf_hot = collections.all
  assign url_premium = collections['premium'].url | default: all_url
-%}

{% style %}
  @keyframes ponyo-float { 0%, 100% { transform: translateY(0) rotate(0deg); opacity: .9; } 50% { transform: translateY(-8px) rotate(12deg); opacity: 1; } }
{% endstyle %}

{%- comment -%} Hero: marketplace headline and shop buttons over a wide plush lineup; search lives in the header. {%- endcomment -%}
{%- liquid
  assign domina_url = '/pages/domina-xl'
-%}
{% block 'container', class: 'relative w-full', padding: '', attributes: 'aria-labelledby="home-hero-heading"' %}
  {%- liquid
    assign all_slide_specs = 'rare|ponyo-2.png|rare-finds|A lineup of soft plush toys sitting together^^xl|ponyo-3.png|domina-xl|A person holding an oversized cream bunny plush^^premium|ponyo-5.png|premium|A grid of soft premium plush friends^^collectibles|ponyo-7.png|collectibles|A grid of collectible plush friends^^new|ponyo-6.png|new-arrivals|A pile of new plush friends on a cosy bed' | split: '^^'
    assign slide_list = ''
    for spec in all_slide_specs
      assign spec_handle = spec | split: '|' | slice: 2 | first
      if collections[spec_handle] == blank or collections[spec_handle].products_count == 0
        continue
      endif
      if slide_list != ''
        assign slide_list = slide_list | append: '^^'
      endif
      assign slide_list = slide_list | append: spec
    endfor
    assign slide_specs = slide_list | split: '^^'
  -%}
  <div>
    <div class="group/hero relative w-full overflow-hidden bg-[#f0dfd5]" data-hero-slider>
      <div class="flex h-[340px] snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] md:h-[min(40vw,520px)] [&::-webkit-scrollbar]:hidden" data-hero-track aria-roledescription="carousel" aria-label="{{ 'home.slides.label' | t }}">
        {%- for spec in slide_specs -%}
          {%- liquid
            assign s = spec | split: '|'
            assign s_key = s[0]
            assign s_url = collections[s[2]].url | default: all_url
            assign s_eyebrow_key = 'home.slides.' | append: s_key | append: '_eyebrow'
            assign s_title_key = 'home.pillars.' | append: s_key | append: '_title'
            assign s_body_key = 'home.pillars.' | append: s_key | append: '_body'
            assign s_cta_key = 'home.slides.' | append: s_key | append: '_cta'
            assign s_image = images[s[1]]
            if forloop.first
              assign s_loading = 'eager'
              assign s_attrs = 'fetchpriority="high"'
            else
              assign s_loading = 'lazy'
              assign s_attrs = ''
            endif
          -%}
          <div class="relative h-full w-full shrink-0 snap-start" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" data-hero-slide>
            <div class="absolute inset-0 [&_img]:size-full [&_img]:object-cover">
              {% block 'image', fallback_image: s_image, alt: s[3], class: 'absolute inset-0', loading: s_loading, sizes: '(min-width: 1400px) 1400px, 100vw', attributes: s_attrs %}{% endblock %}
            </div>
            <div class="absolute inset-0 bg-linear-to-r from-[#2e211d]/70 via-[#2e211d]/30 to-transparent md:from-[#2e211d]/60 md:via-[#2e211d]/20" aria-hidden="true"></div>
            <div class="relative flex h-full max-w-[640px] flex-col items-start justify-center gap-2 px-6 pb-14 md:gap-3 md:ps-24 md:pe-14 md:pb-16">
              {% block 'text', variant: 'sm', class: 'inline-flex whitespace-nowrap rounded-full bg-[#f6c453] px-3.5 py-1.5 font-heading text-[12px]! leading-none! font-bold uppercase tracking-[0.08em] text-[#2e211d] md:text-[13px]!' %}{{ s_eyebrow_key | t }}{% endblock %}
              {% block 'heading', tag: 'h2', variant: 'xl', class: 'font-extrabold leading-[1.05] tracking-tight text-white text-[34px]! md:text-[56px]! [text-shadow:0_2px_14px_rgba(0,0,0,.25)]' %}{{ s_title_key | t }}{% endblock %}
              {% block 'text', class: 'max-w-[380px] text-[14.5px]! leading-relaxed text-[#fbeee7] md:text-[17px]!' %}{{ s_body_key | t }}{% endblock %}
              {% block 'button', url: s_url, variant: 'custom', class: 'mt-1 h-11 rounded-full bg-tangerine! px-6 font-heading text-[14.5px] font-bold text-[#3f2418]! shadow-[0_4px_0_#b7612f] hover:bg-[#f39a62]! md:h-12 md:px-7 md:text-[15px]' %}{{ s_cta_key | t }}{% endblock %}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <button type="button" class="absolute top-1/2 start-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-[#2e211d] shadow-md hover:bg-white md:inline-flex" data-hero-prev aria-label="{{ 'home.slides.previous' | t }}">
        <span class="inline-flex size-4 rotate-180 rtl:rotate-0 [&_svg]:size-full" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
      </button>
      <button type="button" class="absolute top-1/2 end-4 hidden size-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-[#2e211d] shadow-md hover:bg-white md:inline-flex" data-hero-next aria-label="{{ 'home.slides.next' | t }}">
        <span class="inline-flex size-4 rtl:rotate-180 [&_svg]:size-full" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
      </button>
      <div class="absolute inset-x-0 bottom-14 flex justify-center gap-2 md:bottom-16" data-hero-dots>
        {%- for spec in slide_specs -%}
          <button type="button" class="h-2.5 w-2.5 rounded-full bg-white/60 motion-safe:transition-all data-[active]:w-7 data-[active]:bg-white" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'home.slides.go_to' | t: number: forloop.index }}"{% if forloop.first %} data-active aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
    </div>
  </div>
  <script>
    (() => {
      const root = document.currentScript.previousElementSibling.querySelector('[data-hero-slider]');
      if (!root) return;
      const track = root.querySelector('[data-hero-track]');
      const slides = [...root.querySelectorAll('[data-hero-slide]')];
      const dots = [...root.querySelectorAll('[data-hero-dot]')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let timer = null;
      const go = (i, smooth = true) => {
        index = (i + slides.length) % slides.length;
        track.scrollTo({ left: track.clientWidth * index * (document.dir === 'rtl' ? -1 : 1), behavior: smooth && !reduce ? 'smooth' : 'auto' });
      };
      const mark = () => {
        const i = Math.round(Math.abs(track.scrollLeft) / track.clientWidth);
        index = i;
        dots.forEach((d, n) => {
          d.toggleAttribute('data-active', n === i);
          if (n === i) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
        });
      };
      const stop = () => { clearInterval(timer); timer = null; };
      const start = () => { if (timer || slides.length < 2) return; timer = setInterval(() => go(index + 1), 7000); };
      const restart = () => { stop(); start(); };
      let raf = 0;
      track.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(mark); }, { passive: true });
      dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.heroDot)); restart(); }));
      root.querySelector('[data-hero-prev]')?.addEventListener('click', () => { go(index - 1); restart(); });
      root.querySelector('[data-hero-next]')?.addEventListener('click', () => { go(index + 1); restart(); });
      track.addEventListener('touchstart', stop, { passive: true });
      track.addEventListener('touchend', restart, { passive: true });
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();
    })();
  </script>
  <div class="relative z-10 mx-4 -mt-10 flex max-w-[960px] md:mx-auto md:w-[calc(100%-4rem)] flex-col items-center rounded-[28px] bg-white px-5 pt-8 pb-7 text-center shadow-[0_6px_0_#efdcd2,0_18px_40px_rgba(110,74,62,.1)] md:-mt-16 md:px-12 md:pt-10">
    {% block 'text', variant: 'sm', class: 'mb-3 rounded-full bg-sky-soft px-4 py-1 text-[12px]! font-bold uppercase tracking-[0.14em] text-[#4a3530]' %}{{ 'mp.hero_eyebrow' | t }}{% endblock %}
    {% block 'heading', tag: 'h1', variant: 'xl', class: 'font-extrabold leading-[1.05] tracking-tight text-balance text-[#4a3530] text-[34px]! md:text-[clamp(40px,4.4vw,60px)]!', attributes: 'id="home-hero-heading"' %}{{ 'mp.hero_heading' | t }} <span class="italic text-accent">{{ 'mp.hero_heading_accent' | t }}</span>{% endblock %}
    {% block 'text', class: 'mt-4 mb-6 max-w-[620px] leading-[1.7] text-on-surface-secondary' %}{{ 'mp.hero_body' | t }}{% endblock %}
    <div class="flex flex-wrap items-center justify-center gap-3">
      {% block 'button', url: all_url, variant: 'button-primary', class: 'h-12 rounded-full px-8 font-heading text-[15px] font-bold shadow-[0_4px_0_#7f4a38] motion-safe:hover:-translate-y-0.5' %}{{ 'mp.hero_cta_shop' | t }}{% endblock %}
      {% block 'button', url: domina_url, variant: 'button-secondary', class: 'h-12 rounded-full border-2 border-[#e9d3c8] bg-white px-8 font-heading text-[15px] font-bold text-[#4a3530] hover:bg-sage' %}{{ 'mp.hero_cta_domina' | t }}{% endblock %}
    </div>
  </div>
{% endblock %}

{%- comment -%} Marquee: a moving ribbon of what Ponyo offers. {%- endcomment -%}
{% style %}
  @keyframes ponyo-wiggle { 0%, 100% { transform: rotate(0deg); } 25% { transform: rotate(-4deg); } 75% { transform: rotate(4deg); } }
{% endstyle %}
{%- comment -%} Marks where the falling stars fade out (the old marquee band sat here). {%- endcomment -%}
{%- comment -%} Store-at-a-glance numbers between the hero and the category bar. Counts come live from the catalog. {%- endcomment -%}
{%- liquid
  assign stat_all = collections.all.products_count
  assign stat_rare = collections['rare-finds'].products_count | default: 0
  assign stat_xl = collections['domina-xl'].products_count | default: 0
  assign stat_premium = collections['premium'].products_count | default: 0
-%}
<div data-sparkle-end class="mx-auto mt-8 w-full max-w-[960px] px-4 md:mt-10" data-stats>
  <ul role="list" class="grid grid-cols-2 gap-2.5 md:grid-cols-4 md:gap-4">
    {%- capture stat_items -%}{{ stat_all }}|{{ routes.all_products_collection_url }}|home.stats.all|bg-[#fdf0f2]|🧸^^{{ stat_rare }}|{{ collections['rare-finds'].url }}|home.stats.rare|bg-[#2e211d] text-white|💎^^{{ stat_premium }}|{{ collections['premium'].url }}|home.stats.premium|bg-[#dbe9f5]|✨^^120|{{ pages['domina-xl'].url | default: collections['domina-xl'].url }}|home.stats.xl|bg-[#f6c453]|📏{%- endcapture -%}
    {%- assign stat_list = stat_items | split: '^^' -%}
    {%- for item in stat_list -%}
      {%- assign st = item | split: '|' -%}
      {%- if st[0] == '0' -%}{%- continue -%}{%- endif -%}
      <li>
        <a href="{{ st[1] }}" class="group/stat flex h-full items-center gap-3 rounded-[20px] {{ st[3] }} px-4 py-3.5 no-underline text-[#3a2b26]{% if st[3] contains 'text-white' %} text-white!{% endif %} motion-safe:transition motion-safe:hover:-translate-y-1 hover:shadow-[0_10px_22px_rgba(110,74,62,.16)] md:px-5 md:py-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white/70 text-[20px] motion-safe:group-hover/stat:animate-[ponyo-wiggle_.8s_ease-in-out]{% if st[3] contains 'text-white' %} bg-white/15{% endif %}" aria-hidden="true">{{ st[4] }}</span>
          <span class="flex min-w-0 flex-col leading-tight">
            <span class="font-heading text-[24px] font-extrabold md:text-[28px]"><span data-count-to="{{ st[0] }}">{{ st[0] }}</span>{% if forloop.last %}<span class="text-[15px]"> cm</span>{% endif %}</span>
            <span class="text-[12px] font-semibold opacity-80 md:text-[13px]">{{ st[2] | t }}</span>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>
<script>
  (() => {
    const root = document.querySelector('[data-stats]');
    if (!root || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const nums = root.querySelectorAll('[data-count-to]');
    const run = () => nums.forEach((el) => {
      const to = parseInt(el.dataset.countTo, 10) || 0;
      const t0 = performance.now();
      const step = (now) => {
        const k = Math.min(1, (now - t0) / 1100);
        el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3)));
        if (k < 1) requestAnimationFrame(step);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    });
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { run(); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(root);
  })();
</script>

