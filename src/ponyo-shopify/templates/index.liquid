    {% block 'link', url: shelf_hot.url, class: 'min-h-0! rounded-full border-2 border-[#e9d3c8] bg-white text-[#4a3530]! hover:bg-[#f3ece7]! px-4 py-2 font-heading text-[13.5px]! font-bold no-underline!' %}{{ 'home.v2.see_all' | t }} →{% endblock %}
  </div>
  <ul role="list" class="grid grid-cols-2 gap-2 md:grid-cols-4 lg:grid-cols-6 md:gap-2.5">
