      <span class="flex flex-col gap-1"><span class="text-[13px] font-bold uppercase tracking-[0.08em] opacity-75">{{ 'home.v2.budget_2_label' | t }}</span><span class="font-heading text-[30px] font-extrabold leading-none md:text-[40px]">{{ b20 }}–{{ b30 }}</span></span>
      <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-white font-bold motion-safe:transition-transform group-hover/b:translate-x-1 md:self-end" aria-hidden="true">→</span>
    </a></li>
    <li><a href="{{ budget_base }}gte=60000" class="group/b flex h-full items-center justify-between gap-4 rounded-[24px] bg-[#f6c453] p-5 text-[#2e211d] no-underline motion-safe:transition motion-safe:hover:-translate-y-1 hover:shadow-[0_14px_30px_rgba(46,33,29,.18)] md:flex-col md:items-start md:p-7">
      <span class="flex flex-col gap-1"><span class="text-[13px] font-bold uppercase tracking-[0.08em] opacity-75">{{ 'home.v2.budget_3_label' | t }}</span><span class="font-heading text-[30px] font-extrabold leading-none md:text-[40px]">{{ b60 }}+</span></span>
      <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-white font-bold motion-safe:transition-transform group-hover/b:translate-x-1 md:self-end" aria-hidden="true">→</span>
