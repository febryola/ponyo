{%- comment -%} Domina XL landing page. Assign this template to a page (e.g. "Domina XL") to use it. {%- endcomment -%}
{%- liquid
  assign domina_hero_image = images['ponyo-3.png']
  assign domina_collection = collections['domina-xl']
  if domina_collection == blank or domina_collection.products_count == 0
    assign domina_collection = collections.all
  endif
-%}

{%- comment -%} Forest hero with room-scale image. {%- endcomment -%}
{% block 'container', class: 'relative isolate overflow-hidden bg-linear-135 from-[#7a524b] via-[#a87272] to-[#c99192]', attributes: 'aria-labelledby="domina-page-title"' %}
  <div class="pointer-events-none absolute inset-0 text-gold" aria-hidden="true">
    <span class="absolute top-10 left-[8%] size-5"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
    <span class="absolute bottom-12 left-[42%] size-4"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
    <span class="absolute top-14 right-[6%] size-6"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
  </div>
  <div class="relative mx-auto grid max-w-page items-center gap-10 px-margin py-14 md:grid-cols-2 md:py-20">
    <div class="flex flex-col items-start">
      {% block 'text', variant: 'sm', class: 'mb-3 font-heading text-[15px]! font-bold tracking-wide text-[#f6d6c8]' %}{{ 'home.domina_page.eyebrow' | t }}{% endblock %}
      {% block 'heading', tag: 'h1', variant: 'xl', class: 'mb-4 font-extrabold tracking-tight text-white text-5xl! md:text-[68px]!', attributes: 'id="domina-page-title"' %}{%- if page.title != blank -%}{{ page.title | escape }}{%- else -%}{{ 'home.domina_page.title' | t }}{%- endif -%}{% endblock %}
      {% block 'text', class: 'mb-7 max-w-[440px] text-[16px]! text-[#f8ebe5]' %}{{ 'home.domina_page.sub' | t }}{% endblock %}
      {% block 'button', url: '#domina-products', variant: 'custom', class: 'h-12 rounded-button bg-white! px-7 font-heading text-[15px] font-extrabold text-forest! hover:bg-[#f6d6c8]!' %}{{ 'home.domina_page.cta' | t }}{% endblock %}
    </div>
    <div class="mx-auto w-full max-w-[520px] overflow-hidden rounded-t-[46%] rounded-b-xl bg-[#fbf1ea] shadow-[0_18px_42px_rgba(0,0,0,.2)] [&_img]:size-full [&_img]:object-cover">
      {% block 'image', fallback_image: domina_hero_image, aspect_ratio: 'aspect-[4/5]', alt: 'An oversized bunny plush shown beside a person for scale', sizes: '(min-width: 768px) 520px, 90vw', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
    </div>
  </div>
{% endblock %}

{%- comment -%} Trust row: scale, details, prices, delivery. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-8', attributes: 'aria-label="Domina XL details"' %}
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-2 rounded-[11px] border border-border bg-white p-5 shadow-[0_5px_18px_rgba(110,74,62,.055)]">
        <span class="flex size-10 items-center justify-center rounded-full bg-sage font-heading font-extrabold text-accent" aria-hidden="true">↕</span>
        {% block 'text', tag: 'h3', class: 'font-heading text-base! font-extrabold text-[#4a3530]' %}{{ 'home.domina_page.scale_title' | t }}{% endblock %}
        {% block 'text', variant: 'sm', class: 'text-[13px]! text-on-surface-secondary' %}{{ 'home.domina_page.scale_body' | t }}{% endblock %}
      </div>
      <div class="flex flex-col gap-2 rounded-[11px] border border-border bg-white p-5 shadow-[0_5px_18px_rgba(110,74,62,.055)]">
        <span class="flex size-10 items-center justify-center rounded-full bg-sage font-heading font-extrabold text-accent" aria-hidden="true">♡</span>
        {% block 'text', tag: 'h3', class: 'font-heading text-base! font-extrabold text-[#4a3530]' %}{{ 'home.domina_page.details_title' | t }}{% endblock %}
        {% block 'text', variant: 'sm', class: 'text-[13px]! text-on-surface-secondary' %}{{ 'home.domina_page.details_body' | t }}{% endblock %}
      </div>
      <div class="flex flex-col gap-2 rounded-[11px] border border-border bg-white p-5 shadow-[0_5px_18px_rgba(110,74,62,.055)]">
        <span class="flex size-10 items-center justify-center rounded-full bg-sage font-heading font-extrabold text-accent" aria-hidden="true">¥</span>
        {% block 'text', tag: 'h3', class: 'font-heading text-base! font-extrabold text-[#4a3530]' %}{{ 'home.domina_page.compare_title' | t }}{% endblock %}
        {% block 'text', variant: 'sm', class: 'text-[13px]! text-on-surface-secondary' %}{{ 'home.domina_page.compare_body' | t }}{% endblock %}
      </div>
      <div class="flex flex-col gap-2 rounded-[11px] border border-border bg-white p-5 shadow-[0_5px_18px_rgba(110,74,62,.055)]">
        <span class="flex size-10 items-center justify-center rounded-full bg-sage font-heading font-extrabold text-accent" aria-hidden="true">↗</span>
        {% block 'text', tag: 'h3', class: 'font-heading text-base! font-extrabold text-[#4a3530]' %}{{ 'home.domina_page.delivery_title' | t }}{% endblock %}
        {% block 'text', variant: 'sm', class: 'text-[13px]! text-on-surface-secondary' %}{{ 'home.domina_page.delivery_body' | t }}{% endblock %}
      </div>
  </div>
{% endblock %}

{%- comment -%} Shop Domina XL grid: products from the "domina-xl" collection when it exists, samples while the catalog is empty. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-8', attributes: 'id="domina-products" aria-labelledby="domina-products-title"' %}
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      {% block 'text', variant: 'sm', class: 'font-bold text-accent' %}{{ 'home.domina_shelf.eyebrow' | t }}{% endblock %}
      {% block 'heading', tag: 'h2', variant: 'sm', class: 'font-extrabold tracking-tight text-[#4a3530] text-[26px]! md:text-[30px]!', attributes: 'id="domina-products-title"' %}{{ 'home.domina_shelf.title' | t }}{% endblock %}
    </div>
  </div>
  <ul role="list" class="grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
    {%- if shop.products_count == 0 -%}
      {%- assign domina_items = 'maker-bear.jpg|Hoshi Cloud Bear XL — 90cm|90 cm · XL plush|6800000|Cream teddy bear plush^^ponyo-3.png|Haneul Bunny XL — 100cm|100 cm · XL plush|7450000|Oversized cream bunny plush^^ponyo-6.png|Baluran Elephant XL — 120cm|120 cm · XL plush|8900000|Oversized elephant-style plush^^ponyo-7.png|Clément the Fox XL — 70cm|70 cm · XL plush|7120000|Oversized fox-style plush^^maker-chick.jpg|Chim Sẻ Sparrow XL — 60cm|60 cm · XL plush|5900000|Round sunny sparrow plush^^ponyo-5.png|Otto the Mohair Bear XL — 80cm|80 cm · XL plush|8200000|Close-up of a soft mohair teddy bear plush' | split: '^^' -%}
      {%- for item in domina_items -%}
        {%- assign f = item | split: '|' -%}
        {%- assign tile_image = images[f[0]] -%}
        <li class="h-full">
          {% block 'card', block.name: 't:blocks.product_card', url: routes.all_products_collection_url, aria_label: f[1], class: 'h-full border border-[#efe1d8] bg-white p-2.5 md:p-3 motion-safe:transition hover:border-[#e2c8bb] hover:shadow-[0_12px_26px_rgba(110,74,62,.12)]', border_radius: 'rounded-[18px]', alignment: 'text-start' %}
            <div class="relative mb-3 overflow-hidden rounded-[16px] bg-[#fbf3ec]">
              {% block 'image', fallback_image: tile_image, aspect_ratio: 'aspect-square', alt: f[4], sizes: '(min-width: 768px) 380px, 45vw', class: 'object-cover object-[center_30%]', attributes: 'loading="lazy"' %}{% endblock %}
            </div>
            {% block 'text', tag: 'h3', class: 'line-clamp-2 text-[14px]! font-semibold leading-snug text-[#3f302b]' %}{{ f[1] }}{% endblock %}
            {% block 'text', variant: 'sm', class: 'text-xs! font-bold text-accent' %}{{ f[2] }}{% endblock %}
            <div class="mt-auto flex items-center pt-1">
              {% block 'text', class: 'font-heading text-base! font-extrabold text-[#4a3530]' %}{{ f[3] | plus: 0 | money_without_trailing_zeros }}{% endblock %}
            </div>
          {% endblock %}
        </li>
      {%- endfor -%}
    {%- else -%}
      {%- for product in domina_collection.products limit: 6 -%}
        {%- assign card_variant = product.selected_or_first_available_variant -%}
        <li class="h-full">
          {% block 'card', block.name: 't:blocks.product_card', url: product.url, aria_label: product.title, class: 'h-full border border-[#efe1d8] bg-white p-2.5 md:p-3 motion-safe:transition hover:border-[#e2c8bb] hover:shadow-[0_12px_26px_rgba(110,74,62,.12)]', border_radius: 'rounded-[18px]', alignment: 'text-start' %}
            <a href="{{ product.url | escape }}" class="relative mb-3 block overflow-hidden rounded-[16px] bg-[#fbf3ec]" aria-label="{{ product.title | escape }}">
              {% block 'image', fallback_image: product.featured_image, aspect_ratio: 'aspect-square', alt: product.title, sizes: '(min-width: 768px) 380px, 45vw', attributes: 'loading="lazy"' %}{% endblock %}
            </a>
            {% block 'text', tag: 'h3', class: 'line-clamp-2 text-[14px]! font-semibold leading-snug text-[#3f302b]' %}{{ product.title | escape }}{% endblock %}
            <div class="mt-auto flex items-center pt-1">
              {% block 'price', price: card_variant.price, compare_at_price: card_variant.compare_at_price, price_min: product.price_min, price_max: product.price_max, class: 'font-heading text-base font-extrabold text-[#4a3530]' %}{% endblock %}
            </div>
          {% endblock %}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
{% endblock %}

{% render 'explore-strip' %}
