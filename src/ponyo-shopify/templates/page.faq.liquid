{%- comment -%} FAQ & Shipping: customer questions grouped by topic, with a size guide and contact prompt. Assign this template to the FAQ page. {%- endcomment -%}
{%- liquid
  assign page_heading = 'pg.faq.title' | t
  if page.title != blank
    assign page_heading = page.title
  endif
  assign help_url = routes.root_url | append: 'pages/contact'
-%}

{%- comment -%} Header with topic shortcuts. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'pt-6 pb-6 md:pt-10', attributes: 'aria-labelledby="faq-title"' %}
  <div class="flex flex-col items-center rounded-[28px] bg-white px-6 py-10 text-center shadow-[0_6px_0_#efdcd2,0_18px_40px_rgba(110,74,62,.08)] md:py-14">
    <nav aria-label="{{ 'mp.breadcrumb' | t | escape }}" class="mb-3 text-[13px] text-on-surface-secondary">
      <ol role="list" class="flex flex-wrap items-center justify-center gap-1.5">
        <li>{% block 'link', url: routes.root_url, class: 'min-h-0! text-[13px]! text-on-surface-secondary! no-underline! hover:underline!' %}{{ 'mp.home' | t }}{% endblock %}</li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="font-semibold text-[#4a3530]">{{ page_heading | escape }}</li>
      </ol>
    </nav>
    {% block 'heading', tag: 'h1', variant: 'xl', class: 'font-bold tracking-normal text-[#4a3530] text-[32px]! md:text-[46px]!', attributes: 'id="faq-title"' %}{{ page_heading | escape }}{% endblock %}
    {% block 'text', class: 'mt-3 max-w-[560px] leading-relaxed text-on-surface-secondary' %}{{ 'pg.faq.sub' | t }}{% endblock %}
    <nav aria-label="{{ 'pg.faq.topics' | t | escape }}" class="mt-6">
      <ul role="list" class="flex flex-wrap justify-center gap-2">
        <li><a href="#faq-ordering" class="inline-flex rounded-full border border-[#e9d3c8] bg-[#fffaf5] px-4 py-1.5 text-[13.5px] font-semibold text-[#4a3530] no-underline hover:bg-sage">{{ 'pg.faq.ordering_title' | t }}</a></li>
        <li><a href="#faq-shipping" class="inline-flex rounded-full border border-[#e9d3c8] bg-[#fffaf5] px-4 py-1.5 text-[13.5px] font-semibold text-[#4a3530] no-underline hover:bg-sage">{{ 'pg.faq.shipping_title' | t }}</a></li>
        <li><a href="#faq-sizes" class="inline-flex rounded-full border border-[#e9d3c8] bg-[#fffaf5] px-4 py-1.5 text-[13.5px] font-semibold text-[#4a3530] no-underline hover:bg-sage">{{ 'pg.faq.sizes_title' | t }}</a></li>
        <li><a href="#faq-care" class="inline-flex rounded-full border border-[#e9d3c8] bg-[#fffaf5] px-4 py-1.5 text-[13.5px] font-semibold text-[#4a3530] no-underline hover:bg-sage">{{ 'pg.faq.care_title' | t }}</a></li>
        <li><a href="#faq-help" class="inline-flex rounded-full border border-[#e9d3c8] bg-[#fffaf5] px-4 py-1.5 text-[13.5px] font-semibold text-[#4a3530] no-underline hover:bg-sage">{{ 'pg.faq.help_title' | t }}</a></li>
      </ul>
    </nav>
  </div>
{% endblock %}

{%- comment -%} Question groups as native disclosures. {%- endcomment -%}
