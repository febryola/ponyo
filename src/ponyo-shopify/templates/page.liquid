{%- comment -%} Ponyo page: banner then content on a white card. {%- endcomment -%}
{% block 'container', class: 'w-full' %}
  {%- comment -%} Ponyo page banner: sage wash with gold sparkles. {%- endcomment -%}
  <div class="relative isolate mb-8 overflow-hidden bg-linear-[112deg] from-sage via-[#fbf3ec] to-oat">
    <div class="pointer-events-none absolute inset-0 text-gold" aria-hidden="true">
      <span class="absolute top-6 left-[12%] size-4"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
      <span class="absolute bottom-8 left-[30%] size-3"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
      <span class="absolute top-10 right-[14%] size-5"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
      <span class="absolute bottom-6 right-[30%] size-3"><svg viewBox="0 0 32 32" class="size-full"><path d="M16 1.5 19.7 12l10.8 4-10.8 3.8L16 30.5l-3.8-10.7L1.5 16l10.7-4L16 1.5Z" fill="currentColor"/></svg></span>
    </div>
    <div class="relative mx-auto flex max-w-page flex-col items-center gap-3 px-margin py-12 text-center md:py-16">
      {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold tracking-tight text-balance text-[#4a3530] text-4xl! md:text-5xl!' %}{{ page.title | escape }}{% endblock %}
      {% block 'text', class: 'max-w-xl text-on-surface-secondary' %}{{ 'home.pages.page_sub' | t }}{% endblock %}
    </div>
  </div>
{% endblock %}

{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-8' %}
  <div class="mx-auto max-w-3xl rounded-xl border border-border bg-white p-6 shadow-[0_5px_18px_rgba(110,74,62,.055)] md:p-10">
    <h2 class="sr-only">{{ 'page.content_heading' | t }}</h2>
    {%- if page.content != blank -%}
      <div class="richtext leading-relaxed text-on-surface [&_h2]:font-heading [&_h2]:font-extrabold [&_h2]:text-[#4a3530] [&_h3]:font-heading [&_h3]:font-extrabold [&_h3]:text-[#4a3530] [&_a]:text-accent">{{ page.content }}</div>
    {%- endif -%}
  </div>
{% endblock %}

{% render 'recently-viewed' %}
{% render 'explore-strip' %}
