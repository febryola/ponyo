{% block 'container', class: 'w-full max-w-page mx-auto px-margin' %}
  {%- assign product_title = product.title -%}
  {%- if product_title == blank -%}
    {%- assign product_title = 'product.placeholder_title' | t -%}
  {%- endif -%}
  <s-view-event class="block pb-4" view-event-trigger="connect" view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
  <nav aria-label="Breadcrumb" class="py-5 text-[13px] text-on-surface-secondary">
    <ol role="list" class="flex flex-wrap items-center gap-1.5">
      <li><a href="{{ routes.root_url }}" class="hover:text-accent">{{ 'home.pages.breadcrumb_home' | t }}</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="{{ routes.all_products_collection_url }}" class="hover:text-accent">{{ 'home.pages.breadcrumb_shop' | t }}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="font-semibold text-on-surface">{%- if shop.products_count == 0 and product.title == blank -%}Haneul Bunny XL{%- else -%}{{ product_title | escape }}{%- endif -%}</li>
    </ol>
  </nav>
  {%- comment -%} Product Detail: 60/40 Split {%- endcomment -%}
  <div class="grid grid-cols-1 gap-6 mb-16 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10 lg:grid-cols-[minmax(0,440px)_minmax(0,1fr)] lg:gap-12 xl:grid-cols-[minmax(0,480px)_minmax(0,1fr)]">
    {%- comment -%} Left: medium image gallery (about 40%) {%- endcomment -%}
    <s-product-image-zoom class="block md:col-start-1 md:row-start-1">
        {%- liquid
          # The product grid gives the gallery 5/12 of the width on tablets, 440px from 1024px and 480px from 1280px.
          # Mirror this media-count branch in snippets/lcp-preload.liquid; mobile stays full bleed.
          if product.media.size > 2
            assign gallery_sizes = '(min-width: 1280px) 240px, (min-width: 1024px) 220px, (min-width: 768px) calc((100vw - 112px) * 5 / 24), 100vw'
          else
            assign gallery_sizes = '(min-width: 1280px) 480px, (min-width: 1024px) 440px, (min-width: 768px) calc((100vw - 112px) * 5 / 12), 100vw'
          endif
        -%}
        {%- comment -%} One media loop scrolls horizontally on mobile and becomes the contained desktop grid. Native media controls own keyboard focus so the desktop gallery adds no redundant tab stop. {%- endcomment -%}
        <div
          data-product-gallery
          {% if product.media != blank %}role="region" aria-label="{{ product_title | escape }}"{% endif %}
          class="mx-[calc(-1*var(--spacing-margin)-max(0px,(100vw-var(--spacing-page))/2))] w-[calc(100%+2*var(--spacing-margin)+max(0px,100vw-var(--spacing-page)))] flex snap-x snap-mandatory overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden md:mx-0 md:grid md:w-auto md:snap-none md:overflow-visible md:gap-3 md:[&>*]:overflow-hidden md:[&>*]:rounded-[22px] {% if product.media.size > 2 %}md:grid-cols-2{% endif %}"
        >
          {% if product.media == blank %}
            {%- if shop.products_count == 0 -%}
              {%- comment -%} Sample plush shown only while the catalog is empty. {%- endcomment -%}
              {%- assign sample_product_image = images['ponyo-3.png'] -%}
              <div class="shrink-0 snap-center w-full overflow-hidden bg-white md:rounded-[11px] md:border md:border-border">
                {% block 'image', fallback_image: sample_product_image, aspect_ratio: 'aspect-square', alt: 'Oversized cream bunny plush shown at room scale', sizes: '(min-width: 1280px) 480px, (min-width: 768px) 42vw, 100vw', class: 'md:aspect-square', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
              </div>
            {%- else -%}
              {% render 'placeholder-texture', kind: 'product', seed: 1, class: 'shrink-0 snap-center w-full aspect-square contain-paint md:aspect-square', aria_label: product_title %}
            {%- endif -%}
          {% endif %}
          {% for media in product.media %}
            <div class="shrink-0 snap-center w-full contain-paint">
              {%- if media.media_type == 'image' -%}
                {%- liquid
                  assign image_label = media.alt | default: media.preview_image.alt | default: product_title
                  assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
                -%}
                <div class="aspect-square overflow-hidden bg-surface-secondary {% if product.media.size == 1 %}md:aspect-square{% endif %}">
                  <button
                    type="button"
                    commandfor="{{ zoom_dialog_id }}"
                    command="show-modal"
                    data-zoom-preload
                    aria-haspopup="dialog"
                    aria-controls="{{ zoom_dialog_id }}"
                    aria-label="{{ 'product.view_image' | t: title: image_label | escape }}"
                    class="group block size-full cursor-zoom-in bg-surface-secondary p-0 motion-safe:transition-transform motion-safe:active:scale-[0.97] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent"
                  >
                    {%- if forloop.first -%}
                      {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, class: 'motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.03]', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                    {%- else -%}
                      {% block 'image', image: media, alt: image_label, sizes: gallery_sizes, class: 'motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.03]', attributes: 'loading="lazy"' %}{% endblock %}
                    {%- endif -%}
                  </button>
                </div>
              {%- elsif media.media_type == 'video' -%}
                <div class="aspect-square overflow-hidden {% if product.media.size == 1 %}md:aspect-square{% endif %}">
                  {% block 'video', video: media, class: 'size-full object-cover' %}{% endblock %}
                </div>
              {%- elsif media.media_type == 'external_video' -%}
                {%- liquid
                  assign external_youtube_id = ''
                  assign external_vimeo_id = ''
                  if media.host == 'youtube'
                    assign external_youtube_id = media.external_id
                  elsif media.host == 'vimeo'
                    assign external_vimeo_id = media.external_id
                  endif
                  assign external_video_label = media.alt | default: media.preview_image.alt | default: product_title
                -%}
                <div class="aspect-square overflow-hidden {% if product.media.size == 1 %}md:aspect-square{% endif %}">
                  {% block 'video', youtube_id: external_youtube_id, vimeo_id: external_vimeo_id, class: 'size-full object-cover' %}
                    {%- if forloop.first -%}
                      {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="eager" fetchpriority="high"' %}{% endblock %}
                    {%- else -%}
                      {% block 'image', fallback_image: media.preview_image, alt: external_video_label, sizes: gallery_sizes, placeholder_kind: 'surface', attributes: 'loading="lazy"' %}{% endblock %}
                    {%- endif -%}
                  {% endblock %}
                </div>
              {%- endif -%}
            </div>
          {% endfor %}
        </div>

        {%- assign zoom_widths = '750,1100,1500,2000,2400' | split: ',' -%}
        {% for media in product.media %}
          {%- if media.media_type == 'image' -%}
            {%- liquid
              assign zoom_image = media.preview_image | default: media
              assign image_label = media.alt | default: zoom_image.alt | default: product_title
              assign zoom_dialog_id = 'product-image-zoom-' | append: media.id
              assign zoom_title_id = zoom_dialog_id | append: '-title'
            -%}
            {%- capture zoom_srcset -%}
              {%- for width in zoom_widths -%}
                {%- assign image_width = width | strip | plus: 0 -%}
                {{ zoom_image | image_url: width: image_width }} {{ image_width }}w{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- comment -%} Gallery commands open a full-bleed, fade-only surface: no closed transform and no extra backdrop dimming. {%- endcomment -%}
            <s-dialog>
              <dialog id="{{ zoom_dialog_id }}" class="overlay-panel [--panel-backdrop:transparent] fixed inset-0 w-screen h-dvh rounded-none bg-overlay text-surface shadow-none" aria-labelledby="{{ zoom_title_id }}">
                <div class="relative flex size-full items-center justify-center">
                  <h2 id="{{ zoom_title_id }}" class="sr-only">{{ 'product.image_zoom' | t }}</h2>
                  {%- comment -%} Zoom media stays full bleed; only the close control moves inside the safe viewport. {%- endcomment -%}
                  {%- capture zoom_close_button_attrs -%}aria-label="{{ 'general.close' | t | escape }}"{%- endcapture -%}
                  {% block 'button', commandfor: zoom_dialog_id, command: 'close', variant: 'button-ghost', class: 'absolute z-10 size-touch-target rounded-full bg-overlay-subtle text-surface hover:bg-overlay-strong inset-bs-[max(1rem,var(--safe-area-inset-top))] inset-e-[max(1rem,var(--safe-area-inset-inline-end))]', attributes: zoom_close_button_attrs %}<span class="inline-flex items-center justify-center shrink-0 size-5" aria-hidden="true">{{- 'icon-x.svg' | inline_asset_content -}}</span>{% endblock %}
                  <img
                    src="{{ zoom_image | image_url: width: 1500 }}"
                    srcset="{{ zoom_srcset | strip }}"
                    sizes="100vw"
                    loading="lazy"
                    alt="{{ image_label | escape }}"
                    width="{{ zoom_image.width }}"
                    height="{{ zoom_image.height }}"
                    class="size-full object-contain"
                    data-zoom-image
                  >
                </div>
              </dialog>
            </s-dialog>
          {%- endif -%}
        {% endfor %}
      </s-product-image-zoom>
      <script type="module" src="{{ 's-product-image-zoom.js' | asset_url }}"></script>

    {%- comment -%} Right: buy box (title, price, size, add to cart, alerts) {%- endcomment -%}
    {%- comment -%} The product-title and product-form partials declared below are fetched by s-variant-picker.js on product-page variant changes — keep both partial names stable. {%- endcomment -%}
    {%- assign current_variant = product.selected_or_first_available_variant -%}

    <div class="flex flex-col gap-6 md:col-start-2 md:row-span-2 md:row-start-1 md:sticky md:top-32 md:self-start">
      {% partial 'product-title' %}
      <div class="pt-4 md:pt-8">
        {%- if shop.products_count == 0 -%}
          {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold tracking-tight text-[#4a3530] text-4xl! md:text-[44px]!' %}Haneul Bunny XL{% endblock %}
          {% block 'text', variant: 'sm', class: 'mt-2 font-bold text-on-surface-secondary' %}100 cm · XL plush{% endblock %}
          <div class="mt-4" data-product-price>
            {% block 'text', variant: 'lg', class: 'font-heading text-2xl! font-extrabold text-[#4a3530]' %}{{ 7450000 | money_without_trailing_zeros }}{% endblock %}
          </div>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-sky-soft px-3.5 py-1.5 text-[13px] font-semibold text-[#4a3530]"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>Ships in 7-10 business days</p>
        {%- else -%}
          {%- liquid
            assign status_value = product.metafields.ponyo.availability_status.value
            assign status_class = 'bg-sage text-[#2f4a32]'
            if status_value == 'Coming Soon'
              assign status_label = 'marketplace.status_coming_soon' | t
              assign status_class = 'bg-sky-soft text-[#2c4256]'
            elsif current_variant.available == false
              assign status_label = 'marketplace.status_sold_out' | t
              assign status_class = 'bg-[#efe6e1] text-[#5b463f]'
            elsif status_value == 'Limited'
              assign status_label = 'marketplace.status_limited' | t
              assign status_class = 'bg-[#fde3cf] text-[#7a3d14]'
            else
              assign status_label = 'marketplace.status_available' | t
            endif
            assign rarity_value = product.metafields.ponyo.rarity.value
          -%}
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="rounded-full px-3 py-1 text-[12px] font-bold {{ status_class }}">{{ status_label }}</span>
            {%- if rarity_value != blank -%}
              <span class="rounded-full bg-[#4a3530] px-3 py-1 text-[12px] font-bold text-white">{{ rarity_value | escape }}</span>
            {%- endif -%}
          </div>
          <div class="flex items-start justify-between gap-3">
            {% block 'heading', tag: 'h1', variant: 'lg', class: 'font-extrabold tracking-tight text-[#4a3530] text-4xl! md:text-[44px]!' %}{{ product_title | escape }}{% endblock %}
            {% render 'wishlist-button', product: product, class: 'mt-1 size-11! border-2 border-[#efe1d8] shadow-none' %}
          </div>
          <div class="mt-2">{% render 'rating-stars', product: product, size: 'md' %}</div>
          <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-on-surface-secondary">
            {%- if product.vendor != blank -%}<span>{{ 'marketplace.brand' | t }}: <span class="font-semibold text-[#4a3530]">{{ product.vendor | escape }}</span></span>{%- endif -%}
            {%- if current_variant.sku != blank -%}<span>{{ 'marketplace.sku' | t }}: <span class="font-semibold text-[#4a3530]">{{ current_variant.sku | escape }}</span></span>{%- endif -%}
          </p>
          <div class="mt-4" data-product-price>
            {% block 'price', price: current_variant.price, compare_at_price: current_variant.compare_at_price, variant: 'body-lg', class: 'font-heading font-extrabold text-[#4a3530]' %}{% endblock %}
          </div>
          {%- if product.metafields.ponyo.dispatch_time != blank -%}
            <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-sky-soft px-3.5 py-1.5 text-[13px] font-semibold text-[#4a3530]"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>{{ product.metafields.ponyo.dispatch_time.value | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
      {% endpartial %}

      {%- comment -%} === PRODUCT FORM (commerce-critical) ===
        This {% partial 'product-form' %} region is swapped by s-variant-picker.js on variant change.
        The partial name, the {% form %} tag, and the hidden input[name="id"] are all load-bearing —
        removing or renaming any of them breaks add-to-cart and variant switching.
        <s-product-form> wraps the form so add-to-cart calls Shopify.actions.updateCart
        with the selected variant/quantity while preserving the native product form
        action as the no-JS fallback. standard-actions-override.js keeps the cart
        update on-page by refreshing <s-cart> partials; <s-product-form> then opens
        the drawer with Shopify.actions.openCart(). {%- endcomment -%}
      {%- comment -%} Size switcher: links this plush to its other sizes (for example the Domina XL version) by matching the base product name. {%- endcomment -%}
      {%- liquid
        assign size_base = product.title | remove: ' XL' | remove: ' Giant' | strip | downcase
        assign size_matches = 0
        for candidate in collections.all.products limit: 250
          assign candidate_base = candidate.title | remove: ' XL' | remove: ' Giant' | strip | downcase
          if candidate_base == size_base
            if candidate.id == product.id or candidate.metafields.ponyo.size_tier != blank
              assign size_matches = size_matches | plus: 1
            endif
          endif
        endfor
      -%}
      {%- if size_matches > 1 -%}
        <div class="mb-5" role="group" aria-labelledby="size-switch-label">
          <p id="size-switch-label" class="mb-2 text-sm font-bold text-[#4a3530]">{{ 'marketplace.choose_size' | t }}</p>
          <ul role="list" class="m-0 flex list-none flex-wrap gap-2 p-0">
            {%- for candidate in collections.all.products limit: 250 -%}
              {%- assign candidate_base = candidate.title | remove: ' XL' | remove: ' Giant' | strip | downcase -%}
              {%- if candidate_base != size_base -%}{%- continue -%}{%- endif -%}
              {%- if candidate.id != product.id and candidate.metafields.ponyo.size_tier == blank -%}{%- continue -%}{%- endif -%}
              {%- assign candidate_tier = candidate.metafields.ponyo.size_tier.value | default: candidate.title -%}
              {%- assign candidate_dims = candidate.metafields.ponyo.dimensions.value -%}
              <li>
                <a href="{{ candidate.url }}" {% if candidate.id == product.id %}aria-current="true"{% endif %} class="flex min-w-[112px] flex-col rounded-[14px] border-2 px-3.5 py-2 no-underline motion-safe:transition {% if candidate.id == product.id %}border-[#a2502f] bg-[#fff7f1]{% else %}border-[#e8dfd9] bg-white hover:border-[#c9a596]{% endif %}">
                  <span class="text-[14px] font-bold text-[#3f302b]">{{ candidate_tier | escape }}{% if candidate_dims != blank %} · {{ candidate_dims | escape }}{% endif %}</span>
                  <span class="text-[13px] font-semibold text-accent">{{ candidate.price | money }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <s-product-form class="block" data-product-form data-product-id="{{ product.id }}" data-error-message="{{ 'cart.update_error' | t | escape }}">
        {% partial 'product-form' %}
        {%- comment -%} Read by s-variant-picker.js to resolve the ProductSelectEvent promise
          with the freshly-selected variant. Re-rendered inside the 'product-form' partial
          on every variant change so the next read returns the new variant's data.
          standard_event_data encodes the less-than character as <, so a literal
          closing-script in product metafields cannot terminate this tag early. {%- endcomment -%}
        <script type="application/json" data-product-view-payload>{{ product | standard_event_data: 'view' }}</script>
        {%- assign product_form_error_id = 'product-form-error-' | append: product.id -%}
        {% form 'product', product %}
          {% if product.variants.size > 1 %}
            <s-variant-picker class="block space-y-4" data-updated-message="{{ 'accessibility.variant_updated' | t }}" data-error-message="{{ 'accessibility.update_error' | t | escape }}" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-product-handle="{{ product.handle }}">
              {%- for option in product.options_with_values -%}
                {%- block 'variant-picker', product: product, option: option, show_selected_value: true -%}{%- endblock -%}
              {%- endfor -%}
              {%- comment -%} Variant refresh feedback stays separate from the add-to-cart error owned by s-product-form. {%- endcomment -%}
              <p data-variant-picker-error hidden class="text-sm text-sale">{{ 'accessibility.update_error' | t }}</p>
            </s-variant-picker>
          {% endif %}
          {%- comment -%} The sole submitted variant ID stays in the partial across selector styles and single-variant products; s-variant-picker updates it on change. {%- endcomment -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          <div class="flex items-center gap-4 mb-10">
            <div class="shrink-0">
              <label for="product-quantity" class="text-sm font-medium text-on-surface mb-2 block">{{ 'product.quantity' | t }}</label>
              {%- liquid
                assign qty_min = current_variant.quantity_rule.min | default: 1
                assign qty_max = current_variant.quantity_rule.max
                assign qty_step = current_variant.quantity_rule.increment | default: 1
              -%}
              {% block 'quantity-selector', id: 'product-quantity', name: 'quantity', value: qty_min, min: qty_min, max: qty_max, step: qty_step %}{% endblock %}
            </div>
          </div>

          {%- if product.metafields.ponyo.availability_status.value == 'Coming Soon' -%}
            {% block 'button', type: 'button', inert: true, variant: 'button-primary', class: 'h-11 px-3 text-sm rounded-button w-full', disabled: true %}{{- 'marketplace.coming_soon_button' | t -}}{% endblock %}
          {%- elsif current_variant.available -%}
            {%- capture add_button_attrs -%}aria-describedby="{{ product_form_error_id }}"{%- endcapture -%}
            {% block 'button', type: 'submit', name: 'add', variant: 'button-primary', class: 'h-12 px-3 font-heading text-[15px] font-extrabold rounded-button w-full', attributes: add_button_attrs %}{{- 'product.add_to_cart' | t -}}{% endblock %}
          {%- else -%}
            {%- comment -%}
              type="button" prevents keyboard form submission when sold out; aria-disabled is set by the block.
              That leaves no signal the button block can read, so inert states the placeholder has no destination.
            {%- endcomment -%}
            {% block 'button', type: 'button', inert: true, variant: 'button-primary', class: 'h-11 px-3 text-sm rounded-button w-full', disabled: true %}{{- 'product.sold_out' | t -}}{% endblock %}
          {%- endif -%}

          <p id="{{ product_form_error_id }}" data-add-to-cart-error role="alert" hidden class="mt-3 text-sm text-sale"></p>

          {%- unless product.metafields.ponyo.availability_status.value == 'Coming Soon' -%}
          <div class="mt-3 [--shopify-accelerated-checkout-button-block-size:var(--spacing-touch-target)] [--shopify-accelerated-checkout-button-border-radius:var(--radius-button)] [--shopify-accelerated-checkout-button-box-shadow:none] [--shopify-accelerated-checkout-skeleton-background-color:var(--color-surface-secondary)]">
            {{ form | payment_button }}
          </div>
          {%- endunless -%}
        {% endform %}

        {% endpartial %}
      </s-product-form>

      {%- comment -%} Waitlist and availability alerts. Each signup is saved as a customer tagged with the product handle and SKU, so demand per product can be counted with customer segments. {%- endcomment -%}
      {%- liquid
        assign wl_status = product.metafields.ponyo.availability_status.value
        assign wl_show = false
        assign wl_mode = 'waitlist'
        if shop.products_count > 0
          if wl_status == 'Coming Soon' or current_variant.available == false
            assign wl_show = true
          elsif wl_status == 'Limited'
            assign wl_show = true
            assign wl_mode = 'alert'
          endif
        endif
      -%}
      {%- if wl_show -%}
        <div class="rounded-[22px] border border-[#efe1d8] bg-[#fffaf5] px-5 py-4">
          {%- if wl_mode == 'alert' -%}
            <h3 class="font-heading text-base font-bold text-[#4a3530]">{{ 'marketplace.alert_title' | t }}</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-on-surface-secondary">{{ 'marketplace.alert_body' | t }}</p>
          {%- else -%}
            <h3 class="font-heading text-base font-bold text-[#4a3530]">{{ 'marketplace.waitlist_title' | t }}</h3>
            <p class="mt-1 text-[13px] leading-relaxed text-on-surface-secondary">{{ 'marketplace.waitlist_body' | t }}</p>
          {%- endif -%}
          {%- assign waitlist_form_id = 'waitlist-' | append: product.id -%}
          {% form 'customer', id: waitlist_form_id, class: 'mt-3' %}
            {%- if form.posted_successfully? -%}
              <p class="rounded-lg bg-sage px-3 py-2 text-[13px] font-semibold text-[#2f4a32]" role="status">{{ 'marketplace.waitlist_success' | t }}</p>
            {%- else -%}
              {%- liquid
                assign wl_tags = 'waitlist,waitlist-' | append: product.handle
                if wl_mode == 'alert'
                  assign wl_tags = 'stock-alert,stock-alert-' | append: product.handle
                endif
                if current_variant.sku != blank
                  assign wl_tags = wl_tags | append: ',sku-' | append: current_variant.sku
                endif
              -%}
              <input type="hidden" name="contact[tags]" value="{{ wl_tags | escape }}">
              <input type="hidden" name="contact[accepts_marketing]" value="true">
              {%- if form.errors -%}
                <p class="mb-2 text-[13px] text-sale" role="alert">{{ form.errors | default_errors }}</p>
              {%- endif -%}
              <div class="flex gap-2">
                <label for="{{ waitlist_form_id }}-email" class="sr-only">{{ 'marketplace.waitlist_email' | t }}</label>
                <input id="{{ waitlist_form_id }}-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'marketplace.waitlist_email' | t | escape }}" class="h-11 min-w-0 flex-1 rounded-full border border-[#e9d3c8] bg-white px-4 text-sm text-[#4a3530] focus-visible:outline-2 focus-visible:outline-accent">
                {% block 'button', type: 'submit', variant: 'button-primary', class: 'h-11 shrink-0 rounded-full px-5 font-heading text-sm font-bold' %}{{ 'marketplace.waitlist_submit' | t }}{% endblock %}
              </div>
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} Left, under the photo on desktop: plush details, price history and description. On mobile this follows the buy box. {%- endcomment -%}
    <div class="flex flex-col gap-6 md:col-start-1 md:row-start-2">
      {%- comment -%} Plush details from product metafields (sample values while the catalog is empty). {%- endcomment -%}
      {%- liquid
        assign mf = product.metafields.ponyo
        assign has_specs = false
        if mf.size_tier != blank or mf.dimensions != blank or mf.materials != blank or mf.ships_from != blank or mf.safety != blank or mf.condition != blank or mf.rarity != blank
          assign has_specs = true
        endif
      -%}
      {%- if shop.products_count == 0 or has_specs -%}
        <div class="rounded-[22px] bg-white px-5 py-4 shadow-[0_6px_0_#efdcd2,0_12px_26px_rgba(110,74,62,.06)]">
          {% block 'text', tag: 'h3', variant: 'sm', class: 'mb-1 font-heading font-bold text-[#4a3530]' %}{{ 'marketplace.spec_title' | t }}{% endblock %}
          <dl class="divide-y divide-border text-sm">
          {%- if shop.products_count == 0 -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_size' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">Domina XL</dd></div>
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_dimensions' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">100 cm tall</dd></div>
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_materials' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">Soft minky fabric, polyester filling</dd></div>
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_ships_from' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">Seoul, South Korea</dd></div>
          {%- else -%}
            {%- if mf.size_tier != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_size' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.size_tier.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.dimensions != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_dimensions' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.dimensions.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.materials != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_materials' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.materials.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.condition != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_condition' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.condition.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.rarity != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_rarity' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.rarity.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.ships_from != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_ships_from' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.ships_from.value | escape }}</dd></div>{%- endif -%}
            {%- if mf.safety != blank -%}
          <div class="flex justify-between gap-4 py-2.5"><dt class="text-on-surface-secondary">{{ 'marketplace.spec_safety' | t }}</dt><dd class="text-end font-semibold text-[#4a3530]">{{ mf.safety.value | escape }}</dd></div>{%- endif -%}
          {%- endif -%}
          </dl>
        </div>
      {%- endif -%}

      {%- comment -%} Price history from the ponyo.price_history JSON metafield: [{"date":"2026-11-01","price":18800}], price in whole yen. {%- endcomment -%}
      {%- assign price_history = product.metafields.ponyo.price_history.value -%}
      {%- if price_history != blank and price_history.size > 0 -%}
        {%- assign lowest_price = price_history | map: 'price' | sort | first -%}
        <div class="rounded-[22px] bg-white px-5 py-4 shadow-[0_6px_0_#efdcd2,0_12px_26px_rgba(110,74,62,.06)]">
          <h3 class="mb-1 font-heading text-sm font-bold text-[#4a3530]">{{ 'marketplace.price_history_title' | t }}</h3>
          <p class="mb-2 text-[13px] text-on-surface-secondary">{{ 'marketplace.price_history_lowest' | t }}: <span class="font-bold text-[#4a3530]">{{ lowest_price | times: 100 | money_without_trailing_zeros }}</span></p>
          <table class="w-full text-sm">
            <thead class="sr-only"><tr><th scope="col">{{ 'marketplace.price_history_date' | t }}</th><th scope="col">{{ 'marketplace.price_history_price' | t }}</th></tr></thead>
            <tbody class="divide-y divide-border">
              {%- for entry in price_history reversed -%}
                <tr><td class="py-2 text-on-surface-secondary">{{ entry.date | date: '%Y-%m-%d' }}</td><td class="py-2 text-end font-semibold text-[#4a3530]">{{ entry.price | times: 100 | money_without_trailing_zeros }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}

      {%- comment -%} Product Description {%- endcomment -%}
      {%- comment -%} Unconditional sr-only h2 ensures heading hierarchy is valid even when no description exists, preserving the semantic outline across all product pages {%- endcomment -%}
      <h2 class="sr-only">{{ 'product.details' | t }}</h2>

      {%- if shop.products_count == 0 -%}
        <div class="border-t border-border pt-4">
          <h3 class="text-sm font-bold mb-3 font-heading text-[#4a3530]">{{ 'product.description' | t }}</h3>
          {% block 'text', variant: 'sm', class: 'leading-relaxed text-on-surface-secondary' %}A floppy-eared friend in soft cream, made oversized. At 100 cm, Haneul Bunny XL brings comfort, character, and a little wonder into any room.{% endblock %}
        </div>
      {%- endif -%}
      {% if product.description != blank %}
        <div class="rounded-[20px] bg-white p-4 shadow-[0_4px_0_#efe4dc] md:p-5">
          {%- assign description_label = 'product.description' | t -%}
          <h3 class="mb-2 font-heading text-sm font-bold text-[#4a3530]">{{ description_label | escape }}</h3>
          {%- comment -%} The schema-backed setting keeps the product description connected as rich text instead of flattening its internal treatments through the text block. {%- endcomment -%}
          {% block 'richtext', text: product.description, class: 'text-[14px] leading-relaxed text-[#5b463f]' %}{% endblock %}
        </div>
      {% endif %}
    </div>
  </div>
  </s-view-event>
{% endblock %}

{%- comment -%} Materials, care, and shipping details as native disclosure tabs. {%- endcomment -%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: '' %}
  <div class="mb-12 divide-y divide-border rounded-[22px] bg-white shadow-[0_6px_0_#efdcd2]">
    <details class="group px-5 md:px-6" open>
      <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-heading font-extrabold text-[#4a3530] [&::-webkit-details-marker]:hidden">
        {{ 'home.pages.tab_care' | t }}
        <span class="size-4 transition-transform group-open:rotate-180" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
      </summary>
      {% block 'text', variant: 'sm', class: 'pb-5 leading-relaxed whitespace-pre-line text-on-surface-secondary' %}{%- if product.metafields.ponyo.care_guide != blank -%}{{ product.metafields.ponyo.care_guide.value | escape }}{%- else -%}{{ 'marketplace.tab_care_fallback' | t }}{%- endif -%}{% endblock %}
    </details>
    <details class="group px-5 md:px-6">
      <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-heading font-extrabold text-[#4a3530] [&::-webkit-details-marker]:hidden">
        {{ 'marketplace.tab_how' | t }}
        <span class="size-4 transition-transform group-open:rotate-180" aria-hidden="true">{{- 'icon-chevron-down.svg' | inline_asset_content -}}</span>
      </summary>
      {% block 'text', variant: 'sm', class: 'pb-5 leading-relaxed text-on-surface-secondary' %}{{ 'marketplace.tab_how_body' | t }}{% endblock %}
    </details>
  </div>
{% endblock %}

{%- comment -%} You May Also Like: plush from this product's own collection first, swipeable. {%- endcomment -%}
{%- liquid
  assign related_source = collections.all
  for pc in product.collections
    if pc.handle != 'frontpage' and pc.handle != 'new-arrivals' and pc.products_count > 1
      assign related_source = pc
      break
    endif
  endfor
-%}
{% block 'container', class: 'w-full max-w-page mx-auto px-margin', padding: 'py-8', attributes: 'aria-labelledby="also-like-title"' %}
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    {% block 'heading', tag: 'h2', variant: 'sm', class: 'font-extrabold tracking-tight text-[#4a3530] text-[26px]! md:text-[32px]!', attributes: 'id="also-like-title"' %}{{ 'product.also_like' | t }}{% endblock %}
    <a href="{{ related_source.url }}" class="rounded-full border-2 border-[#e9d3c8] bg-white px-4 py-2 font-heading text-[13.5px] font-bold text-[#4a3530] no-underline hover:bg-[#f3ece7]">{{ 'home.v2.see_all' | t }} →</a>
  </div>
  <ul role="list" class="-mx-1 flex snap-x gap-3 overflow-x-auto px-1 pb-3 [scrollbar-width:none] md:gap-5 [&::-webkit-scrollbar]:hidden">
    {%- assign also_count = 0 -%}
    {%- for other in related_source.products limit: 10 -%}
      {%- if other.id == product.id or also_count >= 8 -%}{%- continue -%}{%- endif -%}
      {%- assign also_count = also_count | plus: 1 -%}
      <li class="w-[46%] shrink-0 snap-start sm:w-[31%] lg:w-[23%]">{% render 'ponyo-product-card', product: other, sizes: '(min-width: 1024px) 300px, 46vw' %}</li>
    {%- endfor -%}
  </ul>
{% endblock %}

<span hidden data-recently-viewed-record="{{ product.handle | escape }}"></span>
{% render 'recently-viewed', exclude: product.handle %}
{% render 'explore-strip' %}

{%- comment -%} Mobile buy bar: on product pages it takes the place of the bottom tab bar and stays visible, so Add to cart is always one tap away. {%- endcomment -%}
<div class="fixed inset-x-0 bottom-0 z-40 border-t border-[#ecdcd0] bg-white/95 px-3 pt-2 pb-[max(.5rem,env(safe-area-inset-bottom))] shadow-[0_-4px_18px_rgba(46,33,29,.08)] backdrop-blur md:hidden" data-buy-bar>
  <div class="flex items-center gap-2">
    <a href="{{ routes.root_url }}" class="flex w-12 shrink-0 flex-col items-center gap-0.5 text-[10px] font-medium tracking-wide text-[#7a655d] no-underline">
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5.5 9v11h13V9"/><path d="M10 20v-5.5h4V20"/></svg>
      {{ 'tabbar.home' | t }}
    </a>
    {% render 'wishlist-button', product: product, class: 'size-11 shrink-0 shadow-none! border border-[#ecdcd0]' %}
    <button type="button" class="flex h-12 flex-1 items-center justify-center gap-2 rounded-full bg-[#4a3530] px-5 font-heading text-[15px] font-bold text-white disabled:opacity-60" data-buy-bar-button{% unless product.available %} disabled{% endunless %}>
      {%- if product.available -%}
        <span>{{ 'product.add_to_cart' | t }}</span>
        <span class="opacity-60" aria-hidden="true">·</span>
        <span>{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
      {%- else -%}
        {{ 'mp.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</div>
<script>
  (() => {
    const bar = document.querySelector('[data-buy-bar]');
    if (!bar) return;
    bar.querySelector('[data-buy-bar-button]').addEventListener('click', () => {
      const add = document.querySelector('[data-product-form] button[name="add"]');
      if (add && !add.disabled) { add.click(); return; }
      (document.querySelector('[data-product-form]') || document.body).scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  })();
</script>

  <script type="module" src="{{ 's-variant-picker.js' | asset_url }}"></script>
  <script type="module" src="{{ 's-product-form.js' | asset_url }}"></script>
